## thoxash — Thoxa shell (extras dogfood).
##
## v4 (session plan PR0): type Shell(status) + methods.
##     Builtins: echo, pwd, cd, help, status, exit/quit.
##     Externals: PATH + thoxa_spawn_wait; status from wait.
##     Quotes: "…" '…' \ (v3). No pipes / host REPL yet.
##
## Run:  cargo make shell
## Plan: docs/specs/2026-07-24-thoxa-session-repl.md

import { Has, Not, May } from "std/fallible"
import logging, { info } from "std/logging"

extern fn sysRead(fd!: Int32, buf!: Bytes, count!: UInt64) -> Int64 from "c" "read"
extern fn sysWrite(fd!: Int32, buf!: Bytes, count!: UInt64) -> Int64 from "c" "write"
extern fn sysGetcwd(buf!: Bytes, size!: UInt64) -> String from "c" "getcwd"
extern fn sysChdir(path!: String) -> Int32 from "c" "chdir"
extern fn sysGetenv(name!: String) -> String from "c" "getenv"
extern fn sysStrerror(errnum!: Int32) -> String from "c" "strerror"
extern fn sysErrno() -> Int32 from "c" "thoxa_errno"
extern fn sysIsatty(fd!: Int32) -> Int32 from "c" "isatty"
extern fn sysAccess(path!: String, mode!: Int32) -> Int32 from "c" "access"
## RT helper: Array is not FFI-marshalable yet — argv is NUL-separated Bytes.
extern fn sysSpawnWait(path!: String, argv!: Bytes, argvLen!: Int64) -> Int64 from "c" "thoxa_spawn_wait"

let cwdBufSize = 4096
## access(2) X_OK — executable by this user
let accessXOk = 1
## ASCII for the word splitter
let chSpace = 32
let chTab = 9
let chDQuote = 34
let chSQuote = 39
let chBSlash = 92
## splitWords quote state: 0 normal, 1 inside ", 2 inside '
let qsNormal = 0
let qsDouble = 1
let qsSingle = 2

## ---------------------------------------------------------------------------
## Session value (plan PR0). Methods return a new Shell with updated status.
## ---------------------------------------------------------------------------

type Shell(status: Int64) {
    ## Print args joined by spaces (no args → blank line). Always status 0.
    export fn echo(args!: Array<String>) -> Shell {
        info(joinSpace(args))
        Shell(status: 0)
    }

    ## Print cwd. Fail → message + status 1.
    export fn pwd() -> Shell {
        let buf = Bytes(cwdBufSize)
        let path = sysGetcwd(buf, cwdBufSize)
        if path == "" {
            info("pwd: {sysStrerror(sysErrno())}")
            Shell(status: 1)
        } else {
            info(path)
            Shell(status: 0)
        }
    }

    ## Change directory. No arg → $HOME. Fail → status 1.
    export fn cd(args!: Array<String>) -> Shell {
        if args.count > 1 {
            info("cd: too many arguments")
            Shell(status: 1)
        } else {
            mut path = ""
            mut bad = false
            if args.count == 0 {
                path = sysGetenv("HOME")
                if path == "" {
                    info("cd: HOME not set")
                    bad = true
                }
            } else {
                path = args[0]
            }
            if bad {
                Shell(status: 1)
            } else {
                let rc = sysChdir(path)
                if rc != 0 {
                    info("cd: {path}: {sysStrerror(sysErrno())}")
                    Shell(status: 1)
                } else {
                    Shell(status: 0)
                }
            }
        }
    }

    ## Run argv[0] via PATH (or path with /). Updates status from wait.
    ## not found → 127; fork/exec infrastructure fail → 1; else child status.
    export fn run(argv!: Array<String>) -> Shell {
        if argv.count == 0 {
            Shell(status: 0)
        } else {
            let cmd = argv[0]
            match resolveCommand(cmd) {
                Not {
                    info("thoxash: {cmd}: command not found")
                    Shell(status: 127)
                }
                Has(path) {
                    let blob = encodeArgv(argv)
                    let st = sysSpawnWait(path, blob, blob.count)
                    if st < 0 {
                        info("thoxash: {cmd}: {sysStrerror(sysErrno())}")
                        Shell(status: 1)
                    } else {
                        Shell(status: st)
                    }
                }
            }
        }
    }

    ## Print last status without changing it (smoke / inspection).
    export fn showStatus() -> Shell {
        info("{status}")
        Shell(status)
    }

    export fn help() -> Shell {
        info("thoxash 4 — Shell(status). Builtins: echo, pwd, cd, help, status, exit, quit. Quotes + PATH.")
        Shell(status: 0)
    }
}

## Word-split outcome: ok=false → unclosed quote (items empty).
type Words(ok: Bool, items: Array<String>)

## Set by evalLine on exit/quit (constructor params cannot hold nested User yet,
## so we cannot return (Shell, done) as one value — module mut is fine for dogfood).
mut sessionDone = false

## Write to stdout via write(2) so the prompt appears before blocking on read
## (stdio `print` is line-buffered and may not flush without a newline).
fn writeOut(s!: String) {
    let b = Bytes.fromString(s)
    sysWrite(1, b, b.count)
}

fn writePrompt() {
    writeOut("$ ")
}

## One line from stdin, byte-at-a-time so pipes and ttys both split on `\n`
## (a bulk `read` on a pipe can return multiple lines in one shot).
## - `Not`  → EOF (or read error) with no pending bytes
## - `Has("")` → blank line
## CR before LF is dropped.
fn readLine() -> May<String> {
    mut acc = Buffer()
    mut gotAny = false
    mut done = false
    mut sawEof = false
    while done == false {
        let chunk = Bytes(1)
        let n = sysRead(0, chunk, 1)
        if n <= 0 {
            sawEof = true
            done = true
        } else {
            gotAny = true
            let b = chunk.get(0)
            if b == 10 {
                done = true
            } else {
                if b == 13 {
                    ## skip CR
                } else {
                    acc.append(b)
                }
            }
        }
    }
    if sawEof {
        if gotAny {
            Has(acc.freeze().toString())
        } else {
            Not()
        }
    } else {
        Has(acc.freeze().toString())
    }
}

## Split `line` on each byte equal to `sep` (e.g. space or ':').
fn splitOn(line!: String, sep!: Int64) -> Array<String> {
    let b = Bytes.fromString(line)
    mut parts: Array<String> = []
    mut acc = Buffer()
    mut inPart = false
    for i in 0..b.count {
        let c = b.get(i)
        if c == sep {
            if inPart {
                parts.append(acc.freeze().toString())
                acc = Buffer()
                inPart = false
            } else {
                ## consecutive seps / leading sep → empty component (PATH semantics)
                parts.append("")
            }
        } else {
            acc.append(c)
            inPart = true
        }
    }
    if inPart {
        parts.append(acc.freeze().toString())
    } else {
        if b.count > 0 {
            ## trailing sep → empty final component
            if b.get(b.count - 1) == sep {
                parts.append("")
            }
        }
    }
    parts
}

## Quote-aware word split (shell-ish subset). See README / session plan.
fn splitWords(line!: String) -> Words {
    let b = Bytes.fromString(line)
    mut words: Array<String> = []
    mut acc = Buffer()
    mut inWord = false
    mut state = qsNormal
    mut escape = false
    mut i = 0
    while i < b.count {
        let c = b.get(i)
        if escape {
            acc.append(c)
            inWord = true
            escape = false
        } else {
            if state == qsDouble {
                if c == chBSlash {
                    escape = true
                } else {
                    if c == chDQuote {
                        state = qsNormal
                    } else {
                        acc.append(c)
                        inWord = true
                    }
                }
            } else {
                if state == qsSingle {
                    if c == chSQuote {
                        state = qsNormal
                    } else {
                        acc.append(c)
                        inWord = true
                    }
                } else {
                    ## normal (unquoted)
                    if c == chBSlash {
                        escape = true
                        inWord = true
                    } else {
                        if c == chDQuote {
                            state = qsDouble
                            inWord = true
                        } else {
                            if c == chSQuote {
                                state = qsSingle
                                inWord = true
                            } else {
                                if c == chSpace {
                                    if inWord {
                                        words.append(acc.freeze().toString())
                                        acc = Buffer()
                                        inWord = false
                                    }
                                } else {
                                    if c == chTab {
                                        if inWord {
                                            words.append(acc.freeze().toString())
                                            acc = Buffer()
                                            inWord = false
                                        }
                                    } else {
                                        acc.append(c)
                                        inWord = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    if escape {
        ## trailing backslash → keep a literal `\`
        acc.append(chBSlash)
        inWord = true
    }
    if state != qsNormal {
        info("thoxash: unclosed quote")
        mut empty: Array<String> = []
        Words(ok: false, items: empty)
    } else {
        if inWord {
            words.append(acc.freeze().toString())
        }
        Words(ok: true, items: words)
    }
}

## Drop the first word (command); remaining args for builtins / argv tail.
fn tailArgs(words!: Array<String>) -> Array<String> {
    mut out: Array<String> = []
    mut i = 0
    for w in words {
        if i > 0 {
            out.append(w)
        }
        i = i + 1
    }
    out
}

fn joinSpace(parts!: Array<String>) -> String {
    mut out = ""
    mut i = 0
    for p in parts {
        if i == 0 {
            out = p
        } else {
            out = "{out} {p}"
        }
        i = i + 1
    }
    out
}

fn containsSlash(s!: String) -> Bool {
    match Bytes.fromString(s).find(Bytes.fromString("/")) {
        Has(_) { true }
        Not { false }
    }
}

fn isExecutable(path!: String) -> Bool {
    sysAccess(path, accessXOk) == 0
}

## Resolve `cmd` to an absolute/relative path for execv.
## - contains `/` → use as-is if executable
## - else search PATH (empty component = current directory)
fn resolveCommand(cmd!: String) -> May<String> {
    if containsSlash(cmd) {
        if isExecutable(cmd) {
            Has(cmd)
        } else {
            Not()
        }
    } else {
        let pathEnv = sysGetenv("PATH")
        mut found = ""
        mut ok = false
        if pathEnv == "" {
            ## empty PATH: only cwd
            if isExecutable(cmd) {
                found = cmd
                ok = true
            }
        } else {
            let dirs = splitOn(pathEnv, 58)
            for dir in dirs {
                mut candidate = ""
                if dir == "" {
                    candidate = cmd
                } else {
                    candidate = "{dir}/{cmd}"
                }
                if ok == false {
                    if isExecutable(candidate) {
                        found = candidate
                        ok = true
                    }
                }
            }
        }
        if ok {
            Has(found)
        } else {
            Not()
        }
    }
}

## Encode argv as consecutive NUL-terminated strings for thoxa_spawn_wait.
fn encodeArgv(words!: Array<String>) -> Bytes {
    mut buf = Buffer()
    for w in words {
        buf.appendBytes(Bytes.fromString(w))
        buf.append(0)
    }
    buf.freeze()
}

## Run one line against the session Shell. Returns the updated Shell.
## Sets sessionDone on exit/quit.
fn evalLine(shell!: Shell, line!: String) -> Shell {
    let parsed = splitWords(line)
    if parsed.ok == false {
        ## unclosed quote
        Shell(status: 2)
    } else {
        let words = parsed.items
        if words.count == 0 {
            ## blank line: keep status
            shell
        } else {
            let cmd = words[0]
            let args = tailArgs(words)
            match cmd {
                "exit" {
                    sessionDone = true
                    shell
                }
                "quit" {
                    sessionDone = true
                    shell
                }
                "help" {
                    shell.help()
                }
                "echo" {
                    shell.echo(args)
                }
                "pwd" {
                    shell.pwd()
                }
                "cd" {
                    shell.cd(args)
                }
                "status" {
                    shell.showStatus()
                }
                else {
                    shell.run(words)
                }
            }
        }
    }
}

fn main() -> Int64 {
    ## Plain lines on stdout: the shell's own output, not log records.
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    info("thoxash 4 — type help, or exit / Ctrl-D to quit")
    ## Prompts only on a TTY. Pipes/scripts get command output alone (no `$ `
    ## gluing when silent builtins like `cd` print nothing — a TTY echoes the
    ## user's Enter after the prompt; a pipe does not).
    let interactive = sysIsatty(0) != 0
    mut shell = Shell(status: 0)
    sessionDone = false
    mut running = true
    while running {
        if interactive {
            writePrompt()
        }
        match readLine() {
            Not {
                ## EOF: put the next shell's prompt on a fresh line when interactive
                if interactive {
                    info("")
                }
                running = false
            }
            Has(line) {
                shell = evalLine(shell, line)
                if sessionDone {
                    running = false
                }
            }
        }
    }
    ## Process exit code = final session status (session plan D94′/script path).
    shell.status
}
