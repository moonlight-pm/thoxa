## std/core — the built-in traits (D228).
##
## Every program has this module, imported or not, and its traits and types
## are visible by name everywhere. A type conforms to a trait only by saying
## so: `conform Point to Equatable, Hashable`. A conformance that leaves out
## `equals` or `compare` gets the compiler's, field by field; every field must
## conform too.

import { Has, Not, May } from "std/fallible"

## A value that owns something outside the program (a file descriptor, a
## socket, a database handle). Its values are one shared box: copies share it,
## `drop` runs when the last copy goes, and only the module that defines the
## type can call its constructor (D155, D168).
export trait Resource {
    fn drop()
}

## A type a tag literal builds: `<Card title="Hi">…</Card>` is
## `Card(title: "Hi").view(children: […])`.
export trait Component {
    fn view(children: Array<Node>) -> Node
}

## `==` and `!=`. Without its own `equals`, a product compares field by field
## and a union by member, then payload.
export trait Equatable {
    fn equals(other!: Self) -> Bool
}

## A Map key: hashes by value. Without its own `hash`, a product hashes field
## by field and a union by member, then payload. A type with its own `equals`
## writes its own `hash` too, so equal values hash alike.
export trait Hashable: Equatable {
    fn hash(mut hasher!: Hasher)
}

## What `hash` feeds: each part of a value, in order. Its arithmetic wraps,
## and its shifts fill with zeros.
export type Hasher(state: UInt64 = 0) {
    export fn mix(value!: Int64) {
        let bits = UInt64(truncating: value)
        state = state ^ (bits + 11400714819323198485 + (state << 6) + (state >> 2))
    }
}

## `<`, `<=`, `>`, `>=`. Without its own `compare`, a product orders field by
## field in declaration order, and a union by member in declaration order,
## then payload.
export trait Ordered: Equatable {
    fn compare(other!: Self) -> Order
}

## How two values order.
export type Order = "less" | "equal" | "greater"

## Values one at a time: `next()` gives each, then `Not`. `for item in
## cursor` reads a copy of it, so `cursor` itself does not move.
export trait Iterator {
    type Item
    fn next() -> May<Item>
}

## A value `for item in value` reads: `iterate()` makes an iterator that
## starts at its beginning. Its `Item` is its cursor's.
export trait Sequence {
    type Cursor: Iterator
    type Item = Cursor.Item
    fn iterate() -> Cursor
}

## A value's text, which `"{value}"` writes. Without its own `show`, a
## product shows as `Point(x: 1, y: 2)` (a `String` field in quotes) and a
## union as its member.
export trait Show {
    fn show() -> String

    ## Its text inside another value's text: an array's element, a map's key
    ## or value, a field, a union's payload. A `String`'s is `quoted()`, so
    ## `["a", "b"]` shows two strings; every other type's is its `show()`
    ## (D245).
    fn showNested() -> String {
        show()
    }
}

conform Order to Equatable, Hashable, Ordered

conform Int64 to Equatable, Hashable, Ordered
conform Int32 to Equatable, Hashable, Ordered
conform UInt64 to Equatable, Hashable, Ordered
conform UInt32 to Equatable, Hashable, Ordered
conform Byte to Equatable, Hashable, Ordered
conform Bool to Equatable, Hashable, Ordered
conform String to Equatable, Hashable, Ordered
conform Bytes to Equatable, Hashable
conform Void to Equatable, Hashable

## IEEE `==` (a NaN equals nothing); `compare` puts every NaN last, after the
## infinities, and -0 equal to 0.
conform Float64 to Equatable, Hashable, Ordered

conform Int64 to Show
conform Int32 to Show
conform UInt64 to Show
conform UInt32 to Show
conform Byte to Show
conform Float64 to Show
conform Bool to Show
conform String to Show {
    fn showNested() -> String {
        self.quoted()
    }
}
conform Order to Show
conform Array<T: Show> to Show

conform Array<T: Equatable> to Equatable
conform Array<T: Hashable> to Hashable
conform Map<K: Hashable, V: Equatable> to Equatable

## An array is a `Sequence`, so generic code over sequences takes one. `for`
## reads an array directly; `iterate()` gives its elements in order.
conform Array<T> to Sequence {
    type Cursor = ArrayCursor<T>

    fn iterate() -> ArrayCursor<T> {
        ArrayCursor(items: self, index: 0)
    }
}

## An array's elements in order, one at a time.
export type ArrayCursor<T>(items: Array<T>, index: Int64)

conform ArrayCursor<T> to Iterator {
    type Item = T

    fn next() -> May<T> {
        if index >= items.count {
            return Not()
        }
        index = index + 1
        Has(items[index - 1])
    }
}

## A map is a `Sequence` of its entries, in insertion order (D236), so
## generic code over sequences takes one. `for key, value in table` reads a
## map directly; `for entry in table` and `iterate()` give `Entry` values.
conform Map<K, V> to Sequence {
    type Cursor = MapCursor<K, V>

    fn iterate() -> MapCursor<K, V> {
        MapCursor(entries: self, keys: self.keys(), index: 0)
    }
}

## `{"a": 1}`: each key and its value in insertion order, nested, so a
## `String` is in quotes (D245).
conform Map<K: Show, V: Show> to Show {
    fn show() -> String {
        mut parts: Array<String> = []
        for key, value in self {
            parts.append("{key.showNested()}: {value.showNested()}")
        }
        "\u{7B}{parts.join(", ")}\u{7D}"
    }
}

## One key of a map and its value.
export type Entry<K, V>(key: K, value: V)

conform Entry<K: Equatable, V: Equatable> to Equatable
conform Entry<K: Show, V: Show> to Show

## A map's entries in insertion order, one at a time: the keys as they were
## when it started, each with its value.
export type MapCursor<K, V>(entries: Map<K, V>, keys: Array<K>, index: Int64)

conform MapCursor<K, V> to Iterator {
    type Item = Entry<K, V>

    fn next() -> May<Entry<K, V>> {
        while index < keys.count {
            let key = keys[index]
            index = index + 1
            match entries[key] {
                Has(value) => return Has(Entry(key: key, value: value))
                Not => continue
            }
        }
        Not()
    }
}

## A string is a `Sequence` of its Unicode scalars (D236), each a one-scalar
## `String`, so `for scalar in text` reads them in order.
conform String to Sequence {
    type Cursor = StringCursor

    fn iterate() -> StringCursor {
        StringCursor(text: self, offset: 0)
    }
}

## A string's scalars in order, one at a time, by byte offset.
export type StringCursor(text: String, offset: Int64)

conform StringCursor to Iterator {
    type Item = String

    fn next() -> May<String> {
        if offset >= text.byteCount {
            return Not()
        }
        let lead = text.byteAt(offset)
        let length = if lead < 128 { 1 } else if lead < 224 { 2 } else if lead < 240 { 3 } else { 4 }
        offset = offset + length
        Has(text.byteSlice(offset - length, offset))
    }
}

## Element by element, then the shorter first (D236).
conform Array<T: Ordered> to Ordered {
    fn compare(other!: Self) -> Order {
        mut index = 0
        while index < self.count and index < other.count {
            let order = self[index].compare(other[index])
            if order != "equal" {
                return order
            }
            index = index + 1
        }
        self.count.compare(other.count)
    }
}

extend Int64 {
    export fn equals(other!: Int64) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    export fn hash(mut hasher!: Hasher) {
        hasher.mix(self)
    }

    export fn compare(other!: Int64) -> Order {
        if self < other { "less" } else if self > other { "greater" } else { "equal" }
    }
}

extend Int32 {
    export fn equals(other!: Int32) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    export fn hash(mut hasher!: Hasher) {
        hasher.mix(self)
    }

    export fn compare(other!: Int32) -> Order {
        if self < other { "less" } else if self > other { "greater" } else { "equal" }
    }
}

extend UInt64 {
    export fn equals(other!: UInt64) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    export fn hash(mut hasher!: Hasher) {
        hasher.mix(Int64(truncating: self))
    }

    export fn compare(other!: UInt64) -> Order {
        if self < other { "less" } else if self > other { "greater" } else { "equal" }
    }
}

extend UInt32 {
    export fn equals(other!: UInt32) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    export fn hash(mut hasher!: Hasher) {
        hasher.mix(self)
    }

    export fn compare(other!: UInt32) -> Order {
        if self < other { "less" } else if self > other { "greater" } else { "equal" }
    }
}

extend Byte {
    export fn equals(other!: Byte) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    export fn hash(mut hasher!: Hasher) {
        hasher.mix(self)
    }

    export fn compare(other!: Byte) -> Order {
        if self < other { "less" } else if self > other { "greater" } else { "equal" }
    }
}

extend Bool {
    export fn equals(other!: Bool) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    export fn hash(mut hasher!: Hasher) {
        hasher.mix(if self { 1 } else { 0 })
    }

    ## `false` before `true`.
    export fn compare(other!: Bool) -> Order {
        if self == other { "equal" } else if other { "less" } else { "greater" }
    }
}

extend Float64 {
    export fn equals(other!: Float64) -> Bool {
        self == other
    }

    export fn show() -> String {
        "{self}"
    }

    ## As a Map key compares it: every NaN alike, -0 as 0.
    export fn hash(mut hasher!: Hasher) {
        if self != self {
            hasher.mix(9221120237041090560)
        } else if self == 0.0 {
            hasher.mix(0)
        } else {
            hasher.mix(Int64(truncating: self.bits))
        }
    }

    export fn compare(other!: Float64) -> Order {
        if self < other {
            "less"
        } else if self > other {
            "greater"
        } else if self == other {
            "equal"
        } else if self != self {
            if other != other { "equal" } else { "greater" }
        } else {
            "less"
        }
    }
}

extend Bytes {
    ## Its bytes, then its count.
    export fn hash(mut hasher!: Hasher) {
        mut index = 0
        while index < self.count {
            hasher.mix(self.get(index))
            index = index + 1
        }
        hasher.mix(self.count)
    }
}
