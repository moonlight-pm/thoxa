## std/array — Array's methods, written in Thoxa (D228).
##
## Every program has this module, imported or not: its generic `extend`
## blocks add methods to every `Array<T>` whose `T` meets their bounds, and a
## method call finds them. The runtime keeps the primitives: `count`,
## `append`, `dropLast`, `insert`, `removeAt`, and `[index]`.

import { Has, Not, May } from "std/fallible"

extend Array<T: Equatable> {
    ## Whether an element is `==` to `item`.
    export fn contains(item!: T) -> Bool {
        for element in self {
            if element == item {
                return true
            }
        }
        false
    }

    ## The position of the first element `==` to `item`.
    export fn indexOf(item!: T) -> May<Int64> {
        mut index = 0
        while index < self.count {
            if self[index] == item {
                return Has(index)
            }
            index = index + 1
        }
        Not()
    }
}

extend Array<T: Hashable> {
    ## Its count, then each element (D228).
    export fn hash(mut hasher!: Hasher) {
        hasher.mix(self.count)
        for element in self {
            element.hash(mut hasher)
        }
    }
}

extend Array<T: Show> {
    ## `[1, 2]`: each element's nested text, so a `String` is in quotes
    ## (`["a", "b"]`).
    export fn show() -> String {
        mut parts: Array<String> = []
        for element in self {
            parts.append(element.showNested())
        }
        "[{parts.join(", ")}]"
    }
}

extend Array<T: Sequence> {
    ## Each element's items, in order: `[[1, 2], [3]]` is `[1, 2, 3]` (D237).
    export fn flattened() -> Array<T.Item> {
        mut out: Array<T.Item> = []
        for inner in self {
            for item in inner {
                out.append(item)
            }
        }
        out
    }
}

extend Array<T: Ordered> {
    ## The elements in ascending order; equal ones keep their order.
    export fn sorted() -> Array<T> {
        mut out: Array<T> = []
        for element in self {
            mut at = out.count
            while at > 0 and element < out[at - 1] {
                at = at - 1
            }
            out.insert(element, at: at)
        }
        out
    }
}

extend Array<T> {
    ## Each element through `transform`, in order.
    export fn map<U>(transform!: (item: T) -> U) -> Array<U> {
        mut out: Array<U> = []
        for element in self {
            out.append(transform(element))
        }
        out
    }

    ## The elements `keep` says yes to, in order.
    export fn filter(keep!: (item: T) -> Bool) -> Array<T> {
        mut out: Array<T> = []
        for element in self {
            if keep(element) {
                out.append(element)
            }
        }
        out
    }
}
