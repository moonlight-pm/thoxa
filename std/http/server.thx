## std/http/server — HTTP/1.1 host loop (syscalls via std/net).
## Completes Request.body after parseRequest; Request.query comes from std/http.
## Host takes port + handle (D132). Does not import app types.

import net, { Socket } from "std/net"
import http, { Request, Response, Header } from "std/http"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import { info, warn } from "std/logging"
import { toLowerAscii } from "std/str"

let maxBodyBytes = 65536
## A slow or idle client cannot hold a task, and its fd, forever. The first
## request's headers must arrive within `headerTimeoutMs` of accept; a
## kept-alive connection waits up to `idleTimeoutMs` for its next request.
## A body must arrive, and a response be taken, within 30 s.
let headerTimeoutMs = 10000
let idleTimeoutMs = 30000
let bodyTimeoutMs = 30000
let writeTimeoutMs = 30000
## Connections served at once. Past the cap a new connection is closed at
## accept, so the open connections keep their fds.
let maxConnections = 1024
mut activeConnections = 0

export fn bindListen(port!: Int64) -> Trial<Socket, String> {
    let server = net.createSocket()?
    server.reuseAddr()?
    server.bind(port)?
    server.listen(16)?
    Pass(server)
}

fn bodyPrefix(raw!: Bytes) -> Bytes {
    let sep = Bytes.fromString("\r\n\r\n")
    match raw.find(sep) {
        Not => Bytes(0)
        Has(at) {
            raw.slice(at + 4, raw.count)
        }
    }
}

fn readUntil(peer!: Socket, start!: Bytes, need!: Int64, deadline!: Int64) -> Trial<Bytes, String> {
    if need > maxBodyBytes {
        return Fail("request body too large")
    }
    mut acc = start
    loop {
        if acc.count >= need {
            return Pass(acc.slice(0, need))
        }
        let chunk = peer.receive(deadline)
        if chunk.count == 0 {
            return Fail("incomplete request body")
        }
        if acc.count + chunk.count > maxBodyBytes {
            return Fail("request body too large")
        }
        mut buf = Buffer()
        buf.appendBytes(acc)
        buf.appendBytes(chunk)
        acc = buf.freeze()
    }
    Fail("readUntil: internal")
}

## Framing the host does not support, or that two readers could take
## differently (a proxy in front, say): no chunked bodies, one numeric
## Content-Length. Accepting it would let a request hide inside another.
fn framingError(req!: Request) -> May<String> {
    mut lengths = 0
    for header in req.headers {
        let name = toLowerAscii(header.name)
        if name == "transfer-encoding" {
            return Has("Transfer-Encoding is not supported")
        }
        if name == "content-length" {
            lengths = lengths + 1
        }
    }
    if lengths > 1 {
        return Has("more than one Content-Length")
    }
    if lengths == 1 {
        match http.contentLength(req) {
            Not {
                return Has("invalid Content-Length")
            }
            Has(_) { Void }
        }
    }
    Not()
}

## Finish a request entity from the raw header buffer + Content-Length.
## The body must arrive by `deadline` (`net.nowMs()` time; 0 = no deadline).
export fn readBody(peer!: Socket, raw!: Bytes, req!: Request, deadline: Int64 = 0) -> Trial<Bytes, String> {
    match framingError(req) {
        Has(problem) {
            return Fail(problem)
        }
        Not { Void }
    }
    let have = bodyPrefix(raw)
    match http.contentLength(req) {
        Not {
            Pass(have)
        }
        Has(n) {
            if n == 0 {
                Pass(Bytes(0))
            } else {
                if n > maxBodyBytes {
                    Fail("request body too large")
                } else {
                    readUntil(peer, have, n, deadline)
                }
            }
        }
    }
}

fn isQuietClose(req!: Request) -> Bool {
    if req.method == "" {
        req.path == ""
    } else {
        false
    }
}

## Receive + parse + complete body. Empty method/path means the peer closed
## quietly, or sent nothing by `deadline` (0 = no deadline). With a deadline,
## the body gets `bodyTimeoutMs` more.
export fn readRequest(peer!: Socket, deadline: Int64 = 0) -> Trial<Request, String> {
    match peer.receiveRequest(deadline) {
        Fail(e) {
            Fail(e)
        }
        Pass(raw) {
            if raw.count == 0 {
                mut headers: Array<Header> = []
                Pass(Request(
                    method: "",
                    path: "",
                    query: "",
                    version: "",
                    headers: headers,
                    body: Bytes(0),
                    peerFd: peer.fd
                ))
            } else {
                match http.parseRequest(raw) {
                    Fail(msg) {
                        Fail(msg)
                    }
                    Pass(req) {
                        let bodyDeadline = if deadline == 0 {
                            0
                        } else {
                            net.nowMs() + bodyTimeoutMs
                        }
                        match readBody(peer, raw, req, bodyDeadline) {
                            Fail(e) {
                                Fail(e)
                            }
                            Pass(body) {
                                Pass(Request(
                                    method: req.method,
                                    path: req.path,
                                    query: req.query,
                                    version: req.version,
                                    headers: req.headers,
                                    body: body,
                                    peerFd: peer.fd
                                ))
                            }
                        }
                    }
                }
            }
        }
    }
}

## Route clauses match method exactly; GET registrations also answer HEAD.
fn requestForHandle(req!: Request) -> Request {
    let method = if req.method == "HEAD" {
        "GET"
    } else {
        req.method
    }
    Request(
        method: method,
        path: req.path,
        query: req.query,
        version: req.version,
        headers: req.headers,
        body: req.body,
        peerFd: req.peerFd
    )
}

## The peer must take the whole response by `deadline` (0 = no deadline).
export fn writeResponse(
    peer!: Socket,
    method!: String,
    res!: Response,
    keepAlive!: Bool,
    deadline: Int64 = 0
) -> Trial<Void, String> {
    let final = http.finalize(method, res, keepAlive)
    let wireBytes = http.writeResponse(final)
    match peer.sendAll(wireBytes, deadline) {
        Pass(_) {
            Pass(Void)
        }
        Fail(e) {
            Fail(e)
        }
    }
}

fn drainUntilClose(peer!: Socket) {
    loop {
        let chunk = peer.receive()
        if chunk.count == 0 {
            break
        }
    }
}

## SSE prelude. Handler writes events with `sendEvent`, then returns `streamed()`.
export fn beginEventStream(peer!: Socket) -> Trial<Void, String> {
    let prelude = Bytes.fromString(
        "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\n\r\n"
    )
    match peer.sendAll(prelude) {
        Pass(_) => Pass(Void)
        Fail(error) => Fail(error)
    }
}

export fn sendEvent(peer!: Socket, data!: String) -> Trial<Void, String> {
    match peer.sendAll(Bytes.fromString("data: {data}\n\n")) {
        Pass(_) => Pass(Void)
        Fail(error) => Fail(error)
    }
}

fn writeBadRequest(peer!: Socket, msg!: String) -> Trial<Void, String> {
    writeResponse(peer, "GET", http.badRequest(msg), false, net.nowMs() + writeTimeoutMs)
}

## One keep-alive connection: read / handle / write until close. Each
## request has a deadline (see `headerTimeoutMs`); an idle connection that
## reaches it is closed quietly.
export fn serveOne(peer!: Socket, handle!: (req: Request) -> Response) {
    mut budget = headerTimeoutMs
    loop {
        match readRequest(peer, net.nowMs() + budget) {
            Fail(e) {
                warn("recv: {e}")
                match writeBadRequest(peer, e) {
                    Pass(_) { }
                    Fail(se) {
                        warn("send: {se}")
                    }
                }
                break
            }
            Pass(req) {
                if isQuietClose(req) {
                    break
                }
                let keep = http.wantsKeepAlive(req.version, req)
                let res = handle(requestForHandle(req))
                if res.status == 0 {
                    info("{req.method} {req.path} -> streamed")
                    drainUntilClose(peer)
                    break
                }
                info("{req.method} {req.path} -> {res.status} {res.reason}")
                match writeResponse(peer, req.method, res, keep, net.nowMs() + writeTimeoutMs) {
                    Fail(se) {
                        warn("send: {se}")
                        break
                    }
                    Pass(_) {
                        if not keep {
                            break
                        }
                    }
                }
                budget = idleTimeoutMs
            }
        }
    }
    peer.close()
}

## `serveOne`, counted against `maxConnections`.
fn serveCounted(peer!: Socket, handle!: (req: Request) -> Response) {
    serveOne(peer, handle)
    activeConnections = activeConnections - 1
}

## Run the host forever. `handle` is a free fn or bound method (D132).
## `--> serveOne` parks an idle peer in recv without stalling accept.
export fn serve(
    port!: Int64,
    handle!: (req: Request) -> Response
) -> Trial<Void, String> {
    let listener = bindListen(port)?
    info("http://127.0.0.1:{port}/")
    loop {
        match listener.accept() {
            Fail(e) {
                warn("accept: {e}")
            }
            Pass(peer) {
                if activeConnections >= maxConnections {
                    warn("accept: {maxConnections} connections open; closing the new one")
                    peer.close()
                } else {
                    activeConnections = activeConnections + 1
                    --> serveCounted(peer, handle)
                }
            }
        }
    }
}
