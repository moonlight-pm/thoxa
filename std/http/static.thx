## std/http/static — map an HTTP Request onto files under a root directory.
## Directories serve `index.html`; path traversal (`..` / `.` segments) → 404.
## Content-Type from the final file extension. GET and HEAD only.
## Depends on std/io + std/http. Logs unexpected Io / permission issues via std/logging.

import { readFile } from "std/io"
import { Request, Response, ok, okHead, notFound, forbidden, methodNotAllowed } from "std/http"
import { Pass, Fail } from "std/fallible"
import { contains } from "std/str"
import { warn } from "std/logging"

## Split URL path on `/` into non-empty segments.
fn pathSegments(path!: String) -> Array<String> {
    let data = Bytes.fromString(path)
    mut segs: Array<String> = []
    mut start = 0
    mut i = 0
    let n = data.count
    loop {
        if i >= n { break }
        if data.get(i) == 47 {
            if i > start {
                segs.append(data.slice(start, i).toString())
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        segs.append(data.slice(start, n).toString())
    }
    segs
}

## True when any segment is `.` or `..` (path traversal / current-dir noise).
fn hasUnsafeSegment(segs!: Array<String>) -> Bool {
    for s in segs {
        if s == ".." {
            return true
        }
        if s == "." {
            return true
        }
    }
    false
}

fn joinPath(root!: String, segs!: Array<String>) -> String {
    mut path = root
    for s in segs {
        path = "{path}/{s}"
    }
    path
}

## Content-Type from extension (ASCII path via Bytes).
fn contentTypeFor(path!: String) -> String {
    let data = Bytes.fromString(path)
    mut i = data.count - 1
    mut ext = ""
    loop {
        if i < 0 { break }
        let c = data.get(i)
        if c == 47 { break }
        if c == 46 {
            ext = data.slice(i, data.count).toString()
            break
        }
        i = i - 1
    }
    if ext == ".html" {
        return "text/html"
    }
    if ext == ".css" {
        return "text/css"
    }
    if ext == ".js" {
        return "text/javascript"
    }
    if ext == ".txt" {
        return "text/plain"
    }
    if ext == ".jpg" {
        return "image/jpeg"
    }
    if ext == ".jpeg" {
        return "image/jpeg"
    }
    if ext == ".png" {
        return "image/png"
    }
    if ext == ".gif" {
        return "image/gif"
    }
    if ext == ".svg" {
        return "image/svg+xml"
    }
    if ext == ".webp" {
        return "image/webp"
    }
    if ext == ".ico" {
        return "image/x-icon"
    }
    if ext == ".woff" {
        return "font/woff"
    }
    if ext == ".woff2" {
        return "font/woff2"
    }
    "application/octet-stream"
}

## Missing path / directory (expected on index fallback and 404).
fn isMissingish(err!: String) -> Bool {
    if contains(err, "No such file") {
        true
    } else {
        contains(err, "Is a directory")
    }
}

fn isForbiddenish(err!: String) -> Bool {
    contains(err, "Permission denied")
}

## Turn a successful file body into GET or HEAD Response.
fn fileResponse(body!: Bytes, path!: String, headOnly: Bool) -> Response {
    let ct = contentTypeFor(path)
    if headOnly {
        okHead(body.count, ct)
    } else {
        ok(body, ct)
    }
}

## Map a terminal Io Fail (after index fallback) to a client Response.
fn failResponse(path!: String, err!: String) -> Response {
    if isForbiddenish(err) {
        warn("forbid {path}: {err}")
        forbidden()
    } else {
        if isMissingish(err) {
            notFound()
        } else {
            warn("read {path}: {err}")
            notFound()
        }
    }
}

## A static-file router rooted at `root` (cwd-relative).
export type Router(root: String) {
    ## Resolve `req.path` under `root` and return a Response. Always a Response
    ## value (never a Trial). Non-GET/HEAD → 405; missing/unsafe → 404;
    ## permission denied → 403. Unexpected Io errors are logged then 404.
    export fn handle(req!: Request) -> Response {
        let isGet = req.method == "GET"
        let headOnly = req.method == "HEAD"
        if isGet {
            servePath(root, req.path, false)
        } else {
            if headOnly {
                servePath(root, req.path, true)
            } else {
                methodNotAllowed("GET, HEAD")
            }
        }
    }
}

## Resolve a URL path under `root` (shared by GET and HEAD).
fn servePath(root!: String, urlPath!: String, headOnly: Bool) -> Response {
    let raw = Bytes.fromString(urlPath)
    if raw.count == 0 {
        return notFound()
    }
    if raw.get(0) != 47 {
        return notFound()
    }
    let segs = pathSegments(urlPath)
    if hasUnsafeSegment(segs) {
        return notFound()
    }
    let candidate = joinPath(root, segs)
    match readFile(candidate) {
        Pass(body) {
            fileResponse(body, candidate, headOnly)
        }
        Fail(err1) {
            if isForbiddenish(err1) {
                warn("forbid {candidate}: {err1}")
                forbidden()
            } else {
                let indexPath = "{candidate}/index.html"
                match readFile(indexPath) {
                    Pass(body) {
                        fileResponse(body, indexPath, headOnly)
                    }
                    Fail(err2) {
                        failResponse(indexPath, err2)
                    }
                }
            }
        }
    }
}
