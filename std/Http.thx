## std/Http — HTTP/1.1 request parsing and response building (pure protocol; no syscalls).
## Request body is always empty Bytes until body reading lands. Fail payloads are String.

import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"

## One header field: name and value as Strings (ASCII for this demo).
export type Header(name: String, value: String)

## A parsed request. `body` is always empty Bytes until body reading lands.
export type Request(
    method: String,
    path: String,
    version: String,
    headers: Array<Header>,
    body: Bytes
)

## A response to serialize: status line, headers, body.
export type Response(
    status: Int64,
    reason: String,
    headers: Array<Header>,
    body: Bytes
)

## Shared constructor for text/binary responses with the usual close headers.
export fn response(
    status!: Int64,
    reason!: String,
    contentType!: String,
    body!: Bytes
) -> Response {
    let headers = [
        Header(name: "Content-Type", value: contentType),
        Header(name: "Content-Length", value: "{body.count}"),
        Header(name: "Connection", value: "close"),
    ]
    Response(status: status, reason: reason, headers: headers, body: body)
}

## Like `response`, but keeps a declared Content-Length while sending an empty body
## (HTTP HEAD).
export fn responseHead(
    status!: Int64,
    reason!: String,
    contentType!: String,
    contentLength!: Int64
) -> Response {
    let headers = [
        Header(name: "Content-Type", value: contentType),
        Header(name: "Content-Length", value: "{contentLength}"),
        Header(name: "Connection", value: "close"),
    ]
    Response(status: status, reason: reason, headers: headers, body: Bytes(0))
}

## Parse a raw request buffer into a Request. Fails on incomplete or malformed input.
## Body bytes after the header separator are ignored; `body` is always empty.
export fn parseRequest(raw!: Bytes) -> Trial<Request, String> {
    let sep = Bytes.fromString("\r\n\r\n")
    match raw.find(sep) {
        Not {
            Fail("incomplete request")
        }
        Has(sepAt) {
            let headerBlock = raw.slice(0, sepAt)
            let crlf = Bytes.fromString("\r\n")
            ## First line = request line; remaining lines = headers.
            let reqLine = match headerBlock.find(crlf) {
                Not { headerBlock }
                Has(firstCrlf) { headerBlock.slice(0, firstCrlf) }
            }
            if reqLine.count == 0 {
                Fail("empty request line")
            } else {
                let sp = Bytes.fromString(" ")
                match reqLine.find(sp) {
                    Not {
                        Fail("malformed request line")
                    }
                    Has(sp1) {
                        match reqLine.find(sp, sp1 + 1) {
                            Not {
                                Fail("malformed request line")
                            }
                            Has(sp2) {
                                ## Reject extra spaces / extra tokens on the request line.
                                match reqLine.find(sp, sp2 + 1) {
                                    Has(_) {
                                        Fail("malformed request line")
                                    }
                                    Not {
                                        parseRequestBody(reqLine, sp1, sp2, headerBlock, crlf)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

## Finish parse after a valid request-line layout (method SP target SP version).
fn parseRequestBody(
    reqLine!: Bytes,
    sp1: Int64,
    sp2: Int64,
    headerBlock!: Bytes,
    crlf!: Bytes
) -> Trial<Request, String> {
    let method = reqLine.slice(0, sp1).toString()
    mut target = reqLine.slice(sp1 + 1, sp2)
    let version = reqLine.slice(sp2 + 1, reqLine.count).toString()
    if method == "" {
        return Fail("empty method")
    }
    if version == "" {
        return Fail("empty version")
    }
    ## Strip query string: path only.
    match target.find(Bytes.fromString("?")) {
        Has(q) {
            target = target.slice(0, q)
        }
        Not { Void }
    }
    let path = target.toString()
    if path == "" {
        return Fail("empty path")
    }
    mut headers: Array<Header> = []
    let colon = Bytes.fromString(":")
    match headerBlock.find(crlf) {
        Not { Void }
        Has(firstCrlf) {
            mut pos = firstCrlf + 2
            let n = headerBlock.count
            loop {
                if pos >= n { break }
                let lineEnd = match headerBlock.find(crlf, pos) {
                    Not { n }
                    Has(next) { next }
                }
                let line = headerBlock.slice(pos, lineEnd)
                if line.count == 0 {
                    ## empty line inside header block — skip
                } else {
                    let h = parseHeaderLine(line, colon)?
                    headers.append(h)
                }
                match headerBlock.find(crlf, pos) {
                    Not { break }
                    Has(next) {
                        pos = next + 2
                    }
                }
            }
        }
    }
    let body = Bytes(0)
    Pass(Request(
        method: method,
        path: path,
        version: version,
        headers: headers,
        body: body
    ))
}

## Skip leading OWS (SP / HTAB) after the colon.
fn skipOws(line!: Bytes, start!: Int64) -> Int64 {
    mut i = start
    loop {
        if i >= line.count {
            break
        }
        let c = line.get(i)
        ## SP or HTAB
        if c == 32 {
            i = i + 1
        } else {
            if c == 9 {
                i = i + 1
            } else {
                break
            }
        }
    }
    i
}

## Trim trailing OWS from a header value slice end index.
fn trimOwsEnd(line!: Bytes, start!: Int64, end!: Int64) -> Int64 {
    mut e = end
    loop {
        if e <= start {
            break
        }
        let c = line.get(e - 1)
        if c == 32 {
            e = e - 1
        } else {
            if c == 9 {
                e = e - 1
            } else {
                break
            }
        }
    }
    e
}

fn parseHeaderLine(line!: Bytes, colon!: Bytes) -> Trial<Header, String> {
    match line.find(colon) {
        Not {
            Fail("malformed header")
        }
        Has(colonAt) {
            let name = line.slice(0, colonAt).toString()
            if name == "" {
                Fail("empty header name")
            } else {
                let valStart = skipOws(line, colonAt + 1)
                let valEnd = trimOwsEnd(line, valStart, line.count)
                let value = line.slice(valStart, valEnd).toString()
                Pass(Header(name: name, value: value))
            }
        }
    }
}

## Summarize as `METHOD|path|version` (compat for http / http_wire).
## Adapter over `parseRequest` (D69): requires a complete request (`\r\n\r\n`),
## and `path` is query-stripped (oracle-aligned `Request.path`). Pre-PR5 this was a
## looser request-line-only scan that kept `?query` and did not require the blank line.
## Returns empty string if parse fails.
export fn summarizeRequest(raw!: Bytes) -> String {
    match parseRequest(raw) {
        Pass(req) {
            "{req.method}|{req.path}|{req.version}"
        }
        Fail(_) {
            ""
        }
    }
}

## 200 OK with the given body and Content-Type.
export fn ok(body!: Bytes, contentType!: String) -> Response {
    response(200, "OK", contentType, body)
}

## 200 OK for HEAD: empty body, Content-Length of the would-be entity.
export fn okHead(contentLength!: Int64, contentType!: String) -> Response {
    responseHead(200, "OK", contentType, contentLength)
}

## 404 Not Found — plain text body.
export fn notFound() -> Response {
    response(404, "Not Found", "text/plain", Bytes.fromString("Not Found\n"))
}

## 403 Forbidden — plain text body.
export fn forbidden() -> Response {
    response(403, "Forbidden", "text/plain", Bytes.fromString("Forbidden\n"))
}

## 400 Bad Request — plain text body (optional detail message).
export fn badRequest(msg!: String) -> Response {
    response(400, "Bad Request", "text/plain", Bytes.fromString("Bad Request: {msg}\n"))
}

## 405 Method Not Allowed — plain text body + Allow header.
export fn methodNotAllowed(allow!: String) -> Response {
    let body = Bytes.fromString("Method Not Allowed\n")
    let headers = [
        Header(name: "Content-Type", value: "text/plain"),
        Header(name: "Content-Length", value: "{body.count}"),
        Header(name: "Allow", value: allow),
        Header(name: "Connection", value: "close"),
    ]
    Response(status: 405, reason: "Method Not Allowed", headers: headers, body: body)
}

## Serialize a Response to wire bytes (status line + headers + body).
export fn writeResponse(res!: Response) -> Bytes {
    mut buf = Buffer()
    buf.appendBytes(Bytes.fromString("HTTP/1.1 {res.status} {res.reason}\r\n"))
    for h in res.headers {
        buf.appendBytes(Bytes.fromString("{h.name}: {h.value}\r\n"))
    }
    buf.appendBytes(Bytes.fromString("\r\n"))
    buf.appendBytes(res.body)
    buf.freeze()
}
