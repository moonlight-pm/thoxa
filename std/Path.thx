## std/Path — path string helpers (POSIX `/` separators).

import { startsWith, dropPrefix } from "./Str"

extern fn sysGetcwd(buf!: Bytes, size!: UInt64) -> String from "c" "getcwd"
extern fn sysGetenv(name!: String) -> String from "c" "getenv"

let pathCwdBufSize = 4096

export fn lastSlash(s!: String) -> Int64 {
    let b = Bytes.fromString(s)
    mut i = b.count - 1
    mut found = 0 - 1
    loop {
        if i < 0 {
            break
        }
        if b.get(i) == 47 {
            found = i
            break
        }
        i = i - 1
    }
    found
}

export fn dirname(path!: String) -> String {
    let i = lastSlash(path)
    if i < 0 {
        "."
    } else {
        if i == 0 {
            "/"
        } else {
            Bytes.fromString(path).slice(0, i).toString()
        }
    }
}

export fn basename(path!: String) -> String {
    let i = lastSlash(path)
    if i < 0 {
        path
    } else {
        let b = Bytes.fromString(path)
        if i + 1 >= b.count {
            ""
        } else {
            b.slice(i + 1, b.count).toString()
        }
    }
}

## Join two path fragments with `/`. Empty sides collapse; absolute `right`
## replaces `left`; a trailing slash on `left` is not doubled.
export fn join(left!: String, right!: String) -> String {
    if left == "" {
        right
    } else {
        if right == "" {
            left
        } else {
            if startsWith(right, "/") {
                right
            } else {
                let lb = Bytes.fromString(left)
                if lb.count > 0 {
                    if lb.get(lb.count - 1) == 47 {
                        "{left}{right}"
                    } else {
                        "{left}/{right}"
                    }
                } else {
                    right
                }
            }
        }
    }
}

## True when `path` starts with `/` (POSIX absolute).
export fn isAbsolute(path!: String) -> Bool {
    startsWith(path, "/")
}

## Collapse repeated `/` separators (does not resolve `.` / `..`).
export fn normalize(path!: String) -> String {
    let b = Bytes.fromString(path)
    if b.count == 0 {
        ""
    } else {
        mut out = Bytes(b.count)
        mut o = 0
        mut i = 0
        mut prevSlash = false
        loop {
            if i >= b.count {
                break
            }
            let c = b.get(i)
            if c == 47 {
                if !prevSlash {
                    out.set(o, 47)
                    o = o + 1
                    prevSlash = true
                }
            } else {
                out.set(o, c)
                o = o + 1
                prevSlash = false
            }
            i = i + 1
        }
        if o == 0 {
            ""
        } else {
            out.slice(0, o).toString()
        }
    }
}

## Extension after the last `.` in the basename, or `""` if none / leading-dot only.
export fn extension(path!: String) -> String {
    let base = basename(path)
    let b = Bytes.fromString(base)
    mut i = b.count - 1
    mut dot = 0 - 1
    loop {
        if i <= 0 {
            break
        }
        if b.get(i) == 46 {
            dot = i
            break
        }
        i = i - 1
    }
    if dot <= 0 {
        ""
    } else {
        b.slice(dot + 1, b.count).toString()
    }
}

## Basename without a non-leading extension (`.git` stays `.git`).
export fn stem(path!: String) -> String {
    let base = basename(path)
    let ext = extension(path)
    if ext == "" {
        base
    } else {
        let b = Bytes.fromString(base)
        let cut = b.count - Bytes.fromString(ext).count - 1
        if cut <= 0 {
            base
        } else {
            b.slice(0, cut).toString()
        }
    }
}

## Current working directory, or "" on failure.
export fn cwd() -> String {
    let buf = Bytes(pathCwdBufSize)
    sysGetcwd(buf, pathCwdBufSize)
}

## zsh-style `%2~`: home as `~`, then at most the last two path components.
export fn shortPath(full!: String) -> String {
    let home = sysGetenv("HOME")
    mut path = full
    if home != "" {
        if full == home {
            path = "~"
        } else {
            let homeSlash = "{home}/"
            if startsWith(full, homeSlash) {
                let rest = dropPrefix(full, homeSlash)
                path = "~/{rest}"
            }
        }
    }
    if path == "/" {
        "/"
    } else {
        if path == "~" {
            "~"
        } else {
            let parent = dirname(path)
            let base = basename(path)
            if parent == "/" {
                "/{base}"
            } else {
                if parent == "~" {
                    "~/{base}"
                } else {
                    if parent == "." {
                        base
                    } else {
                        let grand = basename(parent)
                        "{grand}/{base}"
                    }
                }
            }
        }
    }
}

## `shortPath(cwd())`, or `"?"` if getcwd fails.
export fn cwdShort() -> String {
    let path = cwd()
    if path == "" {
        "?"
    } else {
        shortPath(path)
    }
}
