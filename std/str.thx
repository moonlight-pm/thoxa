## std/str — text helpers that are not String methods.
##
## Everything a String does to itself is a method (`s.contains(x)`,
## `s.indexOf(x)`, `s.substring(1, 4)`, D195). What is left here returns a
## std type (`splitOnce` → `Split`) or parses text (`parseUInt`).

import { Has, Not, May } from "std/fallible"

## Text before and after the first `sep`. Empty `sep` or no match → `Not`.
export type Split(before: String, after: String)

export fn splitOnce(s!: String, sep!: String) -> May<Split> {
    if sep.isEmpty() {
        Not()
    } else {
        match s.indexOf(sep) {
            Not => Not()
            Has(at) => Has(Split(before: s.substring(0, at), after: s.substring(at + sep.count, s.count)))
        }
    }
}

## Unsigned decimal digits only. Empty or any non-digit → `Not`.
export fn parseUInt(s!: String) -> May<Int64> {
    let digits = Bytes.fromString(s)
    let n = digits.count
    if n == 0 {
        Not()
    } else {
        mut val = 0
        mut i = 0
        mut ok = true
        loop {
            if i >= n {
                break
            }
            let c = digits.get(i)
            if c < 48 {
                ok = false
                break
            }
            if c > 57 {
                ok = false
                break
            }
            let digit = c - 48
            ## Above Int64 max is Not, never a wrapped negative.
            if val > (9223372036854775807 - digit) / 10 {
                ok = false
                break
            }
            val = val * 10 + digit
            i = i + 1
        }
        if ok {
            Has(val)
        } else {
            Not()
        }
    }
}
