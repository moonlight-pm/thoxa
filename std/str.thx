## std/str — byte-indexed String helpers.
##
## Search, case, trim, split, replace, and join are methods on String
## (`s.contains(x, ignoreCase: true)`, D195). What is left here counts or
## cuts by bytes; it moves onto String with Unicode scalar indexes next.

import { Has, Not, May } from "std/fallible"

## Byte length of `s`.
export fn length(s!: String) -> Int64 {
    Bytes.fromString(s).count
}

## Substring from `start` (inclusive) to `end` (exclusive), clamped to bounds.
export fn substring(s!: String, start!: Int64, end!: Int64) -> String {
    let b = Bytes.fromString(s)
    mut a = start
    mut z = end
    if a < 0 {
        a = 0
    }
    if z < 0 {
        z = 0
    }
    if a > b.count {
        a = b.count
    }
    if z > b.count {
        z = b.count
    }
    if a >= z {
        ""
    } else {
        b.slice(a, z).toString()
    }
}

## Count non-overlapping occurrences of `needle` (`""` → 0).
export fn count(s!: String, needle!: String) -> Int64 {
    let nlen = Bytes.fromString(needle).count
    if nlen == 0 {
        0
    } else {
        mut total = 0
        mut rest = s
        loop {
            let i = indexOf(rest, needle)
            if i < 0 {
                break
            }
            total = total + 1
            let r = Bytes.fromString(rest)
            let next = i + nlen
            if next >= r.count {
                break
            }
            rest = r.slice(next, r.count).toString()
        }
        total
    }
}

## Pad on the left with `pad` (defaults to space) until at least `width` bytes.
export fn padLeft(s!: String, width!: Int64, pad!: String = " ") -> String {
    let cur = length(s)
    if cur >= width {
        s
    } else {
        let need = width - cur
        let unit = if pad == "" {
            " "
        } else {
            pad
        }
        let u = length(unit)
        mut out = ""
        mut left = need
        loop {
            if left <= 0 {
                break
            }
            if left >= u {
                out = "{out}{unit}"
                left = left - u
            } else {
                out = "{out}{Bytes.fromString(unit).slice(0, left).toString()}"
                left = 0
            }
        }
        "{out}{s}"
    }
}

## Pad on the right with `pad` until at least `width` bytes.
export fn padRight(s!: String, width!: Int64, pad!: String = " ") -> String {
    let cur = length(s)
    if cur >= width {
        s
    } else {
        let need = width - cur
        let unit = if pad == "" {
            " "
        } else {
            pad
        }
        let u = length(unit)
        mut out = s
        mut left = need
        loop {
            if left <= 0 {
                break
            }
            if left >= u {
                out = "{out}{unit}"
                left = left - u
            } else {
                out = "{out}{Bytes.fromString(unit).slice(0, left).toString()}"
                left = 0
            }
        }
        out
    }
}

## First index of `needle` in `s`, or `-1` if missing (byte-oriented).
export fn indexOf(s!: String, needle!: String) -> Int64 {
    let a = Bytes.fromString(s)
    let b = Bytes.fromString(needle)
    if b.count == 0 {
        0
    } else {
        if b.count > a.count {
            0 - 1
        } else {
            mut found = 0 - 1
            mut i = 0
            let last = a.count - b.count
            loop {
                if i > last {
                    break
                }
                mut j = 0
                mut ok = true
                loop {
                    if j >= b.count {
                        break
                    }
                    if a.get(i + j) != b.get(j) {
                        ok = false
                        break
                    }
                    j = j + 1
                }
                if ok {
                    found = i
                    break
                }
                i = i + 1
            }
            found
        }
    }
}

## Last index of `needle` in `s`, or `-1` if missing.
export fn lastIndexOf(s!: String, needle!: String) -> Int64 {
    let a = Bytes.fromString(s)
    let b = Bytes.fromString(needle)
    if b.count == 0 {
        a.count
    } else {
        if b.count > a.count {
            0 - 1
        } else {
            mut found = 0 - 1
            mut i = a.count - b.count
            loop {
                if i < 0 {
                    break
                }
                mut j = 0
                mut ok = true
                loop {
                    if j >= b.count {
                        break
                    }
                    if a.get(i + j) != b.get(j) {
                        ok = false
                        break
                    }
                    j = j + 1
                }
                if ok {
                    found = i
                    break
                }
                i = i - 1
            }
            found
        }
    }
}

## First `sep` only. Empty `sep` or no match → `Not`.
export type Split(before: String, after: String)

export fn splitOnce(s!: String, sep!: String) -> May<Split> {
    if sep == "" {
        Not()
    } else {
        let i = indexOf(s, sep)
        if i < 0 {
            Not()
        } else {
            let b = Bytes.fromString(s)
            let slen = Bytes.fromString(sep).count
            let before = if i == 0 {
                ""
            } else {
                b.slice(0, i).toString()
            }
            let afterStart = i + slen
            let after = if afterStart >= b.count {
                ""
            } else {
                b.slice(afterStart, b.count).toString()
            }
            Has(Split(before: before, after: after))
        }
    }
}

## Unsigned decimal digits only. Empty or any non-digit → `Not`.
export fn parseUInt(s!: String) -> May<Int64> {
    let n = length(s)
    if n == 0 {
        Not()
    } else {
        mut val = 0
        mut i = 0
        mut ok = true
        loop {
            if i >= n {
                break
            }
            let c = byteAt(s, i)
            if c < 48 {
                ok = false
                break
            }
            if c > 57 {
                ok = false
                break
            }
            let digit = c - 48
            ## Above Int64 max is Not, never a wrapped negative.
            if val > (9223372036854775807 - digit) / 10 {
                ok = false
                break
            }
            val = val * 10 + digit
            i = i + 1
        }
        if ok {
            Has(val)
        } else {
            Not()
        }
    }
}

## Byte at index `i`, or `-1` if out of range.
export fn byteAt(s!: String, i!: Int64) -> Int64 {
    let b = Bytes.fromString(s)
    if i < 0 {
        0 - 1
    } else {
        if i >= b.count {
            0 - 1
        } else {
            b.get(i)
        }
    }
}

## First `max` bytes of `s` (`max <= 0` → `""`; `max >= length` → `s`).
export fn truncate(s!: String, max!: Int64) -> String {
    if max <= 0 {
        ""
    } else {
        let b = Bytes.fromString(s)
        if b.count <= max {
            s
        } else {
            b.slice(0, max).toString()
        }
    }
}

## Reverse byte order (not Unicode-aware).
export fn reverse(s!: String) -> String {
    let b = Bytes.fromString(s)
    if b.count == 0 {
        ""
    } else {
        mut out = Bytes(b.count)
        mut i = 0
        loop {
            if i >= b.count {
                break
            }
            out.set(i, b.get(b.count - 1 - i))
            i = i + 1
        }
        out.toString()
    }
}
