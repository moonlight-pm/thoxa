## std/Env — process environment + small RT prompt helpers.

import { cwd } from "./Path"

extern fn sysGetenv(name!: String) -> String from "c" "getenv"
extern fn sysLocalHms() -> String from "c" "thoxa_local_hms"
extern fn sysHostname() -> String from "c" "thoxa_hostname"

export fn getenv(name!: String) -> String {
    sysGetenv(name)
}

## True when the environment variable is set and non-empty.
export fn hasEnv(name!: String) -> Bool {
    getenv(name) != ""
}

## `getenv(name)` if non-empty, else `fallback`.
export fn getenvOr(name!: String, fallback!: String) -> String {
    let v = getenv(name)
    if v == "" {
        fallback
    } else {
        v
    }
}

## `$HOME`, or empty when unset.
export fn home() -> String {
    getenv("HOME")
}

## Prefer `$TMPDIR`, else `$TMP`, else `/tmp`.
export fn tmpdir() -> String {
    let a = getenv("TMPDIR")
    if a != "" {
        a
    } else {
        let b = getenv("TMP")
        if b != "" {
            b
        } else {
            "/tmp"
        }
    }
}

## Local wall clock as `HH:MM:SS` (thoxa_rt).
export fn localHms() -> String {
    sysLocalHms()
}

## Host name (gethostname), or `"localhost"`.
export fn hostname() -> String {
    sysHostname()
}

## `$USER`, else `$LOGNAME`, else empty.
export fn userName() -> String {
    let u = sysGetenv("USER")
    if u == "" {
        sysGetenv("LOGNAME")
    } else {
        u
    }
}

## `$SHELL`, or empty when unset.
export fn shell() -> String {
    getenv("SHELL")
}

## `$PATH`, or empty when unset.
export fn pathVar() -> String {
    getenv("PATH")
}

## Current working directory (alias of `Path.cwd`), or `""` on failure.
export fn pwd() -> String {
    cwd()
}
