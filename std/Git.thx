## std/Git — lightweight repo probes (no `git` subprocess).

import { startsWith, dropPrefix, trimNewline } from "./Str"
import { dirname, cwd } from "./Path"

extern fn cOpen(path!: String, flags!: Int32) -> Int32 from "c" "open"
extern fn cRead(fd!: Int32, buf!: Bytes, count!: UInt64) -> Int64 from "c" "read"
extern fn cClose(fd!: Int32) -> Int32 from "c" "close"

## O_RDONLY is 0 on Linux / *BSD.
let oRdonly = 0

fn readFileLimited(path!: String, max!: Int64) -> String {
    let fd = cOpen(path, oRdonly)
    if fd < 0 {
        ""
    } else {
        let buf = Bytes(max)
        let n = cRead(fd, buf, max)
        cClose(fd)
        if n <= 0 {
            ""
        } else {
            buf.slice(0, n).toString()
        }
    }
}

## Bare branch name for `dir`, walking parents for `.git/HEAD`.
## Detached HEAD / missing repo → `""`.
export fn branchName(startDir!: String) -> String {
    let refPrefix = "ref: refs/heads/"
    if startDir == "" {
        ""
    } else {
        mut dir = startDir
        mut out = ""
        mut steps = 0
        loop {
            if steps > 64 {
                break
            }
            let headPath = "{dir}/.git/HEAD"
            let raw = trimNewline(readFileLimited(headPath, 256))
            if raw != "" {
                if startsWith(raw, refPrefix) {
                    out = dropPrefix(raw, refPrefix)
                }
                break
            }
            if dir == "/" {
                break
            }
            let parent = dirname(dir)
            if parent == dir {
                break
            }
            dir = parent
            steps = steps + 1
        }
        out
    }
}

## Directory containing `.git/HEAD` for `startDir`, or `""` if none.
export fn repoRoot(startDir!: String) -> String {
    if startDir == "" {
        ""
    } else {
        mut dir = startDir
        mut out = ""
        mut steps = 0
        loop {
            if steps > 64 {
                break
            }
            let headPath = "{dir}/.git/HEAD"
            let raw = readFileLimited(headPath, 16)
            if raw != "" {
                out = dir
                break
            }
            if dir == "/" {
                break
            }
            let parent = dirname(dir)
            if parent == dir {
                break
            }
            dir = parent
            steps = steps + 1
        }
        out
    }
}

## True when `dir` or an ancestor has a readable `.git/HEAD` (any content).
export fn isRepo(startDir!: String) -> Bool {
    repoRoot(startDir) != ""
}

## True when `.git/HEAD` is readable and not a `ref: refs/heads/…` branch line
## (detached SHA, or other non-branch content). Missing repo → false.
export fn isDetached(startDir!: String) -> Bool {
    if startDir == "" {
        false
    } else {
        mut dir = startDir
        mut out = false
        mut steps = 0
        loop {
            if steps > 64 {
                break
            }
            let headPath = "{dir}/.git/HEAD"
            let raw = trimNewline(readFileLimited(headPath, 256))
            if raw != "" {
                if startsWith(raw, "ref: refs/heads/") {
                    out = false
                } else {
                    out = true
                }
                break
            }
            if dir == "/" {
                break
            }
            let parent = dirname(dir)
            if parent == dir {
                break
            }
            dir = parent
            steps = steps + 1
        }
        out
    }
}

## Branch name for `dir` with a leading space when present (zsh-style prompt).
## Detached HEAD / missing repo → `""`. On a branch → `" <name>"`.
export fn branchSuffix(startDir!: String) -> String {
    let name = branchName(startDir)
    if name == "" {
        ""
    } else {
        " {name}"
    }
}

## `branchSuffix(cwd())`.
export fn branch() -> String {
    branchSuffix(cwd())
}

## `branchName(cwd())`.
export fn branchHere() -> String {
    branchName(cwd())
}
