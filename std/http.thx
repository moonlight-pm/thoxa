## std/Http — HTTP/1.1 request parsing and response building (pure protocol; no syscalls).
## `parseRequest` fills `query` (no leading `?`) and leaves `body` empty.
## Hosts complete the body via `std/http/server.readBody`. Fail payloads are String.

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import { toLowerAscii, trim, split, splitOnce, parseUInt, isEmpty, contains, substring, replaceAll } from "std/str"
import { JInt, JFloat, decode, Issue, issueMismatch } from "std/json"

## One header field: name and value as Strings (ASCII for this demo).
export type Header(name: String, value: String)

## A parsed request. `path` is query-stripped; `query` has no leading `?`.
## `body` is empty until a host (`std/http/server.readBody`) fills it.
export type Request(
    method: String,
    path: String,
    query: String,
    version: String,
    headers: Array<Header>,
    body: Bytes,
    ## Host-only. `std/http/server` fills this with the peer fd so a handler
    ## can take over the socket (SSE). `parseRequest` leaves 0.
    peerFd: Int64 = 0
)

## A response to serialize: status line, headers, body.
export type Response(
    status: Int64,
    reason: String,
    headers: Array<Header>,
    body: Bytes
)

## `Set-Cookie` SameSite token. Default on `Cookie` is `"Lax"`.
export type SameSite = "Strict" | "Lax" | "None"

## One `Set-Cookie` cookie. `name` / `value` are required; the rest are
## protocol attributes (empty `path` / `domain` omit those attrs; `Not`
## `maxAge` is a session cookie). App policy (name, Max-Age, HttpOnly) stays
## at the call site.
export type Cookie(
    name: String,
    value: String,
    path: String = "/",
    domain: String = "",
    maxAge: May<Int64> = Not(),
    httpOnly: Bool = false,
    secure: Bool = false,
    sameSite: SameSite = "Lax"
) {
    ## `Set-Cookie` header value (no header name).
    export fn header() -> String {
        mut line = "{name}={value}"
        if not isEmpty(path) {
            line = "{line}; Path={path}"
        }
        if not isEmpty(domain) {
            line = "{line}; Domain={domain}"
        }
        match maxAge {
            Has(seconds) {
                line = "{line}; Max-Age={seconds}"
            }
            Not { }
        }
        if httpOnly {
            line = "{line}; HttpOnly"
        }
        if secure {
            line = "{line}; Secure"
        }
        line = "{line}; SameSite={sameSite}"
        line
    }
}

## Shared constructor for text/binary responses with the usual close headers.
export fn response(
    status!: Int64,
    reason!: String,
    contentType!: String,
    body!: Bytes
) -> Response {
    let headers = [
        Header(name: "Content-Type", value: contentType),
        Header(name: "Content-Length", value: "{body.count}"),
        Header(name: "Connection", value: "close"),
    ]
    Response(status: status, reason: reason, headers: headers, body: body)
}

## Like `response`, but keeps a declared Content-Length while sending an empty body
## (HTTP HEAD).
export fn responseHead(
    status!: Int64,
    reason!: String,
    contentType!: String,
    contentLength!: Int64
) -> Response {
    let headers = [
        Header(name: "Content-Type", value: contentType),
        Header(name: "Content-Length", value: "{contentLength}"),
        Header(name: "Connection", value: "close"),
    ]
    Response(status: status, reason: reason, headers: headers, body: Bytes(0))
}

## Parse a raw request buffer into a Request. Fails on incomplete or malformed input.
## Body bytes after the header separator are ignored; `body` is always empty.
export fn parseRequest(raw!: Bytes) -> Trial<Request, String> {
    let sep = Bytes.fromString("\r\n\r\n")
    match raw.find(sep) {
        Not {
            Fail("incomplete request")
        }
        Has(sepAt) {
            let headerBlock = raw.slice(0, sepAt)
            let crlf = Bytes.fromString("\r\n")
            ## First line = request line; remaining lines = headers.
            let reqLine = match headerBlock.find(crlf) {
                Not { headerBlock }
                Has(firstCrlf) { headerBlock.slice(0, firstCrlf) }
            }
            if reqLine.count == 0 {
                Fail("empty request line")
            } else {
                let sp = Bytes.fromString(" ")
                match reqLine.find(sp) {
                    Not {
                        Fail("malformed request line")
                    }
                    Has(sp1) {
                        match reqLine.find(sp, sp1 + 1) {
                            Not {
                                Fail("malformed request line")
                            }
                            Has(sp2) {
                                ## Reject extra spaces / extra tokens on the request line.
                                match reqLine.find(sp, sp2 + 1) {
                                    Has(_) {
                                        Fail("malformed request line")
                                    }
                                    Not {
                                        parseRequestBody(reqLine, sp1, sp2, headerBlock, crlf)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

## Finish parse after a valid request-line layout (method SP target SP version).
fn parseRequestBody(
    reqLine!: Bytes,
    sp1: Int64,
    sp2: Int64,
    headerBlock!: Bytes,
    crlf!: Bytes
) -> Trial<Request, String> {
    ## Method and target are visible ASCII (RFC 9112): no control byte, so
    ## no NUL to cut a file path short and nothing raw for the log to print.
    if not isVisibleAscii(reqLine.slice(0, sp1)) {
        return Fail("malformed method")
    }
    if not isVisibleAscii(reqLine.slice(sp1 + 1, sp2)) {
        return Fail("request target must be visible ASCII")
    }
    let method = reqLine.slice(0, sp1).toString()
    mut target = reqLine.slice(sp1 + 1, sp2)
    let version = reqLine.slice(sp2 + 1, reqLine.count).toString()
    if method == "" {
        return Fail("empty method")
    }
    if version == "" {
        return Fail("empty version")
    }
    mut query = ""
    match target.find(Bytes.fromString("?")) {
        Has(q) {
            query = target.slice(q + 1, target.count).toString()
            target = target.slice(0, q)
        }
        Not { Void }
    }
    let path = target.toString()
    if path == "" {
        return Fail("empty path")
    }
    mut headers: Array<Header> = []
    let colon = Bytes.fromString(":")
    match headerBlock.find(crlf) {
        Not { Void }
        Has(firstCrlf) {
            mut pos = firstCrlf + 2
            let n = headerBlock.count
            loop {
                if pos >= n { break }
                let lineEnd = match headerBlock.find(crlf, pos) {
                    Not { n }
                    Has(next) { next }
                }
                let line = headerBlock.slice(pos, lineEnd)
                if line.count == 0 {
                    ## empty line inside header block — skip
                } else {
                    let h = parseHeaderLine(line, colon)?
                    headers.append(h)
                }
                match headerBlock.find(crlf, pos) {
                    Not { break }
                    Has(next) {
                        pos = next + 2
                    }
                }
            }
        }
    }
    let body = Bytes(0)
    Pass(Request(
        method: method,
        path: path,
        query: query,
        version: version,
        headers: headers,
        body: body,
        peerFd: 0
    ))
}

## Visible ASCII (0x21–0x7E) only: no space, control byte, or raw non-ASCII.
fn isVisibleAscii(bytes!: Bytes) -> Bool {
    for index in 0..bytes.count {
        let byte = bytes.get(index)
        if byte < 33 or byte > 126 {
            return false
        }
    }
    true
}

## Skip leading OWS (SP / HTAB) after the colon.
fn skipOws(line!: Bytes, start!: Int64) -> Int64 {
    mut i = start
    loop {
        if i >= line.count {
            break
        }
        let c = line.get(i)
        ## SP or HTAB
        if c == 32 {
            i = i + 1
        } else {
            if c == 9 {
                i = i + 1
            } else {
                break
            }
        }
    }
    i
}

## Trim trailing OWS from a header value slice end index.
fn trimOwsEnd(line!: Bytes, start!: Int64, end!: Int64) -> Int64 {
    mut e = end
    loop {
        if e <= start {
            break
        }
        let c = line.get(e - 1)
        if c == 32 {
            e = e - 1
        } else {
            if c == 9 {
                e = e - 1
            } else {
                break
            }
        }
    }
    e
}

fn parseHeaderLine(line!: Bytes, colon!: Bytes) -> Trial<Header, String> {
    match line.find(colon) {
        Not {
            Fail("malformed header")
        }
        Has(colonAt) {
            let name = line.slice(0, colonAt).toString()
            if name == "" {
                Fail("empty header name")
            } else if not isVisibleAscii(line.slice(0, colonAt)) {
                ## `Content-Length : 5` — a proxy may read that header, or not.
                Fail("malformed header name")
            } else {
                let valStart = skipOws(line, colonAt + 1)
                let valEnd = trimOwsEnd(line, valStart, line.count)
                let value = line.slice(valStart, valEnd).toString()
                Pass(Header(name: name, value: value))
            }
        }
    }
}

## Summarize as `METHOD|path|version` (compat for http / http_wire).
## Adapter over `parseRequest` (D69): requires a complete request (`\r\n\r\n`),
## and `path` is query-stripped (oracle-aligned `Request.path`). Pre-PR5 this was a
## looser request-line-only scan that kept `?query` and did not require the blank line.
## Returns empty string if parse fails.
export fn summarizeRequest(raw!: Bytes) -> String {
    match parseRequest(raw) {
        Pass(req) {
            "{req.method}|{req.path}|{req.version}"
        }
        Fail(_) {
            ""
        }
    }
}

## 200 OK with the given body and Content-Type.
export fn ok(body!: Bytes, contentType!: String) -> Response {
    response(200, "OK", contentType, body)
}

## 200 OK for HEAD: empty body, Content-Length of the would-be entity.
export fn okHead(contentLength!: Int64, contentType!: String) -> Response {
    responseHead(200, "OK", contentType, contentLength)
}

## 404 Not Found — plain text body.
export fn notFound() -> Response {
    response(404, "Not Found", "text/plain", Bytes.fromString("Not Found\n"))
}

## 403 Forbidden — plain text body.
export fn forbidden() -> Response {
    response(403, "Forbidden", "text/plain", Bytes.fromString("Forbidden\n"))
}

## 400 Bad Request — plain text body (optional detail message).
export fn badRequest(msg!: String) -> Response {
    response(400, "Bad Request", "text/plain", Bytes.fromString("Bad Request: {msg}\n"))
}

## 405 Method Not Allowed — plain text body + Allow header.
export fn methodNotAllowed(allow!: String) -> Response {
    let body = Bytes.fromString("Method Not Allowed\n")
    let headers = [
        Header(name: "Content-Type", value: "text/plain"),
        Header(name: "Content-Length", value: "{body.count}"),
        Header(name: "Allow", value: allow),
        Header(name: "Connection", value: "close"),
    ]
    Response(status: 405, reason: "Method Not Allowed", headers: headers, body: body)
}

## A header name or value with CR / LF dropped, so a value built from
## request input cannot end the header and start another (response splitting).
fn headerText(text!: String) -> String {
    if contains(text, "\r") or contains(text, "\n") {
        replaceAll(replaceAll(text, "\r", ""), "\n", "")
    } else {
        text
    }
}

## Serialize a Response to wire bytes (status line + headers + body).
export fn writeResponse(res!: Response) -> Bytes {
    mut buf = Buffer()
    buf.appendBytes(Bytes.fromString("HTTP/1.1 {res.status} {headerText(res.reason)}\r\n"))
    for h in res.headers {
        buf.appendBytes(Bytes.fromString("{headerText(h.name)}: {headerText(h.value)}\r\n"))
    }
    buf.appendBytes(Bytes.fromString("\r\n"))
    buf.appendBytes(res.body)
    buf.freeze()
}

## Case-insensitive header lookup (first match).
export fn headerGet(req!: Request, name!: String) -> May<String> {
    let want = toLowerAscii(name)
    for h in req.headers {
        if toLowerAscii(h.name) == want {
            return Has(h.value)
        }
    }
    Not()
}

export fn contentLength(req!: Request) -> May<Int64> {
    match headerGet(req, "Content-Length") {
        Not => Not()
        Has(v) {
            parseUInt(trim(v))
        }
    }
}

export fn queryMap(req!: Request) -> Map<String, String> {
    parseQuery(req.query)
}

export fn queryParam(req!: Request, key!: String) -> May<String> {
    queryMap(req)[key]
}

export fn parseQuery(query!: String) -> Map<String, String> {
    parsePairs(query, "&")
}

export fn parseForm(body!: Bytes) -> Map<String, String> {
    parsePairs(body.toString(), "&")
}

export fn formField(body!: Bytes, key!: String) -> May<String> {
    parseForm(body)[key]
}

## One `name=value` pair of a form body or query string, decoded (D182 §3).
export type FormPair(name: String, value: String)

## Every pair in order, repeated names kept (`tag=a&tag=b`). `T.readForm`
## reads these.
export fn formPairs(text!: String) -> Array<FormPair> {
    mut pairs: Array<FormPair> = []
    for part in split(text, "&") {
        if not isEmpty(part) {
            match splitOnce(part, "=") {
                Not {
                    pairs.append(FormPair(name: urlDecode(part), value: ""))
                }
                Has(cut) {
                    pairs.append(FormPair(name: urlDecode(cut.before), value: urlDecode(cut.after)))
                }
            }
        }
    }
    pairs
}

## The last value named `name`.
export fn formValue(pairs!: Array<FormPair>, name!: String) -> May<String> {
    mut found: May<String> = Not()
    for pair in pairs {
        if pair.name == name {
            found = Has(pair.value)
        }
    }
    found
}

## Every value named `name`, in order.
export fn formValues(pairs!: Array<FormPair>, name!: String) -> Array<String> {
    mut found: Array<String> = []
    for pair in pairs {
        if pair.name == name {
            found.append(pair.value)
        }
    }
    found
}

## A form field's text as an integer (a JSON integer: `42`, `-3`).
export fn formInt(text!: String, path!: String) -> Trial<Int64, Array<Issue>> {
    match decode(trim(text)) {
        Pass(value) {
            match value {
                JInt(n) => Pass(n)
                else => Fail([issueMismatch(path, "integer", text)])
            }
        }
        Fail(_) => Fail([issueMismatch(path, "integer", text)])
    }
}

## A form field's text as a number (a JSON number: `2`, `-1.5`, `1e3`).
export fn formFloat(text!: String, path!: String) -> Trial<Float64, Array<Issue>> {
    match decode(trim(text)) {
        Pass(value) {
            match value {
                JFloat(f) => Pass(f)
                JInt(n) {
                    let f: Float64 = n
                    Pass(f)
                }
                else => Fail([issueMismatch(path, "number", text)])
            }
        }
        Fail(_) => Fail([issueMismatch(path, "number", text)])
    }
}

export fn parseCookies(header!: String) -> Map<String, String> {
    mut m: Map<String, String> = Map()
    if isEmpty(header) {
        return m
    }
    let parts = split(header, ";")
    for part in parts {
        let p = trim(part)
        match splitOnce(p, "=") {
            Not { }
            Has(cut) {
                let key = trim(cut.before)
                if not isEmpty(key) {
                    m.set(key, trim(cut.after))
                }
            }
        }
    }
    m
}

fn parsePairs(raw!: String, sep!: String) -> Map<String, String> {
    mut m: Map<String, String> = Map()
    if isEmpty(raw) {
        return m
    }
    let pairs = split(raw, sep)
    for pair in pairs {
        if not isEmpty(pair) {
            match splitOnce(pair, "=") {
                Not {
                    m.set(urlDecode(pair), "")
                }
                Has(cut) {
                    m.set(urlDecode(cut.before), urlDecode(cut.after))
                }
            }
        }
    }
    m
}

export fn cookie(req!: Request, name!: String) -> May<String> {
    match headerGet(req, "Cookie") {
        Not => Not()
        Has(raw) {
            match parseCookies(raw)[name] {
                Not => Not()
                Has(val) {
                    if isEmpty(val) {
                        Not()
                    } else {
                        Has(val)
                    }
                }
            }
        }
    }
}

export fn htmlResponse(root!: Node) -> Response {
    htmlResponseStatus(200, "OK", root)
}

## Full document at a non-200 status (HTML 404 / 400 pages).
export fn htmlResponseStatus(status!: Int64, reason!: String, root!: Node) -> Response {
    response(status, reason, "text/html; charset=utf-8", Bytes.fromString("<!DOCTYPE html>\n{root.html()}"))
}

## Snippet HTML (no doctype). Pair with `cached` for fragment GETs.
export fn htmlFragment(root!: Node) -> Response {
    ok(Bytes.fromString(root.html()), "text/html; charset=utf-8")
}

## 304 Not Modified — empty body. Send ETag / Cache-Control via `cached`.
## No Content-Length: a 304 has no body, and its Content-Length would have
## to be the 200's (RFC 9110 §8.6).
export fn notModified() -> Response {
    Response(
        status: 304,
        reason: "Not Modified",
        headers: [
            Header(name: "Connection", value: "close"),
        ],
        body: Bytes(0)
    )
}

## Strong ETag: quoted 8-digit hex of a 32-bit FNV-1a over `body`.
export fn etagOf(body!: Bytes) -> String {
    "\"{hex8(fnv32(body))}\""
}

export fn ifNoneMatch(req!: Request) -> May<String> {
    headerGet(req, "If-None-Match")
}

## True when `If-None-Match` is `*` or lists `etag` (quoted token).
export fn etagFresh(req!: Request, etag!: String) -> Bool {
    match ifNoneMatch(req) {
        Not => false
        Has(header) {
            let raw = trim(header)
            if raw == "*" {
                true
            } else {
                contains(raw, etag)
            }
        }
    }
}

export fn withCache(res!: Response, cacheControl!: String, etag!: String) -> Response {
    withHeader(withHeader(res, "ETag", etag), "Cache-Control", cacheControl)
}

## Attach validators. Unchanged body + matching `If-None-Match` → 304.
## Handler already wrote the socket (SSE). Host must not `writeResponse`.
export fn streamed() -> Response {
    Response(status: 0, reason: "streamed", headers: [], body: Bytes(0))
}

export fn cached(req!: Request, res!: Response, cacheControl!: String) -> Response {
    let tag = etagOf(res.body)
    if etagFresh(req, tag) {
        withCache(notModified(), cacheControl, tag)
    } else {
        withCache(res, cacheControl, tag)
    }
}

fn fnv32(body!: Bytes) -> Int64 {
    let mask = 4294967295
    mut hash = 2166136261
    mut i = 0
    loop {
        if i >= body.count {
            break
        }
        hash = (hash ^ body.get(i)) & mask
        hash = (hash * 16777619) & mask
        i = i + 1
    }
    hash
}

fn hex8(n!: Int64) -> String {
    let digits = "0123456789abcdef"
    mut out = ""
    mut shift = 28
    loop {
        if shift < 0 {
            break
        }
        let nibble = (n >> shift) & 15
        out = "{out}{substring(digits, nibble, nibble + 1)}"
        shift = shift - 4
    }
    out
}

export fn urlDecode(s!: String) -> String {
    let b = Bytes.fromString(s)
    mut out = Buffer()
    mut i = 0
    loop {
        if i >= b.count {
            break
        }
        let c = b.get(i)
        if c == 43 {
            out.appendBytes(Bytes.fromString(" "))
            i = i + 1
        } else {
            if c == 37 {
                if i + 2 < b.count {
                    match hexByte(b.get(i + 1), b.get(i + 2)) {
                        Not {
                            out.appendBytes(b.slice(i, i + 1))
                            i = i + 1
                        }
                        Has(byte) {
                            let one = Bytes(1)
                            one.set(0, byte)
                            out.appendBytes(one)
                            i = i + 3
                        }
                    }
                } else {
                    out.appendBytes(b.slice(i, i + 1))
                    i = i + 1
                }
            } else {
                out.appendBytes(b.slice(i, i + 1))
                i = i + 1
            }
        }
    }
    out.freeze().toString()
}

fn hexNibble(c!: Int64) -> May<Int64> {
    if c >= 48 {
        if c <= 57 {
            return Has(c - 48)
        }
    }
    if c >= 65 {
        if c <= 70 {
            return Has(c - 55)
        }
    }
    if c >= 97 {
        if c <= 102 {
            return Has(c - 87)
        }
    }
    Not()
}

fn hexByte(hi!: Int64, lo!: Int64) -> May<Int64> {
    match hexNibble(hi) {
        Not => Not()
        Has(h) {
            match hexNibble(lo) {
                Not => Not()
                Has(l) {
                    Has(h * 16 + l)
                }
            }
        }
    }
}

export fn seeOther(location!: String) -> Response {
    Response(
        status: 303,
        reason: "See Other",
        headers: [
            Header(name: "Location", value: location),
            Header(name: "Content-Length", value: "0"),
            Header(name: "Connection", value: "close"),
        ],
        body: Bytes(0)
    )
}

export fn withHeader(res!: Response, name!: String, value!: String) -> Response {
    mut headers = res.headers
    headers.append(Header(name: name, value: value))
    Response(
        status: res.status,
        reason: res.reason,
        headers: headers,
        body: res.body
    )
}

## Append a `Set-Cookie` header. Call more than once for several cookies.
export fn withCookie(res!: Response, cookie!: Cookie) -> Response {
    withHeader(res, "Set-Cookie", cookie.header())
}

## Expire a cookie (`Max-Age=0`, empty value). `path` / `domain` must match
## the cookie being cleared.
export fn clearCookie(name!: String, path: String = "/", domain: String = "") -> Cookie {
    Cookie(name: name, value: "", path: path, domain: domain, maxAge: Has(0))
}

fn hasConnToken(header!: String, token!: String) -> Bool {
    let want = toLowerAscii(token)
    let parts = split(header, ",")
    for p in parts {
        if toLowerAscii(trim(p)) == want {
            return true
        }
    }
    false
}

## HTTP/1.1 stays open unless Connection: close. HTTP/1.0 closes unless keep-alive.
export fn wantsKeepAlive(version!: String, req!: Request) -> Bool {
    match headerGet(req, "Connection") {
        Not {
            version == "HTTP/1.1"
        }
        Has(v) {
            if hasConnToken(v, "close") {
                false
            } else {
                if version == "HTTP/1.1" {
                    true
                } else {
                    hasConnToken(v, "keep-alive")
                }
            }
        }
    }
}

## HEAD: keep headers (incl. Content-Length), drop body (RFC 9110 §9.3.2).
## Rewrite Connection to match whether this peer will read another request.
export fn finalize(method!: String, res!: Response, keepAlive!: Bool) -> Response {
    let conn = if keepAlive {
        "keep-alive"
    } else {
        "close"
    }
    mut headers: Array<Header> = []
    for h in res.headers {
        if toLowerAscii(h.name) != "connection" {
            headers.append(h)
        }
    }
    headers.append(Header(name: "Connection", value: conn))
    let body = if method == "HEAD" {
        Bytes(0)
    } else {
        res.body
    }
    Response(
        status: res.status,
        reason: res.reason,
        headers: headers,
        body: body
    )
}
