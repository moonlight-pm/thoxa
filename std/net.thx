## std/Net — TCP sockets (IPv4 stream; Linux product track).
## Errors are Trial<…, String> with errno/strerror polish (Io-style D80).
## `receiveRequest` accumulates until the header terminator; `sendAll` drains partial writes.
## accept / connect / receive / send park the current task when the socket would
## block (experiment/implicit-async). Sequential programs still wait, just inside
## the runtime instead of a blocking libc call.

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"

extern fn sysSocket(domain!: Int32, kind!: Int32, protocol!: Int32) -> Int32 from "c" "socket"
extern fn sysSetsockopt(fd!: Int32, level!: Int32, optname!: Int32, optval!: Bytes, optlen!: UInt32) -> Int32 from "c" "setsockopt"
extern fn sysBind(fd!: Int32, addr!: Bytes, addrlen!: UInt32) -> Int32 from "c" "bind"
extern fn sysListen(fd!: Int32, backlog!: Int32) -> Int32 from "c" "listen"
extern fn sysAccept(fd!: Int32, addr!: Bytes, addrlen!: Bytes) -> Int32 from "c" "thoxa_accept"
extern fn sysConnect(fd!: Int32, addr!: Bytes, addrlen!: UInt32) -> Int32 from "c" "thoxa_connect"
extern fn sysGetsockname(fd!: Int32, addr!: Bytes, addrlen!: Bytes) -> Int32 from "c" "getsockname"
## `deadline` is a `nowMs()` time; 0 waits forever. Past it: -1, ETIMEDOUT.
extern fn sysRecv(fd!: Int32, buf!: Bytes, len!: UInt64, flags!: Int32, deadline!: Int64) -> Int64 from "c" "thoxa_recv_until"
extern fn sysSend(fd!: Int32, buf!: Bytes, len!: UInt64, flags!: Int32, deadline!: Int64) -> Int64 from "c" "thoxa_send_until"
extern fn sysNowMs() -> Int64 from "c" "thoxa_now_ms"
extern fn sysClose(fd!: Int32) -> Int32 from "c" "thoxa_close"
extern fn sysTaskOwnSocket(socket!: Address<Socket>) from "c" "thoxa_task_own_socket"
extern fn sysTaskOwnedFds() -> Int64 from "c" "thoxa_task_owned_fds"
extern fn sysStrerror(errnum!: Int32) -> String from "c" "strerror"
extern fn sysErrno() -> Int32 from "c" "thoxa_errno"

let afInet = 2
let sockStream = 1
let ipProtoIp = 0
let solSocket = 1
let soReuseAddr = 2
let sockaddrLen = 16
let intSize = 4
let recvBufSize = 4096
## Cap header accumulation so a client cannot force unbounded memory use.
let maxRequestHeaders = 65536

## "context: reason" from the current errno, for a Fail payload.
fn netErr(what!: String) -> String {
    "{what}: {sysStrerror(sysErrno())}"
}

## errno ETIMEDOUT: a `deadline` passed.
let errTimedOut = 110

## Monotonic milliseconds. A deadline for `receive` / `receiveRequest` /
## `sendAll` is `nowMs() + budget`; 0 means no deadline.
export fn nowMs() -> Int64 {
    sysNowMs()
}

## The running task owns `socket`: if the task ends in a panic, the runtime
## closes it and sets its `fd` to -1, so every copy sees it closed (D166).
## Ownership ends when the socket closes or the task returns. Outside a task
## it does nothing.
export fn ownByTask(socket!: Socket) {
    if socket.isOpen() {
        sysTaskOwnSocket(socket)
    }
}

## Open sockets that tasks own (`ownByTask`), across all tasks.
export fn taskOwnedSockets() -> Int64 {
    sysTaskOwnedFds()
}

fn sockaddrAny(port!: Int64) -> Bytes {
    let addr = Bytes(sockaddrLen)
    addr.set(0, afInet)
    addr.set(2, port / 256)
    addr.set(3, port % 256)
    addr
}

fn sockaddrLoopback(port!: Int64) -> Bytes {
    let addr = Bytes(sockaddrLen)
    addr.set(0, afInet)
    addr.set(2, port / 256)
    addr.set(3, port % 256)
    addr.set(4, 127)
    addr.set(5, 0)
    addr.set(6, 0)
    addr.set(7, 1)
    addr
}

## Read network-order port from a sockaddr_in buffer.
fn portOf(addr!: Bytes) -> Int64 {
    addr.get(2) * 256 + addr.get(3)
}

## Open TCP handle. `fd` is Int64 for ctor-param field rules; written back to
## -1 on successful close (same D107 write-back as File). Only this module
## builds one (D168). `fd` stays the first field: the runtime's task
## ownership (`ownByTask`) writes it.
export type Socket(fd: Int64) {
    export fn isOpen() -> Bool {
        fd >= 0
    }

    export fn reuseAddr() -> Trial<Void, String> {
        let on = Bytes(intSize)
        on.set(0, 1)
        if sysSetsockopt(fd, solSocket, soReuseAddr, on, intSize) < 0 {
            Fail(netErr("setsockopt"))
        } else {
            Pass(Void)
        }
    }

    ## Bind to 0.0.0.0:port (0 = ephemeral).
    export fn bind(port!: Int64) -> Trial<Void, String> {
        if sysBind(fd, sockaddrAny(port), sockaddrLen) < 0 {
            Fail(netErr("bind"))
        } else {
            Pass(Void)
        }
    }

    export fn listen(backlog!: Int64) -> Trial<Void, String> {
        if sysListen(fd, backlog) < 0 {
            Fail(netErr("listen"))
        } else {
            Pass(Void)
        }
    }

    ## Local port after bind (for ephemeral ports).
    export fn localPort() -> Trial<Int64, String> {
        let addr = Bytes(sockaddrLen)
        let len = Bytes(intSize)
        len.set(0, sockaddrLen)
        if sysGetsockname(fd, addr, len) < 0 {
            Fail(netErr("getsockname"))
        } else {
            Pass(portOf(addr))
        }
    }

    export fn accept() -> Trial<Socket, String> {
        let caddr = Bytes(sockaddrLen)
        let clen = Bytes(intSize)
        clen.set(0, sockaddrLen)
        let client = sysAccept(fd, caddr, clen)
        if client < 0 {
            Fail(netErr("accept"))
        } else {
            Pass(Socket(fd: client))
        }
    }

    export fn connect(port!: Int64) -> Trial<Void, String> {
        if sysConnect(fd, sockaddrLoopback(port), sockaddrLen) < 0 {
            Fail(netErr("connect"))
        } else {
            Pass(Void)
        }
    }

    ## One recv chunk; empty Bytes when peer closed, on error, or at `deadline`.
    ## Prefer `receiveRequest` for HTTP (reads until header terminator).
    export fn receive(deadline: Int64 = 0) -> Bytes {
        let buf = Bytes(recvBufSize)
        let n = sysRecv(fd, buf, recvBufSize, 0, deadline)
        if n <= 0 {
            Bytes(0)
        } else {
            buf.slice(0, n)
        }
    }

    ## Read until `\r\n\r\n` (complete header block) or peer close / size cap.
    ## `buffered` is what was already read from this socket (on a kept-alive
    ## connection, the bytes after the last request); it comes first, and a
    ## header block complete in it returns without a recv.
    ## Empty Pass means the peer closed, or `deadline` passed, before sending
    ## anything; a deadline mid-headers is `Fail("request timed out")`.
    ## The result can run past the header block, into a body or the next
    ## request; it does not wait for either.
    export fn receiveRequest(deadline: Int64 = 0, buffered: Bytes = Bytes(0)) -> Trial<Bytes, String> {
        mut acc = Buffer()
        acc.appendBytes(buffered)
        let sep = Bytes.fromString("\r\n\r\n")
        loop {
            let soFar = acc.freeze()
            let complete = match soFar.find(sep) {
                Has(_) { true }
                Not { false }
            }
            if complete {
                return Pass(soFar)
            }
            if soFar.count >= maxRequestHeaders {
                return Fail("request headers too large")
            }
            let room = maxRequestHeaders - soFar.count
            let want = if room < recvBufSize {
                room
            } else {
                recvBufSize
            }
            if want <= 0 {
                return Fail("request headers too large")
            }
            let chunk = Bytes(want)
            let n = sysRecv(fd, chunk, want, 0, deadline)
            if n < 0 {
                if sysErrno() == errTimedOut {
                    if soFar.count == 0 {
                        return Pass(Bytes(0))
                    }
                    return Fail("request timed out")
                }
                return Fail(netErr("recv"))
            }
            if n == 0 {
                if soFar.count == 0 {
                    return Pass(Bytes(0))
                } else {
                    return Fail("incomplete request: peer closed")
                }
            }
            acc.appendBytes(chunk.slice(0, n))
        }
        ## Unreachable; loop always returns.
        Fail("receiveRequest: internal")
    }

    ## One send syscall; may write only part of `data`. Prefer `sendAll`.
    export fn send(data!: Bytes) -> Int64 {
        sysSend(fd, data, data.count, 0, 0)
    }

    ## Write all of `data`, looping on partial sends, until `deadline`.
    export fn sendAll(data!: Bytes, deadline: Int64 = 0) -> Trial<Int64, String> {
        mut sent = 0
        let total = data.count
        loop {
            if sent >= total {
                return Pass(total)
            }
            let remaining = data.slice(sent, total)
            let n = sysSend(fd, remaining, remaining.count, 0, deadline)
            if n < 0 {
                return Fail(netErr("send"))
            }
            if n == 0 {
                return Fail("send: peer closed")
            }
            sent = sent + n
        }
        ## Unreachable.
        Fail("sendAll: internal")
    }

    ## Close the fd once; subsequent closes are no-ops. Uses field write-back.
    export fn close() {
        if fd >= 0 {
            sysClose(fd)
            fd = -1
        }
    }
}

## The last copy closes the socket if the caller did not (D155).
conform Socket to Resource {
    fn drop() {
        close()
    }
}

export fn createSocket() -> Trial<Socket, String> {
    let fd = sysSocket(afInet, sockStream, ipProtoIp)
    if fd < 0 {
        Fail(netErr("socket"))
    } else {
        Pass(Socket(fd))
    }
}
