## std/logging — default process logger (D125).
## Prefer apps:
##   import logging from "std/logging"
##   import { info, warn, error } from "std/logging"
## Namespace for configure (toStdout/setLevel/…); selective names for short emits.
## Multi named loggers (`initLog`) are later; free functions target the default.

import { Pass, Fail, Trial } from "std/fallible"
import { getenv, localHms } from "./env"

extern fn sysWriteLineFd(fd!: Int32, s!: String) -> Int32 from "c" "thoxa_write_line_fd"
extern fn sysOpenMode(path!: String, flags!: Int32, mode!: Int32) -> Int32 from "c" "open"
extern fn sysClose(fd!: Int32) -> Int32 from "c" "close"
extern fn sysStrerror(errnum!: Int32) -> String from "c" "strerror"
extern fn sysErrno() -> Int32 from "c" "thoxa_errno"

## Levels (ordered).
export let levelTrace = 0
export let levelDebug = 1
export let levelInfo = 2
export let levelWarn = 3
export let levelError = 4

## Line format modes.
export let formatFull = 0
export let formatPlain = 1

## Linux open(2) bits for append log files.
let oWronly = 1
let oCreat = 64
let oAppend = 1024
let oMode644 = 420

## Widen open(2) Int32 fd → Int64 (same pattern as File ctor / D21).
type LogFd(n!: Int64)

## Default logger state (module mut → later Logger fields).
mut minLevel = 2
mut formatMode = 0
## 1=stdout, 2=stderr, or an open file descriptor.
mut sinkFd = 2
mut sinkPath = "stderr"
mut ownFd = false
mut bootstrapped = false

fn closeOwnedFd() -> Void {
    if ownFd {
        if sinkFd >= 0 {
            sysClose(sinkFd)
        }
        ownFd = false
    }
}

fn setSinkFdFromOpen(raw!: Int32) -> Void {
    let w = LogFd(raw)
    sinkFd = w.n
}

fn ensureBootstrapped() -> Void {
    if not bootstrapped {
        bootstrapped = true
        let lv = getenv("THOXA_LOG_LEVEL")
        if lv != "" {
            minLevel = parseLevel(lv)
        }
        let sk = getenv("THOXA_LOG_SINK")
        if sk != "" {
            ## Fail leaves prior sink (still stderr on first use).
            match setSink(sk) {
                Pass(_) { }
                Fail(_) { }
            }
        }
    }
}

export fn levelName(level!: Int64) -> String {
    if level <= levelTrace {
        "TRACE"
    } else {
        if level == levelDebug {
            "DEBUG"
        } else {
            if level == levelInfo {
                "INFO "
            } else {
                if level == levelWarn {
                    "WARN "
                } else {
                    "ERROR"
                }
            }
        }
    }
}

export fn parseLevel(s!: String) -> Int64 {
    let t = s.toLower()
    if t == "trace" {
        levelTrace
    } else {
        if t == "debug" {
            levelDebug
        } else {
            if t == "info" {
                levelInfo
            } else {
                if t == "warn" {
                    levelWarn
                } else {
                    if t == "warning" {
                        levelWarn
                    } else {
                        if t == "error" {
                            levelError
                        } else {
                            levelInfo
                        }
                    }
                }
            }
        }
    }
}

export fn setLevel(level!: Int64) -> Void {
    ensureBootstrapped()
    minLevel = level
}

export fn getLevel() -> Int64 {
    ensureBootstrapped()
    minLevel
}

export fn setFormat(mode!: Int64) -> Void {
    ensureBootstrapped()
    formatMode = mode
}

export fn getFormat() -> Int64 {
    ensureBootstrapped()
    formatMode
}

export fn getSink() -> String {
    ensureBootstrapped()
    sinkPath
}

export fn toStderr() -> Void {
    ensureBootstrapped()
    closeOwnedFd()
    sinkFd = 2
    sinkPath = "stderr"
    ownFd = false
}

export fn toStdout() -> Void {
    ensureBootstrapped()
    closeOwnedFd()
    sinkFd = 1
    sinkPath = "stdout"
    ownFd = false
}

export fn toFile(path!: String) -> Trial<Void, String> {
    ensureBootstrapped()
    let flags = oWronly + oCreat + oAppend
    let fd = sysOpenMode(path, flags, oMode644)
    if fd < 0 {
        Fail("open {path}: {sysStrerror(sysErrno())}")
    } else {
        closeOwnedFd()
        setSinkFdFromOpen(fd)
        sinkPath = path
        ownFd = true
        Pass(Void)
    }
}

export fn setSink(target!: String) -> Trial<Void, String> {
    ensureBootstrapped()
    if target == "stderr" {
        toStderr()
        Pass(Void)
    } else {
        if target == "stdout" {
            toStdout()
            Pass(Void)
        } else {
            toFile(target)
        }
    }
}

export fn emit(level!: Int64, msg!: String) -> Void {
    ensureBootstrapped()
    if level >= minLevel {
        if formatMode == formatPlain {
            sysWriteLineFd(sinkFd, msg)
        } else {
            let line = "{localHms()} {levelName(level)} {msg}"
            sysWriteLineFd(sinkFd, line)
        }
    }
}

export fn trace(msg!: String) -> Void {
    emit(levelTrace, msg)
}

export fn debug(msg!: String) -> Void {
    emit(levelDebug, msg)
}

export fn info(msg!: String) -> Void {
    emit(levelInfo, msg)
}

export fn warn(msg!: String) -> Void {
    emit(levelWarn, msg)
}

export fn error(msg!: String) -> Void {
    emit(levelError, msg)
}
