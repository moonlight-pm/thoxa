## Named parameters with defaults (SPEC §4.1 / M3 + D106 method/ctor).
import logging from "std/logging"
fn greet(name: String, greeting: String = "Hello") -> String {
    "{greeting}, {name}"
}

type Box(label: String, n: Int64 = 0) {
    export fn describe(prefix: String = "box") -> String {
        "{prefix}:{label}:{n}"
    }

    export fn bump(by: Int64 = 1) -> Int64 {
        n + by
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info(greet(name: "Ada"))
    logging.info(greet(name: "Bo", greeting: "Hi"))
    let a = Box(label: "x")
    logging.info("{a.describe()}")
    logging.info(a.describe(prefix: "item"))
    logging.info("{a.bump()}")
    logging.info("{a.bump(by: 10)}")
    let b = Box(label: "y", n: 7)
    logging.info("{b.describe()}")
    0
}
