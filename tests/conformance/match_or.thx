## Value-match or-patterns (D108): `0 | 1 { … }` + required else.
import logging from "std/logging"
fn size(n!: Int64) -> String {
    match n {
        0 | 1 { "tiny" }
        2 | 3 | 4 { "small" }
        else { "big" }
    }
}

fn cmd(s!: String) -> Int64 {
    match s {
        "exit" | "quit" { 0 }
        "help" | "?" { 1 }
        else { 9 }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{size(0)}")
    logging.info("{size(1)}")
    logging.info("{size(3)}")
    logging.info("{size(99)}")
    let c0 = cmd("exit")
    let c1 = cmd("quit")
    let c2 = cmd("help")
    let c3 = cmd("?")
    let c4 = cmd("run")
    logging.info("{c0}")
    logging.info("{c1}")
    logging.info("{c2}")
    logging.info("{c3}")
    logging.info("{c4}")
    0
}
