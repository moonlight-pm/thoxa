## D219: arithmetic on a UInt64 stays in UInt64, over its whole range: `+`
## `-` `*` wrap modulo 2^64 (as Int64 wraps, D157), `/` `%` divide unsigned,
## comparisons are unsigned, shifts are logical. The other operand may be a
## UInt64, a UInt32 or Byte, or a non-negative literal.
import logging, { info } from "std/logging"

fn largest() -> UInt64 {
    UInt64(truncating: 0 - 1)
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    let max = largest()
    let half = max / 2
    info("{max} {half} {half + 1} {max - half}")
    info("{max > half} {half < max} {max == max} {max >= 0} {max != 0}")
    info("wraps {max + 1} {0 - max} {half * 3}")
    let small: UInt32 = 7
    let byte: Byte = 255
    info("{half + small} {half + byte} {max % 10} {max / 1000000007}")
    info("{max >> 60} {(half + 1) << 1} {max & 0xFF} {~max}")
    mut total: UInt64 = 0
    for step in 0..3 {
        total = total + half
    }
    info("total {total}")
    0
}
