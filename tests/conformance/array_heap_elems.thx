## Array<String> / Array<Bytes> HEAP_ELEMS regression after D65 layout (data[] + elem_size).
import logging from "std/logging"
fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    ## String arrays: empty + append + index get/set + for-in + dropLast + display
    mut ss: Array<String> = []
    logging.info("s_empty={ss.count}")
    ss.append("a")
    ss.append("b")
    ss.append("c")
    logging.info("s_count={ss.count} s0={ss[0]} s2={ss[2]}")
    logging.info("s_disp={ss}")
    ss[1] = "B"
    logging.info("s_mut={ss}")
    mut n = 0
    for s in ss {
        n = n + 1
        logging.info("s_iter={s}")
    }
    logging.info("s_iters={n}")
    mut sd = ss
    sd.dropLast()
    logging.info("s_drop={sd}")
    logging.info("s_orig={ss.count}")

    ## Bytes arrays: append + get + for-in + dropLast
    mut bb: Array<Bytes> = []
    bb.append(Bytes.fromString("xy"))
    bb.append(Bytes.fromString("z"))
    logging.info("b_count={bb.count} b0len={bb[0].count} b1={bb[1].toString()}")
    mut blen = 0
    for b in bb {
        blen = blen + b.count
    }
    logging.info("b_sum_len={blen}")
    mut bd = bb
    bd.dropLast()
    logging.info("b_drop_count={bd.count}")
    0
}
