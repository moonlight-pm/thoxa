## Array<String> / Array<Bytes> HEAP_ELEMS regression after D65 layout (data[] + elem_size).
fn main() -> Int64 {
    ## String arrays: empty + append + index get/set + for-in + dropLast + display
    mut ss: Array<String> = []
    println("s_empty={ss.count}")
    ss = ss.append("a")
    ss = ss.append("b")
    ss = ss.append("c")
    println("s_count={ss.count} s0={ss[0]} s2={ss[2]}")
    println("s_disp={ss}")
    ss[1] = "B"
    println("s_mut={ss}")
    mut n = 0
    for s in ss {
        n = n + 1
        println("s_iter={s}")
    }
    println("s_iters={n}")
    let sd = ss.dropLast()
    println("s_drop={sd}")
    println("s_orig={ss.count}")

    ## Bytes arrays: append + get + for-in + dropLast
    mut bb: Array<Bytes> = []
    bb = bb.append(Bytes.fromString("xy"))
    bb = bb.append(Bytes.fromString("z"))
    println("b_count={bb.count} b0len={bb[0].count} b1={bb[1].toString()}")
    mut blen = 0
    for b in bb {
        blen = blen + b.count
    }
    println("b_sum_len={blen}")
    let bd = bb.dropLast()
    println("b_drop_count={bd.count}")
    0
}
