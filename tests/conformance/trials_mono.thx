## Trial monomorphs: Void/String and User/String (post-R9).

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

type Box(n: Int64)

fn asVoid(ok!: Bool) -> Trial<Void, String> {
    if ok {
        Pass(Void)
    } else {
        Fail("nope")
    }
}

fn asBox(n!: Int64) -> Trial<Box, String> {
    if n < 0 {
        Fail("negative")
    } else {
        Pass(Box(n: n))
    }
}

fn chain(n!: Int64) -> Trial<Box, String> {
    asVoid(true)?
    let b = asBox(n)?
    Pass(b)
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match asVoid(true) {
        Pass(u) { logging.info("void-ok") }
        Fail(e) { logging.info("{e}") }
    }
    match asVoid(false) {
        Pass(u) { logging.info("void-pass?") }
        Fail(e) { logging.info("{e}") }
    }
    match asBox(7) {
        Pass(b) { logging.info("{b.n}") }
        Fail(e) { logging.info("{e}") }
    }
    match chain(-1) {
        Pass(b) { logging.info("{b.n}") }
        Fail(e) { logging.info("{e}") }
    }
    match chain(3) {
        Pass(b) { logging.info("{b.n}") }
        Fail(e) { logging.info("{e}") }
    }
    0
}
