## Union-match guards (D120): `Ctor if cond` / `Ctor(x) if cond`.
import logging from "std/Logging"
type Zero
type Pos(n: Int64)
type Neg(n: Int64)
type Sign = Zero | Pos | Neg

fn label(s!: Sign) -> String {
    match s {
        Zero { "zero" }
        Pos(n) if n > 10 { "big-pos" }
        Pos(n) if n > 0 { "pos" }
        Pos(_) { "pos-other" }
        Neg(n) if n < 0 { "neg" }
        else { "??" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{label(Zero())}")
    logging.info("{label(Pos(n: 3))}")
    logging.info("{label(Pos(n: 20))}")
    logging.info("{label(Neg(n: 0 - 4))}")
    ## Guard fail falls through to later arm / else.
    let z: Sign = Pos(n: 0)
    match z {
        Pos(n) if n > 0 { logging.info("skip") }
        else { logging.info("else-ok") }
    }
    0
}
