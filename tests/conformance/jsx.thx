## Builtin Node + tag literals (JSX experiment). No import.
import logging from "std/Logging"

type Card(title: String) {
    export fn view(children: Array<Node>) -> Node {
        <section class="card">
            <h1>{title}</h1>
            {children}
        </section>
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let name = "Ada & Co"
    let n = <Card title="Hi">
        <p>Hello, {name}</p>
        <>
            <br />
            <input disabled />
        </>
        {if name.count == 0 { <></> } else { <em>ok</em> }}
    </Card>
    let gap = <div class="gap">{<></>}</div>
    let drinks = 6
    let count = <p>{drinks} drinks</p>
    ## `<` after another expr is a tag when glued (`<p>`), comparison when spaced (`< 10`).
    let tail = if drinks < 10 {
        1
        <p>under ten</p>
    } else {
        <p>ten or more</p>
    }
    logging.info(n.html())
    logging.info(gap.html())
    logging.info(count.html())
    logging.info(tail.html())
    0
}
