## Builtin Node + tag literals (JSX experiment). No import.
import logging from "std/logging"

type Card(title: String) {
    export fn view(children: Array<Node>) -> Node {
        <section class="card">
            <h1>{title}</h1>
            {children}
        </section>
    }
}

fn kindName(n: Node) -> String {
    match n {
        Element(tag, attrs, kids) => {
            let _ = attrs
            let _ = kids
            "el:{tag}"
        }
        Text(s) => "text:{s}"
        Fragment(kids) => "frag:{kids.count}"
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let name = "Ada & Co"
    let n = <Card title="Hi">
        <p>Hello, {name}</p>
        <>
            <br />
            <input disabled />
        </>
        {if name.count == 0 { <></> } else { <em>ok</em> }}
    </Card>
    let gap = <div class="gap">{<></>}</div>
    let drinks = 6
    let count = <p>{drinks} drinks</p>
    let flagged = true
    let attrs = <input data-n={drinks} data-ok={flagged} value={name} />
    ## `<` after another expr is a tag when glued (`<p>`), comparison when spaced (`< 10`).
    let tail = if drinks < 10 {
        1
        <p>under ten</p>
    } else {
        <p>ten or more</p>
    }
    logging.info(n.html())
    logging.info(gap.html())
    logging.info(count.html())
    logging.info(tail.html())
    logging.info(attrs.html())

    let extra = [Attr(name: "id", value: "x"), Attr(name: "data-k", value: "v")]
    let spread = <div class="box" {...extra}>z</div>
    logging.info(spread.html())

    let card = Card(title: "Hi")
    let fromSpread = <Card {...card}><em>via</em></Card>
    logging.info(fromSpread.html())

    let built = Element(tag: "span", attrs: [Attr(name: "class", value: "t")], kids: [Text(s: "go")])
    logging.info(built.html())
    logging.info(kindName(<p>Hi</p>))
    logging.info(kindName(Text(s: "a")))
    logging.info(kindName(Fragment(kids: [<b>1</b>])))

    ## `#` is a comment. `\#` is a literal hash in JSX text.
    let number = 3
    let hashed = <h1>Ticket \#{number}</h1>
    logging.info(hashed.html())
    let cafe = <p>c\#aff</p>
    logging.info(cafe.html())
    0
}
