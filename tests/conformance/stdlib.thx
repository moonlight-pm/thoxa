## std/ named root (D97) — Str + Path + Ansi smoke.
import { startsWith, endsWith, isEmpty, length, repeat, contains, count, indexOf, lastIndexOf, substring, replaceFirst, replaceAll, equalsIgnoreCaseAscii, split, join as strJoin, dropPrefix, dropSuffix, removePrefix, removeSuffix, trimNewline, trim, trimStart, trimEnd, toLowerAscii, toUpperAscii, padLeft, padRight, byteAt, lines, startsWithIgnoreCaseAscii, endsWithIgnoreCaseAscii, containsIgnoreCaseAscii, truncate, reverse, isAscii } from "std/Str"
import { dirname, parent, basename, fileName, join, joinAll, isAbsolute, isRelative, normalize, extension, hasExtension, stem, withExtension, withFileName, parts, stripTrailingSlash, ensureTrailingSlash, shortPath } from "std/Path"
import { hasEnv, getenvOr, home, tmpdir, shell, pathVar, pwd } from "std/Env"
import { branchName, branchSuffix, isRepo, repoRoot, isDetached, headLine } from "std/Git"
import { fg, fgHex, sgr0, cyan, brightWhite, parseRgba } from "std/Ansi"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"

fn main() -> Int64 {
    if startsWith("hello", "he") {
        println("starts-ok")
    } else {
        println("starts-bad")
    }
    if endsWith("hello", "lo") {
        println("ends-ok")
    } else {
        println("ends-bad")
    }
    if isEmpty("") {
        println("empty-ok")
    } else {
        println("empty-bad")
    }
    println(repeat("ab", 3))
    println(repeat("x", 0))
    if contains("hello", "ell") {
        println("contains-ok")
    } else {
        println("contains-bad")
    }
    if contains("hello", "xyz") {
        println("contains-miss-bad")
    } else {
        println("contains-miss-ok")
    }
    println("idx={indexOf(\"hello\", \"ll\")}")
    println("idx-miss={indexOf(\"hello\", \"zz\")}")
    println("last={lastIndexOf(\"ababa\", \"ab\")}")
    println("cnt={count(\"ababab\", \"ab\")}")
    println("len={length(\"hi\")}")
    println(substring("hello", 1, 4))
    println(replaceFirst("aa-aa", "aa", "b"))
    println(replaceAll("aa-aa", "aa", "b"))
    if equalsIgnoreCaseAscii("AbC", "aBc") {
        println("eq-ic-ok")
    } else {
        println("eq-ic-bad")
    }
    let parts = split("a,b,c", ",")
    println("split={parts.count}:{parts[0]}:{parts[2]}")
    println(padLeft("7", 3, "0"))
    println(padRight("x", 3, "."))
    println(dropPrefix("hello", "he"))
    println(dropSuffix("hello", "lo"))
    println(trimNewline("line\n"))
    println(trim("  hi\t\n"))
    println(trimStart("  hi"))
    println(trimEnd("hi  "))
    println("byte={byteAt(\"ABC\", 1)}")
    println("byte-oob={byteAt(\"A\", 3)}")
    let ls = lines("a\nb\r\nc")
    println("lines={ls.count}:{ls[0]}:{ls[1]}:{ls[2]}")
    println(strJoin(["x", "y", "z"], "-"))
    if startsWithIgnoreCaseAscii("Hello", "he") {
        println("sw-ic-ok")
    } else {
        println("sw-ic-bad")
    }
    if endsWithIgnoreCaseAscii("Hello", "LO") {
        println("ew-ic-ok")
    } else {
        println("ew-ic-bad")
    }
    if containsIgnoreCaseAscii("AbCd", "bc") {
        println("ci-ok")
    } else {
        println("ci-bad")
    }
    println(removePrefix("hello", "he"))
    println(removePrefix("hello", "x"))
    println(removeSuffix("hello", "lo"))
    println(removeSuffix("hello", "x"))
    println(truncate("abcdef", 3))
    println(truncate("ab", 10))
    println(reverse("abc"))
    if isAscii("hi") {
        println("ascii-ok")
    } else {
        println("ascii-bad")
    }
    println(toLowerAscii("AbC"))
    println(toUpperAscii("AbC"))
    println(dirname("/a/b/c"))
    println(parent("/a/b/c"))
    println(basename("/a/b/c"))
    println(fileName("/a/b/c"))
    println(join("/a/b", "c"))
    println(join("/a/b/", "c"))
    println(join("/a", "/abs"))
    println(withFileName("/a/b/c.thx", "d.md"))
    let pp = parts("/a/b")
    println("parts={pp.count}:{pp[0]}:{pp[1]}:{pp[2]}")
    println(stripTrailingSlash("/a/b/"))
    println(stripTrailingSlash("/"))
    println(ensureTrailingSlash("/a/b"))
    println(joinAll(["/a", "b", "c"]))
    if isAbsolute("/a") {
        println("abs-ok")
    } else {
        println("abs-bad")
    }
    if isAbsolute("rel") {
        println("rel-bad")
    } else {
        println("rel-ok")
    }
    println(normalize("/a//b///c"))
    println(normalize("x//y"))
    println(extension("a/b/foo.thx"))
    println(extension("Makefile"))
    if hasExtension("a/b/foo.thx") {
        println("has-ext-ok")
    } else {
        println("has-ext-bad")
    }
    if hasExtension("Makefile") {
        println("has-ext-miss-bad")
    } else {
        println("has-ext-miss-ok")
    }
    println(stem("a/b/foo.thx"))
    println(stem(".git"))
    println(withExtension("a/b/foo.thx", "md"))
    println(withExtension("plain", "thx"))
    if isRelative("rel/x") {
        println("relative-ok")
    } else {
        println("relative-bad")
    }
    if isRelative("/abs") {
        println("relative-abs-bad")
    } else {
        println("relative-abs-ok")
    }
    println(shortPath("/tmp/foo/bar"))
    ## PATH is always set in the conformance environment.
    if hasEnv("PATH") {
        println("path-env-ok")
    } else {
        println("path-env-bad")
    }
    if pathVar() == "" {
        println("pathvar-empty")
    } else {
        println("pathvar-ok")
    }
    ## pwd may fail in weird sandboxes; treat empty as call-ok only when non-empty fails.
    let p = pwd()
    if length(p) < 0 {
        println("pwd-bad")
    } else {
        println("pwd-call-ok")
    }
    if hasEnv("THOXA_NO_SUCH_ENV_VAR_ZZZ") {
        println("missing-env-bad")
    } else {
        println("missing-env-ok")
    }
    println(getenvOr("THOXA_NO_SUCH_ENV_VAR_ZZZ", "fallback"))
    ## home() is getenv("HOME"); non-empty in normal developer environments.
    if home() == "" {
        println("home-empty")
    } else {
        println("home-ok")
    }
    ## tmpdir is non-empty (TMPDIR or /tmp).
    if tmpdir() == "" {
        println("tmpdir-bad")
    } else {
        println("tmpdir-ok")
    }
    ## Deterministic Git helpers (no real repo required).
    if branchName("") == "" {
        println("git-empty-ok")
    } else {
        println("git-empty-bad")
    }
    if branchName("/no/such/thoxa/repo/zzzz") == "" {
        println("git-miss-ok")
    } else {
        println("git-miss-bad")
    }
    if branchSuffix("/no/such/thoxa/repo/zzzz") == "" {
        println("git-suf-ok")
    } else {
        println("git-suf-bad")
    }
    if isRepo("/no/such/thoxa/repo/zzzz") {
        println("git-repo-bad")
    } else {
        println("git-repo-ok")
    }
    if repoRoot("/no/such/thoxa/repo/zzzz") == "" {
        println("git-root-ok")
    } else {
        println("git-root-bad")
    }
    if isDetached("/no/such/thoxa/repo/zzzz") {
        println("git-det-bad")
    } else {
        println("git-det-ok")
    }
    if headLine("/no/such/thoxa/repo/zzzz") == "" {
        println("git-head-ok")
    } else {
        println("git-head-bad")
    }
    ## shell() is getenv("SHELL"); value may be empty — just prove the call.
    let sh = shell()
    if length(sh) < 0 {
        println("shell-bad")
    } else {
        println("shell-call-ok")
    }
    ## fg/sgr0 must be non-empty SGR sequences (byte 27 present via length).
    let c = fg(1, 2, 3)
    let r = sgr0()
    if c == "" {
        println("fg-empty")
    } else {
        println("fg-ok")
    }
    if r == "" {
        println("sgr0-empty")
    } else {
        println("sgr0-ok")
    }
    ## Named ANSI colors are prebuilt fg sequences (non-empty).
    if cyan == "" {
        println("cyan-empty")
    } else {
        println("cyan-ok")
    }
    if brightWhite == "" {
        println("brightWhite-empty")
    } else {
        println("brightWhite-ok")
    }
    ## Hex parse: 6-digit RGB (no alpha → a=255) and 8-digit RGBA.
    match parseRgba("#3B9DC2") {
        Has(c) {
            println("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            println("parse-fail")
        }
    }
    match parseRgba("#3B9DC2FF") {
        Has(c) {
            println("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            println("parse8-fail")
        }
    }
    match parseRgba("FF0000") {
        Has(c) {
            println("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            println("parse6-fail")
        }
    }
    match parseRgba("nope") {
        Has(_) {
            println("bad-ok")
        }
        Not {
            println("bad-not")
        }
    }
    let hx = fgHex("#3B9DC2")
    if hx == "" {
        println("fgHex-empty")
    } else {
        println("fgHex-ok")
    }
    0
}
