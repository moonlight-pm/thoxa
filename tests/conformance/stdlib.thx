## std/ named root (D97) — Str + Path + Ansi smoke.
import { startsWith, endsWith, isEmpty, length, repeat, contains, count, indexOf, lastIndexOf, substring, replaceFirst, replaceAll, equalsIgnoreCaseAscii, split, join as strJoin, dropPrefix, dropSuffix, removePrefix, removeSuffix, trimNewline, trim, trimStart, trimEnd, toLowerAscii, toUpperAscii, padLeft, padRight, byteAt, lines, startsWithIgnoreCaseAscii, endsWithIgnoreCaseAscii, containsIgnoreCaseAscii, truncate, reverse, isAscii } from "std/Str"
import { dirname, parent, basename, fileName, join, joinAll, isAbsolute, isRelative, normalize, extension, hasExtension, stem, withExtension, withFileName, parts, stripTrailingSlash, ensureTrailingSlash, shortPath } from "std/Path"
import { hasEnv, getenvOr, home, tmpdir, shell, pathVar, pwd } from "std/Env"
import { branchName, branchSuffix, isRepo, repoRoot, isDetached, headLine } from "std/Git"
import { fg, fgHex, sgr0, cyan, brightWhite, parseRgba } from "std/Ansi"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import logging from "std/Logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    if startsWith("hello", "he") {
        logging.info("starts-ok")
    } else {
        logging.info("starts-bad")
    }
    if endsWith("hello", "lo") {
        logging.info("ends-ok")
    } else {
        logging.info("ends-bad")
    }
    if isEmpty("") {
        logging.info("empty-ok")
    } else {
        logging.info("empty-bad")
    }
    logging.info(repeat("ab", 3))
    logging.info(repeat("x", 0))
    if contains("hello", "ell") {
        logging.info("contains-ok")
    } else {
        logging.info("contains-bad")
    }
    if contains("hello", "xyz") {
        logging.info("contains-miss-bad")
    } else {
        logging.info("contains-miss-ok")
    }
    logging.info("idx={indexOf(\"hello\", \"ll\")}")
    logging.info("idx-miss={indexOf(\"hello\", \"zz\")}")
    logging.info("last={lastIndexOf(\"ababa\", \"ab\")}")
    logging.info("cnt={count(\"ababab\", \"ab\")}")
    logging.info("len={length(\"hi\")}")
    logging.info(substring("hello", 1, 4))
    logging.info(replaceFirst("aa-aa", "aa", "b"))
    logging.info(replaceAll("aa-aa", "aa", "b"))
    if equalsIgnoreCaseAscii("AbC", "aBc") {
        logging.info("eq-ic-ok")
    } else {
        logging.info("eq-ic-bad")
    }
    let parts = split("a,b,c", ",")
    logging.info("split={parts.count}:{parts[0]}:{parts[2]}")
    logging.info(padLeft("7", 3, "0"))
    logging.info(padRight("x", 3, "."))
    logging.info(dropPrefix("hello", "he"))
    logging.info(dropSuffix("hello", "lo"))
    logging.info(trimNewline("line\n"))
    logging.info(trim("  hi\t\n"))
    logging.info(trimStart("  hi"))
    logging.info(trimEnd("hi  "))
    logging.info("byte={byteAt(\"ABC\", 1)}")
    logging.info("byte-oob={byteAt(\"A\", 3)}")
    let ls = lines("a\nb\r\nc")
    logging.info("lines={ls.count}:{ls[0]}:{ls[1]}:{ls[2]}")
    logging.info(strJoin(["x", "y", "z"], "-"))
    if startsWithIgnoreCaseAscii("Hello", "he") {
        logging.info("sw-ic-ok")
    } else {
        logging.info("sw-ic-bad")
    }
    if endsWithIgnoreCaseAscii("Hello", "LO") {
        logging.info("ew-ic-ok")
    } else {
        logging.info("ew-ic-bad")
    }
    if containsIgnoreCaseAscii("AbCd", "bc") {
        logging.info("ci-ok")
    } else {
        logging.info("ci-bad")
    }
    logging.info(removePrefix("hello", "he"))
    logging.info(removePrefix("hello", "x"))
    logging.info(removeSuffix("hello", "lo"))
    logging.info(removeSuffix("hello", "x"))
    logging.info(truncate("abcdef", 3))
    logging.info(truncate("ab", 10))
    logging.info(reverse("abc"))
    if isAscii("hi") {
        logging.info("ascii-ok")
    } else {
        logging.info("ascii-bad")
    }
    logging.info(toLowerAscii("AbC"))
    logging.info(toUpperAscii("AbC"))
    logging.info(dirname("/a/b/c"))
    logging.info(parent("/a/b/c"))
    logging.info(basename("/a/b/c"))
    logging.info(fileName("/a/b/c"))
    logging.info(join("/a/b", "c"))
    logging.info(join("/a/b/", "c"))
    logging.info(join("/a", "/abs"))
    logging.info(withFileName("/a/b/c.thx", "d.md"))
    let pp = parts("/a/b")
    logging.info("parts={pp.count}:{pp[0]}:{pp[1]}:{pp[2]}")
    logging.info(stripTrailingSlash("/a/b/"))
    logging.info(stripTrailingSlash("/"))
    logging.info(ensureTrailingSlash("/a/b"))
    logging.info(joinAll(["/a", "b", "c"]))
    if isAbsolute("/a") {
        logging.info("abs-ok")
    } else {
        logging.info("abs-bad")
    }
    if isAbsolute("rel") {
        logging.info("rel-bad")
    } else {
        logging.info("rel-ok")
    }
    logging.info(normalize("/a//b///c"))
    logging.info(normalize("x//y"))
    logging.info(extension("a/b/foo.thx"))
    logging.info(extension("Makefile"))
    if hasExtension("a/b/foo.thx") {
        logging.info("has-ext-ok")
    } else {
        logging.info("has-ext-bad")
    }
    if hasExtension("Makefile") {
        logging.info("has-ext-miss-bad")
    } else {
        logging.info("has-ext-miss-ok")
    }
    logging.info(stem("a/b/foo.thx"))
    logging.info(stem(".git"))
    logging.info(withExtension("a/b/foo.thx", "md"))
    logging.info(withExtension("plain", "thx"))
    if isRelative("rel/x") {
        logging.info("relative-ok")
    } else {
        logging.info("relative-bad")
    }
    if isRelative("/abs") {
        logging.info("relative-abs-bad")
    } else {
        logging.info("relative-abs-ok")
    }
    logging.info(shortPath("/tmp/foo/bar"))
    ## PATH is always set in the conformance environment.
    if hasEnv("PATH") {
        logging.info("path-env-ok")
    } else {
        logging.info("path-env-bad")
    }
    if pathVar() == "" {
        logging.info("pathvar-empty")
    } else {
        logging.info("pathvar-ok")
    }
    ## pwd may fail in weird sandboxes; treat empty as call-ok only when non-empty fails.
    let p = pwd()
    if length(p) < 0 {
        logging.info("pwd-bad")
    } else {
        logging.info("pwd-call-ok")
    }
    if hasEnv("THOXA_NO_SUCH_ENV_VAR_ZZZ") {
        logging.info("missing-env-bad")
    } else {
        logging.info("missing-env-ok")
    }
    logging.info(getenvOr("THOXA_NO_SUCH_ENV_VAR_ZZZ", "fallback"))
    ## home() is getenv("HOME"); non-empty in normal developer environments.
    if home() == "" {
        logging.info("home-empty")
    } else {
        logging.info("home-ok")
    }
    ## tmpdir is non-empty (TMPDIR or /tmp).
    if tmpdir() == "" {
        logging.info("tmpdir-bad")
    } else {
        logging.info("tmpdir-ok")
    }
    ## Deterministic Git helpers (no real repo required).
    if branchName("") == "" {
        logging.info("git-empty-ok")
    } else {
        logging.info("git-empty-bad")
    }
    if branchName("/no/such/thoxa/repo/zzzz") == "" {
        logging.info("git-miss-ok")
    } else {
        logging.info("git-miss-bad")
    }
    if branchSuffix("/no/such/thoxa/repo/zzzz") == "" {
        logging.info("git-suf-ok")
    } else {
        logging.info("git-suf-bad")
    }
    if isRepo("/no/such/thoxa/repo/zzzz") {
        logging.info("git-repo-bad")
    } else {
        logging.info("git-repo-ok")
    }
    if repoRoot("/no/such/thoxa/repo/zzzz") == "" {
        logging.info("git-root-ok")
    } else {
        logging.info("git-root-bad")
    }
    if isDetached("/no/such/thoxa/repo/zzzz") {
        logging.info("git-det-bad")
    } else {
        logging.info("git-det-ok")
    }
    if headLine("/no/such/thoxa/repo/zzzz") == "" {
        logging.info("git-head-ok")
    } else {
        logging.info("git-head-bad")
    }
    ## shell() is getenv("SHELL"); value may be empty — just prove the call.
    let sh = shell()
    if length(sh) < 0 {
        logging.info("shell-bad")
    } else {
        logging.info("shell-call-ok")
    }
    ## fg/sgr0 must be non-empty SGR sequences (byte 27 present via length).
    let c = fg(1, 2, 3)
    let r = sgr0()
    if c == "" {
        logging.info("fg-empty")
    } else {
        logging.info("fg-ok")
    }
    if r == "" {
        logging.info("sgr0-empty")
    } else {
        logging.info("sgr0-ok")
    }
    ## Named ANSI colors are prebuilt fg sequences (non-empty).
    if cyan == "" {
        logging.info("cyan-empty")
    } else {
        logging.info("cyan-ok")
    }
    if brightWhite == "" {
        logging.info("brightWhite-empty")
    } else {
        logging.info("brightWhite-ok")
    }
    ## Hex parse: 6-digit RGB (no alpha → a=255) and 8-digit RGBA.
    match parseRgba("#3B9DC2") {
        Has(c) {
            logging.info("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            logging.info("parse-fail")
        }
    }
    match parseRgba("#3B9DC2FF") {
        Has(c) {
            logging.info("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            logging.info("parse8-fail")
        }
    }
    match parseRgba("FF0000") {
        Has(c) {
            logging.info("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            logging.info("parse6-fail")
        }
    }
    match parseRgba("nope") {
        Has(_) {
            logging.info("bad-ok")
        }
        Not {
            logging.info("bad-not")
        }
    }
    let hx = fgHex("#3B9DC2")
    if hx == "" {
        logging.info("fgHex-empty")
    } else {
        logging.info("fgHex-ok")
    }
    0
}
