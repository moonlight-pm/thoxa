## std/ named root (D97) — Str + Path + Ansi smoke.
import { startsWith, endsWith, isEmpty, repeat, contains, indexOf, dropPrefix, dropSuffix, trimNewline, trim, toLowerAscii, toUpperAscii } from "std/Str"
import { dirname, basename, join, isAbsolute, normalize, extension, stem, shortPath } from "std/Path"
import { hasEnv, getenvOr } from "std/Env"
import { branchName, branchSuffix } from "std/Git"
import { fg, fgHex, sgr0, cyan, brightWhite, parseRgba } from "std/Ansi"

fn main() -> Int64 {
    if startsWith("hello", "he") {
        println("starts-ok")
    } else {
        println("starts-bad")
    }
    if endsWith("hello", "lo") {
        println("ends-ok")
    } else {
        println("ends-bad")
    }
    if isEmpty("") {
        println("empty-ok")
    } else {
        println("empty-bad")
    }
    println(repeat("ab", 3))
    println(repeat("x", 0))
    if contains("hello", "ell") {
        println("contains-ok")
    } else {
        println("contains-bad")
    }
    if contains("hello", "xyz") {
        println("contains-miss-bad")
    } else {
        println("contains-miss-ok")
    }
    println("idx={indexOf(\"hello\", \"ll\")}")
    println("idx-miss={indexOf(\"hello\", \"zz\")}")
    println(dropPrefix("hello", "he"))
    println(dropSuffix("hello", "lo"))
    println(trimNewline("line\n"))
    println(trim("  hi\t\n"))
    println(toLowerAscii("AbC"))
    println(toUpperAscii("AbC"))
    println(dirname("/a/b/c"))
    println(basename("/a/b/c"))
    println(join("/a/b", "c"))
    println(join("/a/b/", "c"))
    println(join("/a", "/abs"))
    if isAbsolute("/a") {
        println("abs-ok")
    } else {
        println("abs-bad")
    }
    if isAbsolute("rel") {
        println("rel-bad")
    } else {
        println("rel-ok")
    }
    println(normalize("/a//b///c"))
    println(normalize("x//y"))
    println(extension("a/b/foo.thx"))
    println(extension("Makefile"))
    println(stem("a/b/foo.thx"))
    println(stem(".git"))
    println(shortPath("/tmp/foo/bar"))
    ## PATH is always set in the conformance environment.
    if hasEnv("PATH") {
        println("path-env-ok")
    } else {
        println("path-env-bad")
    }
    if hasEnv("THOXA_NO_SUCH_ENV_VAR_ZZZ") {
        println("missing-env-bad")
    } else {
        println("missing-env-ok")
    }
    println(getenvOr("THOXA_NO_SUCH_ENV_VAR_ZZZ", "fallback"))
    ## Deterministic Git helpers (no real repo required).
    if branchName("") == "" {
        println("git-empty-ok")
    } else {
        println("git-empty-bad")
    }
    if branchName("/no/such/thoxa/repo/zzzz") == "" {
        println("git-miss-ok")
    } else {
        println("git-miss-bad")
    }
    if branchSuffix("/no/such/thoxa/repo/zzzz") == "" {
        println("git-suf-ok")
    } else {
        println("git-suf-bad")
    }
    ## fg/sgr0 must be non-empty SGR sequences (byte 27 present via length).
    let c = fg(1, 2, 3)
    let r = sgr0()
    if c == "" {
        println("fg-empty")
    } else {
        println("fg-ok")
    }
    if r == "" {
        println("sgr0-empty")
    } else {
        println("sgr0-ok")
    }
    ## Named ANSI colors are prebuilt fg sequences (non-empty).
    if cyan == "" {
        println("cyan-empty")
    } else {
        println("cyan-ok")
    }
    if brightWhite == "" {
        println("brightWhite-empty")
    } else {
        println("brightWhite-ok")
    }
    ## Hex parse: 6-digit RGB (no alpha → a=255) and 8-digit RGBA.
    match parseRgba("#3B9DC2") {
        Has(c) {
            println("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            println("parse-fail")
        }
    }
    match parseRgba("#3B9DC2FF") {
        Has(c) {
            println("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            println("parse8-fail")
        }
    }
    match parseRgba("FF0000") {
        Has(c) {
            println("{c.r},{c.g},{c.b},{c.a}")
        }
        Not {
            println("parse6-fail")
        }
    }
    match parseRgba("nope") {
        Has(_) {
            println("bad-ok")
        }
        Not {
            println("bad-not")
        }
    }
    let hx = fgHex("#3B9DC2")
    if hx == "" {
        println("fgHex-empty")
    } else {
        println("fgHex-ok")
    }
    0
}
