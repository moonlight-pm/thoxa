## `-->` + real Net: accept/recv park; host connect/send unblocks them.
import net, { Socket, createSocket } from "std/net"
import { Pass, Fail, Trial } from "std/fallible"
import logging, { info } from "std/logging"

fn serve(listener!: Socket) -> Trial<Void, String> {
    let peer = listener.accept()?
    let data = peer.receive()
    info("got {data.toString()}")
    peer.close()
    Pass(Void)
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    match run() {
        Pass(_) { 0 }
        Fail(e) {
            info("fail {e}")
            1
        }
    }
}

fn run() -> Trial<Void, String> {
    let listener = createSocket()?
    listener.reuseAddr()?
    listener.bind(0)?
    listener.listen(4)?
    let port = listener.localPort()?
    --> serve(listener)
    let client = createSocket()?
    client.connect(port)?
    client.sendAll(Bytes.fromString("hi"))?
    client.close()
    Pass(Void)
}
