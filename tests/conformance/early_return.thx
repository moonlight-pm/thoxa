## Early `return` / `return expr` in nested if, for, while, loop, and match.
## Also: String params must not be dropped on early return / ? Fail (caller owns).

import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import logging from "std/Logging"

fn mid() -> Int64 {
    let a = 1
    if a == 1 {
        return 42
    }
    0
}

fn fromFor() -> Int64 {
    for i in 0..10 {
        if i == 3 {
            return i
        }
    }
    99
}

fn fromWhile() -> Int64 {
    mut n = 0
    while n < 10 {
        n = n + 1
        if n == 5 {
            return n
        }
    }
    99
}

fn fromLoop() -> Int64 {
    mut k = 0
    loop {
        k = k + 1
        if k >= 2 {
            return k
        }
    }
    99
}

fn fromMatch(t: Trial<Int64, Int64>) -> Int64 {
    match t {
        Pass(x) { return x }
        Fail(e) { e }
    }
}

fn nested() -> Int64 {
    for i in 1..=5 {
        if i % 2 == 0 {
            if i == 4 {
                return i
            }
        }
    }
    0
}

## Void early return (side effect then exit).
fn side() -> Void {
    logging.info("side")
    return
}

fn withHeap() -> Int64 {
    let s = "keep"
    logging.info("{s}")
    if true {
        let t = "drop-me"
        logging.info("{t}")
        return 7
    }
    0
}

## Param RC: callee must not drop String params (caller retains ownership).
fn take(s: String) -> Int64 {
    return 0
}

fn giveBack(s: String) -> String {
    return s
}

## Early return with a live local heap + String param (drop local, not param).
fn retWithLocal(s: String) -> String {
    let t = "local"
    logging.info("{t}")
    return s
}

## `?` Fail with a live String param — must not double-free the arg.
fn tryFail(s: String) -> Trial<Int64, String> {
    let t = Fail("boom")
    t?
    Pass(0)
}

type Box(n: Int64) {
    export fn early() -> Int64 {
        if n > 0 {
            return n
        }
        0
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{mid()}")
    logging.info("{fromFor()}")
    logging.info("{fromWhile()}")
    logging.info("{fromLoop()}")
    logging.info("{fromMatch(Pass(9))}")
    logging.info("{fromMatch(Fail(8))}")
    logging.info("{nested()}")
    side()
    logging.info("{withHeap()}")
    let b = Box(n: 11)
    logging.info("{b.early()}")

    ## caller still owns / can print after early-return callee
    let msg = "alive"
    logging.info("{take(msg)}")
    logging.info("{msg}")

    let back = giveBack("echo")
    logging.info("{back}")

    let again = retWithLocal("param")
    logging.info("{again}")

    match tryFail("param-live") {
        Pass(v) { logging.info("{v}") }
        Fail(e) { logging.info("{e}") }
    }

    0
}
