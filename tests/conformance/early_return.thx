## Early `return` / `return expr` in nested if, for, while, loop, and match.
## Also: String params must not be dropped on early return / ? Fail (caller owns).

import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"

fn mid() -> Int64 {
    let a = 1
    if a == 1 {
        return 42
    }
    0
}

fn fromFor() -> Int64 {
    for i in 0..10 {
        if i == 3 {
            return i
        }
    }
    99
}

fn fromWhile() -> Int64 {
    mut n = 0
    while n < 10 {
        n = n + 1
        if n == 5 {
            return n
        }
    }
    99
}

fn fromLoop() -> Int64 {
    mut k = 0
    loop {
        k = k + 1
        if k >= 2 {
            return k
        }
    }
    99
}

fn fromMatch(t: Trial<Int64, Int64>) -> Int64 {
    match t {
        Pass(x) { return x }
        Fail(e) { e }
    }
}

fn nested() -> Int64 {
    for i in 1..=5 {
        if i % 2 == 0 {
            if i == 4 {
                return i
            }
        }
    }
    0
}

## Void early return (side effect then exit).
fn side() -> Void {
    println("side")
    return
}

fn withHeap() -> Int64 {
    let s = "keep"
    println(s)
    if true {
        let t = "drop-me"
        println(t)
        return 7
    }
    0
}

## Param RC: callee must not drop String params (caller retains ownership).
fn take(s: String) -> Int64 {
    return 0
}

fn giveBack(s: String) -> String {
    return s
}

## Early return with a live local heap + String param (drop local, not param).
fn retWithLocal(s: String) -> String {
    let t = "local"
    println(t)
    return s
}

## `?` Fail with a live String param — must not double-free the arg.
fn tryFail(s: String) -> Trial<Int64, String> {
    let t = Fail("boom")
    t?
    Pass(0)
}

type Box(n: Int64) {
    export fn early() -> Int64 {
        if n > 0 {
            return n
        }
        0
    }
}

fn main() -> Int64 {
    println(mid())
    println(fromFor())
    println(fromWhile())
    println(fromLoop())
    println(fromMatch(Pass(9)))
    println(fromMatch(Fail(8)))
    println(nested())
    side()
    println(withHeap())
    let b = Box(n: 11)
    println(b.early())

    ## caller still owns / can print after early-return callee
    let msg = "alive"
    println(take(msg))
    println(msg)

    let back = giveBack("echo")
    println(back)

    let again = retWithLocal("param")
    println(again)

    match tryFail("param-live") {
        Pass(v) { println(v) }
        Fail(e) { println(e) }
    }

    0
}
