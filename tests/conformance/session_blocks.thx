## Top-level statements in a session script may span lines; a line that
## starts with a statement keyword is never a command (D188).
mut seen = 0
for value in [1, 2, 3] {
    seen = seen + value
}
if seen > 5 {
    shell = shell.run(["echo", "seen {seen}"])
}
while seen > 0 {
    seen = seen - 4
}
echo done
