## Cross-module parameter defaults (D116).
import { tag, add, Box } from "./Lib"
import logging from "std/Logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    ## Caller does not import defaultTag / defaultN.
    logging.info("{tag()}")
    logging.info(tag(prefix: "override"))
    logging.info("{add()}")
    logging.info("{add(n: 100)}")
    let b = Box()
    logging.info("{b.show()}")
    logging.info(b.show(suffix: "x"))
    let c = Box(label: "custom")
    logging.info("{c.show()}")
    0
}
