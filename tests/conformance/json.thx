## std/json — dynamic Json tree: decode / encode (D141).
import { Json, JNull, JBool, JInt, JFloat, JStr, JArr, JObj, decode, encode } from "std/json"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging, { info } from "std/logging"

fn show(t!: Trial<Json, String>) -> String {
    match t {
        Pass(v) => encode(v)
        Fail(e) => "ERR:{e}"
    }
}

fn kind(t!: Trial<Json, String>) -> String {
    match t {
        Fail(e) => "ERR:{e}"
        Pass(v) {
            match v {
                JNull => "null"
                JBool => "bool"
                JInt => "int"
                JFloat => "float"
                JStr => "str"
                JArr => "arr"
                JObj => "obj"
            }
        }
    }
}

fn qtyOf(t!: Trial<Json, String>) -> String {
    match t {
        Fail(e) => "ERR:{e}"
        Pass(v) {
            match v {
                JObj(m) {
                    let qty: May<Json> = m.get("qty")
                    match qty {
                        Not => "missing"
                        Has(q) {
                            match q {
                                JInt(n) => "int:{n}"
                                JFloat => "float"
                                JNull => "null"
                                JBool => "bool"
                                JStr => "str"
                                JArr => "arr"
                                JObj => "obj"
                            }
                        }
                    }
                }
                JNull => "not-obj"
                JBool => "not-obj"
                JInt => "not-obj"
                JFloat => "not-obj"
                JStr => "not-obj"
                JArr => "not-obj"
            }
        }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    info(show(decode("null")))
    info(show(decode("true")))
    info(show(decode("false")))
    info(show(decode("0")))
    info(show(decode("-2")))
    info(show(decode("42")))
    info(kind(decode("2")))
    info(kind(decode("2.0")))
    info(kind(decode("1e2")))
    info(show(decode("0.5")))
    info(show(decode("-1.5")))
    info(show(decode("1e2")))
    info(show(decode("1.5e-1")))
    info(show(decode("0.15")))
    info(show(decode("\"\"")))
    info(show(decode("\"hello\"")))
    info(show(decode("\"quote\\\"here\"")))
    info(show(decode("\"a\\nb\"")))
    info(show(decode("\"\\u0041\"")))
    info(show(decode("\"\\u00e9\"")))
    info(show(decode("\"\\uD83D\\uDE00\"")))
    info(show(decode("[]")))
    info(show(decode("[1,2,3]")))
    info(show(decode("[null,true,\"x\"]")))
    info(show(decode("{{}}")))
    info(show(decode("{{\"a\":1}}")))
    info(show(decode("{{\"qty\":2,\"name\":\"mocha\"}}")))
    info(qtyOf(decode("{{\"qty\":2,\"name\":\"mocha\"}}")))
    info(show(decode("{{\"items\":[1,{{\"ok\":true}}]}}")))
    info(show(decode("  [ 1 , 2 ]  ")))
    info(show(decode("{{\"a\":1,\"a\":2}}")))
    info(show(decode("{{ \"\": 1 }}")))

    ## constructed tree
    mut xs: Array<Json> = []
    xs.append(JInt(1))
    xs.append(JNull())
    info(encode(JArr(xs)))
    info(encode(JBool(false)))
    info(encode(JStr("line\nbreak")))

    ## failures
    info(show(decode("")))
    info(show(decode("   ")))
    info(show(decode("1 2")))
    info(show(decode("+1")))
    info(show(decode("01")))
    info(show(decode(".5")))
    info(show(decode("1.")))
    info(show(decode("1e")))
    info(show(decode("[1,]")))
    info(show(decode("{{\"a\":1,}}")))
    info(show(decode("[1")))
    info(show(decode("\"abc")))
    info(show(decode("{{a:1}}")))
    info(show(decode("'x'")))
    info(show(decode("NaN")))
    info(show(decode("Infinity")))
    info(show(decode("9223372036854775808")))
    info(show(decode("-9223372036854775808")))
    info(kind(decode("-9223372036854775808")))
    info(show(decode("1e1000")))
    info(show(decode("[truee]")))

    0
}
