## Type-arg `!` vs whole-arm `!` extract marks (D118).
import logging from "std/Logging"
type Hold(n: Int64)
type Empty

## Type-arg extract: Hold<Int64!> → unwrap Int64 on `?`
type Slot = Hold<Int64!> | Empty?

## Whole-arm extract: Hold! → yield Hold on `?`
type Wrapped = Hold! | Empty?

fn chain(s!: Slot) -> Slot {
    let n = s?
    let x: Slot = Hold(n: n + 1)
    x
}

fn wrap(s!: Wrapped) -> Wrapped {
    let h = s?
    ## h is Hold; rebuild via inject
    let x: Wrapped = h
    x
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match chain(Hold(n: 5)) {
        Hold(n) { logging.info("slot={n}") }
        Empty { logging.info("empty") }
    }
    match chain(Empty()) {
        Hold(n) { logging.info("slot={n}") }
        Empty { logging.info("empty") }
    }
    match wrap(Hold(n: 9)) {
        Hold(n) { logging.info("wrap={n}") }
        Empty { logging.info("empty") }
    }
    match wrap(Empty()) {
        Hold(n) { logging.info("wrap={n}") }
        Empty { logging.info("empty") }
    }
    0
}
