## File type with method write-back (D107/D109): openFile / readAll / close.
import { openFile, oRdonly, readFile } from "./iolib/Io"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"

fn main() -> Int64 {
    println("oRdonly={oRdonly}")
    match openFile("tests/conformance/io_data/sample.txt") {
        Fail(e) {
            println("open-fail={e}")
        }
        Pass(f) {
            if f.isOpen() {
                println("open-ok")
            } else {
                println("open-closed")
            }
            match f.readAll() {
                Pass(body) {
                    println("body={body.toString()}")
                }
                Fail(e) {
                    println("read-fail={e}")
                }
            }
            f.close()
            if f.isOpen() {
                println("still-open")
            } else {
                println("closed")
            }
            ## Second close is a no-op (fd already -1).
            f.close()
            println("double-close-ok")
        }
    }
    ## Free function still works.
    match readFile("tests/conformance/io_data/sample.txt") {
        Pass(body) {
            println("free={body.toString()}")
        }
        Fail(e) {
            println("free-fail={e}")
        }
    }
    0
}
