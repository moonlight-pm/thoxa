## File type with method write-back (D107/D109): openFile / readAll / close.
import { openFile, oRdonly, readFile } from "std/io"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("oRdonly={oRdonly}")
    match openFile("tests/conformance/io_data/sample.txt") {
        Fail(e) {
            logging.info("open-fail={e}")
        }
        Pass(f) {
            if f.isOpen() {
                logging.info("open-ok")
            } else {
                logging.info("open-closed")
            }
            match f.readAll() {
                Pass(body) {
                    logging.info("body={body.toString()}")
                }
                Fail(e) {
                    logging.info("read-fail={e}")
                }
            }
            f.close()
            if f.isOpen() {
                logging.info("still-open")
            } else {
                logging.info("closed")
            }
            ## Second close is a no-op (fd already -1).
            f.close()
            logging.info("double-close-ok")
        }
    }
    ## Free function still works.
    match readFile("tests/conformance/io_data/sample.txt") {
        Pass(body) {
            logging.info("free={body.toString()}")
        }
        Fail(e) {
            logging.info("free-fail={e}")
        }
    }
    0
}
