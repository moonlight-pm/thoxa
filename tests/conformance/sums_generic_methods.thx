## Methods on generic products — monomorphized with the type.
import logging from "std/logging"
type Box<T>(value: T) {
    export fn get() -> T {
        value
    }
}

type Counter<T>(value: T) {
    export fn get() -> T {
        value
    }
    export fn add(d: T) -> Counter<T> {
        Counter(value: value + d)
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Box<Int64> = Box(value: 10)
    logging.info("{a.get()}")
    let s: Box<String> = Box(value: "hi")
    logging.info("{s.get()}")
    let c: Counter<Int64> = Counter(value: 7)
    logging.info("{c.get()}")
    let d = c.add(d: 3)
    logging.info("{d.get()}")
    0
}
