## Static-file Router type — path segments, traversal reject, index.html, Content-Type.
## Asserts typed Response fields + writeResponse status lines (PR6 / D70).
import { Router } from "std/http/static"
import { Request, Header, writeResponse } from "std/http"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

fn makeGet(path!: String) -> Request {
    mut headers: Array<Header> = []
    Request(
        method: "GET",
        path: path,
        query: "",
        version: "HTTP/1.1",
        headers: headers,
        body: Bytes(0)
    )
}

fn statusOf(resp!: Bytes) -> String {
    ## First line up to \r (or whole buffer).
    match resp.find(Bytes.fromString("\r")) {
        Has(cr) { resp.slice(0, cr).toString() }
        Not { resp.toString() }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let router = Router(root: "tests/conformance/io_data/web")

    ## Directory → index.html (bind Response: status + wire)
    let resp0 = router.handle(makeGet("/"))
    logging.info("root-status={resp0.status}")
    let r0 = writeResponse(resp0)
    logging.info("root={statusOf(r0)}")

    ## Nested index
    let r1 = writeResponse(router.handle(makeGet("/about/")))
    logging.info("about={statusOf(r1)}")

    ## Direct file + Content-Type from Response.headers (ok() first header)
    let resp2 = router.handle(makeGet("/style.css"))
    logging.info("css-status={resp2.status}")
    if resp2.headers[0].name == "Content-Type" {
        if resp2.headers[0].value == "text/css" {
            logging.info("css-type-ok")
        } else {
            logging.info("css-type-missing")
        }
    } else {
        logging.info("css-type-missing")
    }
    let r2 = writeResponse(resp2)
    logging.info("css={statusOf(r2)}")

    ## Path traversal → 404 (bind Response: status + wire)
    let resp3 = router.handle(makeGet("/../secret"))
    logging.info("trav-status={resp3.status}")
    let r3 = writeResponse(resp3)
    logging.info("trav={statusOf(r3)}")

    ## Missing → 404
    let r4 = writeResponse(router.handle(makeGet("/nope.html")))
    logging.info("miss={statusOf(r4)}")

    ## Must start with /
    let r5 = writeResponse(router.handle(makeGet("relative")))
    logging.info("rel={statusOf(r5)}")

    ## Empty path → 404
    let r6 = writeResponse(router.handle(makeGet("")))
    logging.info("empty={statusOf(r6)}")

    0
}
