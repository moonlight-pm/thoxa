## Namespace import (M-MOD-2): a `./` namespace bound to a freely-chosen camelCase
## name (`mu`), plus one bound conventionally. A module file is a kebab-case
## compilation unit (D138); the import is a namespace, not a value. Qualified
## access reaches an exported fn, a type, and a let; only exported names cross.
import mu       from "./modlib/math-utils"
import geometry from "./modlib/geometry"
import logging from "std/logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("add = {mu.add(a: 2, b: 3)}")
    logging.info("double = {mu.double(n: 21)}")
    let p = geometry.Point(x: 3, y: 4)
    logging.info("p.sum = {p.sum()}")
    logging.info("origin.sum = {geometry.origin.sum()}")
    logging.info("originSum = {mu.originSum()}")
    0
}
