## Nested Trial as Trial/May payload (D114).

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

fn innerOk() -> Trial<Int64, String> {
    Pass(42)
}

fn innerFail() -> Trial<Int64, String> {
    Fail("inner-err")
}

fn wrapOk() -> Trial<Trial<Int64, String>, String> {
    Pass(innerOk())
}

fn wrapInnerFail() -> Trial<Trial<Int64, String>, String> {
    Pass(innerFail())
}

fn wrapOuterFail() -> Trial<Trial<Int64, String>, String> {
    Fail("outer-err")
}

fn wrapMay() -> May<Trial<Int64, String>> {
    Has(innerOk())
}

fn wrapMayNot() -> May<Trial<Int64, String>> {
    Not()
}

fn chain() -> Trial<Trial<Int64, String>, String> {
    let t = wrapOk()?
    Pass(t)
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match wrapOk() {
        Pass(t) {
            match t {
                Pass(v) { logging.info("ok={v}") }
                Fail(e) { logging.info("inner-fail={e}") }
            }
        }
        Fail(e) { logging.info("outer-fail={e}") }
    }
    match wrapInnerFail() {
        Pass(t) {
            match t {
                Pass(v) { logging.info("ok={v}") }
                Fail(e) { logging.info("inner-fail={e}") }
            }
        }
        Fail(e) { logging.info("outer-fail={e}") }
    }
    match wrapOuterFail() {
        Pass(t) {
            match t {
                Pass(v) { logging.info("ok={v}") }
                Fail(e) { logging.info("inner-fail={e}") }
            }
        }
        Fail(e) { logging.info("outer-fail={e}") }
    }
    match wrapMay() {
        Has(t) {
            match t {
                Pass(v) { logging.info("may-ok={v}") }
                Fail(e) { logging.info("may-inner={e}") }
            }
        }
        Not { logging.info("may-not") }
    }
    match wrapMayNot() {
        Has(t) {
            match t {
                Pass(v) { logging.info("may-ok={v}") }
                Fail(e) { logging.info("may-inner={e}") }
            }
        }
        Not { logging.info("may-not") }
    }
    match chain() {
        Pass(t) {
            match t {
                Pass(v) { logging.info("chain={v}") }
                Fail(e) { logging.info("chain-inner={e}") }
            }
        }
        Fail(e) { logging.info("chain-outer={e}") }
    }
    0
}
