## Value match: string / int / bool literal arms + required `else` (D87).
import logging from "std/Logging"
fn label(n!: Int64) -> String {
    match n {
        0 { "zero" }
        1 { "one" }
        else { "many" }
    }
}

fn flag(b!: Bool) -> String {
    match b {
        true { "yes" }
        false { "no" }
        else { "??" }
    }
}

fn dispatch(cmd!: String) -> Int64 {
    match cmd {
        "exit" { 0 }
        "help" { 1 }
        "echo" { 2 }
        else { 9 }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{label(0)}")
    logging.info("{label(1)}")
    logging.info("{label(7)}")
    logging.info("{flag(true)}")
    logging.info("{flag(false)}")
    let d0 = dispatch("help")
    let d1 = dispatch("echo")
    let d2 = dispatch("bogus")
    logging.info("{d0}")
    logging.info("{d1}")
    logging.info("{d2}")
    ## match as statement (Void arms)
    match "pwd" {
        "pwd" { logging.info("got-pwd") }
        else { logging.info("other") }
    }
    0
}
