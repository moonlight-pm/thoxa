## Type.read of constructor-param products (D149); a read reports every
## issue as Array<Issue> (D182 §2).
import { Issue, messages, decode } from "std/json"
import { Pass, Fail, Trial, Has, Not, May } from "std/fallible"
import logging, { info } from "std/logging"

type Order(slug: String, qty: Int64)
type Note(text: String)
type Wrap(inner: Order)
type Line(items: Array<Order>)
type OptNote(text: May<String>, n: Int64)

fn showOrder(t!: Trial<Order, Array<Issue>>) -> String {
    match t {
        Fail(issues) => "ERR:{messages(issues)}"
        Pass(o) => "{o.slug}:{o.qty}"
    }
}

fn showWrap(t!: Trial<Wrap, Array<Issue>>) -> String {
    match t {
        Fail(issues) => "ERR:{messages(issues)}"
        Pass(w) => "w:{w.inner.slug}:{w.inner.qty}"
    }
}

fn showLine(t!: Trial<Line, Array<Issue>>) -> String {
    match t {
        Fail(issues) => "ERR:{messages(issues)}"
        Pass(line) => "n:{line.items.count}"
    }
}

fn showOpt(t!: Trial<OptNote, Array<Issue>>) -> String {
    match t {
        Fail(issues) => "ERR:{messages(issues)}"
        Pass(note) {
            match note.text {
                Not => "opt:{note.n}:none"
                Has(s) => "opt:{note.n}:{s}"
            }
        }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    info(showWrap(Wrap.read("{{\"inner\":{{\"slug\":\"x\",\"qty\":1}}}}")))
    info(showLine(Line.read("{{\"items\":[{{\"slug\":\"a\",\"qty\":1}},{{\"slug\":\"b\",\"qty\":2}}]}}")))
    info(showOrder(Order.read("{{\"slug\":\"mocha\",\"qty\":2}}")))
    info(showOrder(Order.read("{{\"slug\":1,\"qty\":2}}")))
    info(showOrder(Order.read("{{\"qty\":2}}")))
    info(showOrder(Order.read("[]")))
    info(showOrder(Order.read("[")))

    ## Nested read after a failed read (heap-corrupt regression).
    info(showWrap(Wrap.read("{{\"inner\":{{\"slug\":\"y\",\"qty\":3}}}}")))

    info(showOpt(OptNote.read("{{\"n\":1}}")))
    info(showOpt(OptNote.read("{{\"text\":null,\"n\":2}}")))
    info(showOpt(OptNote.read("{{\"text\":\"hi\",\"n\":3}}")))
    info(showOpt(OptNote.read("{{\"text\":1,\"n\":4}}")))

    match decode("true") {
        Fail(e) => info("tree:{e}")
        Pass => info("tree:ok")
    }
    0
}
