## R6: extern fn libc — write(2), abs, optional C symbol rename.
extern fn write(fd!: Int32, buf!: Bytes, count!: UInt64) -> Int64 from "c"
extern fn abs(x!: Int32) -> Int32 from "c"
extern fn sysGetpid() -> Int32 from "c" "getpid"

fn main() -> Int64 {
    let msg = Bytes.fromString("hello via write\n")
    let n = write(1, msg, msg.count)
    if n < 0 {
        println("write failed")
        1
    } else {
        let a = abs(-42)
        println(a)

        ## Symbol rename: call getpid through a different Thoxa name.
        let pid = sysGetpid()
        if pid > 0 {
            println("pid-ok")
        } else {
            println("pid-bad")
        }
        0
    }
}
