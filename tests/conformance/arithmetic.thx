## Integer arithmetic (truncating division) and comparisons / logical ops.
## R1 uses println on values directly (string interpolation comes later).
import logging from "std/logging"
fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{7 + 3}")
    logging.info("{7 - 3}")
    logging.info("{7 * 3}")
    logging.info("{7 / 3}")
    logging.info("{7 % 3}")
    logging.info("{-7 / 3}")
    logging.info("{2 < 3}")
    logging.info("{3 <= 3}")
    logging.info("{4 > 5}")
    logging.info("{not true}")
    logging.info("{true and false}")
    logging.info("{false or true}")
    0
}
