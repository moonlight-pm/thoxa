## Http — minimal HTTP/1.1 parse + response (subset of oracle examples/http/Http.thx).
## Uses Bytes.slice + Bytes.find (no dynamic Array/Buffer yet).

## Summarize a request-line as `METHOD|path|version` (no headers/body).
## Expects `METHOD path version\r\n…`. Returns empty string if malformed.
export fn summarizeRequest(raw!: Bytes) -> String {
    let sp = Bytes.fromString(" ")
    let sp1 = raw.find(sp)
    if sp1 < 0 {
        ""
    } else {
        let sp2 = raw.find(sp, sp1 + 1)
        if sp2 < 0 {
            ""
        } else {
            let cr = raw.find(Bytes.fromString("\r"), sp2 + 1)
            if cr < 0 {
                ""
            } else {
                let method = raw.slice(0, sp1).toString()
                let path = raw.slice(sp1 + 1, sp2).toString()
                let version = raw.slice(sp2 + 1, cr).toString()
                "{method}|{path}|{version}"
            }
        }
    }
}

## Serialize a minimal 200 OK response (text body).
export fn ok(body!: Bytes) -> Bytes {
    let text = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: {body.count}\r\nConnection: close\r\n\r\n{body.toString()}"
    Bytes.fromString(text)
}

## 400 Bad Request with a short reason line.
export fn badRequest(msg!: String) -> Bytes {
    let body = Bytes.fromString("Bad Request: {msg}\n")
    let text = "HTTP/1.1 400 Bad Request\r\nContent-Type: text/plain\r\nContent-Length: {body.count}\r\nConnection: close\r\n\r\n{body.toString()}"
    Bytes.fromString(text)
}
