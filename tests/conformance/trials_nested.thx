## Nested Trial/May payloads: Array and May as ok/err (D113).
## Also exercises `>>` type-arg close (`May<Array<Int64>>`).

import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import logging from "std/Logging"

fn arrOk() -> Trial<Array<Int64>, String> {
    Pass([10, 20, 30])
}

fn arrFail() -> Trial<Array<Int64>, String> {
    Fail("no-arr")
}

fn mayOk() -> Trial<May<Int64>, String> {
    Pass(Has(7))
}

fn mayNot() -> Trial<May<Int64>, String> {
    Pass(Not())
}

fn mayFail() -> Trial<May<Int64>, String> {
    Fail("no-may")
}

fn mayArr() -> May<Array<Int64>> {
    Has([1, 2])
}

fn mayArrEmpty() -> May<Array<Int64>> {
    Not()
}

fn chainArr(n!: Int64) -> Trial<Array<Int64>, String> {
    let a = arrOk()?
    if n < 0 {
        Fail("neg")
    } else {
        Pass(a)
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match arrOk() {
        Pass(a) { logging.info("arr-count={a.count} first={a[0]}") }
        Fail(e) { logging.info("arr-fail={e}") }
    }
    match arrFail() {
        Pass(a) { logging.info("unexpected={a.count}") }
        Fail(e) { logging.info("arr-err={e}") }
    }
    match mayOk() {
        Pass(m) {
            match m {
                Has(v) { logging.info("may-has={v}") }
                Not { logging.info("may-not") }
            }
        }
        Fail(e) { logging.info("may-fail={e}") }
    }
    match mayNot() {
        Pass(m) {
            match m {
                Has(v) { logging.info("may-has={v}") }
                Not { logging.info("may-not") }
            }
        }
        Fail(e) { logging.info("may-fail={e}") }
    }
    match mayFail() {
        Pass(m) {
            match m {
                Has(v) { logging.info("may-has={v}") }
                Not { logging.info("may-not") }
            }
        }
        Fail(e) { logging.info("may-fail={e}") }
    }
    match mayArr() {
        Has(a) { logging.info("ma-count={a.count}") }
        Not { logging.info("ma-not") }
    }
    match mayArrEmpty() {
        Has(a) { logging.info("mae={a.count}") }
        Not { logging.info("mae-not") }
    }
    match chainArr(1) {
        Pass(a) { logging.info("chain={a.count}") }
        Fail(e) { logging.info("chain-fail={e}") }
    }
    match chainArr(-1) {
        Pass(a) { logging.info("chain2={a.count}") }
        Fail(e) { logging.info("chain-fail={e}") }
    }
    0
}
