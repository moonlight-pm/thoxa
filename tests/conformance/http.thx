## R9+: HTTP subset — Net/Http modules, Trial monomorphs, offline protocol + socket lifecycle.
import net from "./httplib/Net"
import http from "./httplib/Http"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"

fn main() -> Int64 {
    ## --- Protocol (deterministic) ---
    let raw = Bytes.fromString("GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")
    let summary = http.summarizeRequest(raw)
    println(summary)

    let body = Bytes.fromString("ok\n")
    let res = http.writeResponse(http.ok(body, "text/plain"))
    println(res.toString())

    let bad = http.writeResponse(http.badRequest("incomplete"))
    println(bad.toString())

    ## --- Socket lifecycle: create → reuse → bind(0) → listen → close ---
    match net.createSocket() {
        Fail(e) {
            println("socket-fail {e}")
            1
        }
        Pass(sock) {
            match sock.reuseAddr() {
                Fail(e) {
                    println("reuse-fail {e}")
                    sock.close()
                    1
                }
                Pass(u1) {
                    match sock.bind(0) {
                        Fail(e) {
                            println("bind-fail {e}")
                            sock.close()
                            1
                        }
                        Pass(u2) {
                            match sock.listen(1) {
                                Fail(e) {
                                    println("listen-fail {e}")
                                    sock.close()
                                    1
                                }
                                Pass(u3) {
                                    println("listen-ok")
                                    sock.close()
                                    0
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
