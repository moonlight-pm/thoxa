## Bytes + mut (R5). Fixed heap Bytes with simple RC; mut reassignment.
## R9: Bytes(n) zero-fill + slice.
fn main() -> Int64 {
    mut b = Bytes.fromString("abc")
    println(b.count)
    println(b.get(0))
    b.set(0, 65)
    println(b.toString())

    mut n = 0
    n = n + 1
    n = n + 1
    println(n)

    b = Bytes.fromString("xy")
    println(b.count)
    println(b.toString())

    let z = Bytes(4)
    println(z.count)
    println(z.get(0))
    z.set(2, 99)
    println(z.get(2))

    let s = Bytes.fromString("hello").slice(1, 4)
    println(s.toString())

    let hay = Bytes.fromString("abXabY")
    let needle = Bytes.fromString("ab")
    println(hay.find(needle))
    println(hay.find(needle, 1))
    println(hay.find(Bytes.fromString("ZZ")))
    0
}
