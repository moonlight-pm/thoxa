## while / loop / break / continue and exclusive for-range.
fn main() -> Int64 {
    ## while + break
    mut n = 0
    while n < 10 {
        n = n + 1
        if n == 4 {
            break
        }
    }
    println(n)

    ## while + continue (sum odds 1..5 → 1+3+5 = 9)
    mut i = 0
    mut odds = 0
    while i < 5 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        odds = odds + i
    }
    println(odds)

    ## loop + break
    mut k = 0
    loop {
        k = k + 1
        if k >= 3 {
            break
        }
    }
    println(k)

    ## exclusive for 0..4 → 0 1 2 3
    mut sum = 0
    for j in 0..4 {
        sum = sum + j
    }
    println(sum)

    ## for + continue (sum even indices in 0..=5 → 0+2+4 = 6)
    mut evens = 0
    for t in 0..=5 {
        if t % 2 != 0 {
            continue
        }
        evens = evens + t
    }
    println(evens)

    0
}
