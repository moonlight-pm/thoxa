## Cross-file modules (M-MOD-1): a local `./` import and a project `~/` import,
## using each other's exported fn, type, and let. Only exported names cross.
import { add, double, originSum } from "./modlib/MathUtils"
import { Point, origin } from "~/modlib/Geometry"
import logging from "std/Logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("add = {add(a: 2, b: 3)}")
    logging.info("double = {double(n: 21)}")
    let p = Point(x: 3, y: 4)
    logging.info("p.sum = {p.sum()}")
    logging.info("origin.sum = {origin.sum()}")
    logging.info("originSum = {originSum()}")
    0
}
