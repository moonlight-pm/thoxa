## Value-match bare bind catch-all (D110): `n { … }` binds the scrutinee.
import logging from "std/Logging"
fn label(n!: Int64) -> String {
    match n {
        0 { "zero" }
        1 { "one" }
        n { "n={n}" }
    }
}

fn echo(cmd!: String) -> String {
    match cmd {
        "help" { "HELP" }
        s { "got:{s}" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{label(0)}")
    logging.info("{label(1)}")
    logging.info("{label(42)}")
    logging.info(echo("help"))
    logging.info(echo("run"))
    ## `_` is still a discard catch-all (same as else).
    match 9 {
        0 { logging.info("nope") }
        _ { logging.info("uscore") }
    }
    0
}
