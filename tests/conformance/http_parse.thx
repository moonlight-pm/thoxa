## PR5: Request / Response / Header + parseRequest + writeResponse.
import http from "std/http"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    ## --- parseRequest: method/path/version + Host header ---
    let raw = Bytes.fromString("GET /x HTTP/1.1\r\nHost: h\r\n\r\n")
    match http.parseRequest(raw) {
        Pass(req) {
            logging.info("{req.method}|{req.path}|{req.version}")
            logging.info("hdr_count={req.headers.count}")
            logging.info("host={req.headers[0].name}:{req.headers[0].value}")
            logging.info("body_count={req.body.count}")
        }
        Fail(e) {
            logging.info("parse-fail {e}")
        }
    }

    ## Query string stripped from path; kept on Request.query
    let qraw = Bytes.fromString("GET /search?q=1 HTTP/1.1\r\n\r\n")
    match http.parseRequest(qraw) {
        Pass(req) {
            logging.info("path={req.path}")
            logging.info("query={req.query}")
        }
        Fail(e) {
            logging.info("q-fail {e}")
        }
    }

    ## Multiple headers
    let multi = Bytes.fromString("POST /a HTTP/1.0\r\nHost: x\r\nAccept: */*\r\n\r\n")
    match http.parseRequest(multi) {
        Pass(req) {
            logging.info("{req.method}|{req.path}|{req.version}|n={req.headers.count}")
            logging.info("{req.headers[0].name}={req.headers[0].value}")
            logging.info("{req.headers[1].name}={req.headers[1].value}")
        }
        Fail(e) {
            logging.info("multi-fail {e}")
        }
    }

    ## Malformed / incomplete
    match http.parseRequest(Bytes.fromString("GET /no-sep")) {
        Pass(_) { logging.info("unexpected-pass") }
        Fail(e) { logging.info("incomplete={e}") }
    }
    match http.parseRequest(Bytes.fromString("ONLYONE\r\n\r\n")) {
        Pass(_) { logging.info("unexpected-pass") }
        Fail(e) { logging.info("badline={e}") }
    }
    match http.parseRequest(Bytes.fromString("GET /x HTTP/1.1\r\nbadheader\r\n\r\n")) {
        Pass(_) { logging.info("unexpected-pass") }
        Fail(e) { logging.info("badhdr={e}") }
    }
    ## Empty header name (`: value`)
    match http.parseRequest(Bytes.fromString("GET /x HTTP/1.1\r\n: v\r\n\r\n")) {
        Pass(_) { logging.info("unexpected-pass") }
        Fail(e) { logging.info("emptyname={e}") }
    }
    ## Extra request-line token
    match http.parseRequest(Bytes.fromString("GET /x HTTP/1.1 extra\r\n\r\n")) {
        Pass(_) { logging.info("unexpected-pass") }
        Fail(e) { logging.info("extra={e}") }
    }

    ## summarizeRequest still works
    logging.info("{http.summarizeRequest(raw)}")

    ## writeResponse round-trip: status + Content-Length + body
    let body = Bytes.fromString("ok\n")
    let res = http.ok(body, "text/plain")
    let wire = http.writeResponse(res)
    logging.info("{wire.toString()}")

    let nf = http.writeResponse(http.notFound())
    logging.info("{nf.toString()}")

    let br = http.writeResponse(http.badRequest("incomplete"))
    logging.info("{br.toString()}")

    0
}
