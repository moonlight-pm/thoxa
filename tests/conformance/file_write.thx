## File write/create (D112): writeFile, appendFile, File.write.
import { writeFile, appendFile, readFile, oCreat, oWronly, oTrunc } from "./iolib/Io"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import logging from "std/Logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let path = "/tmp/thoxa_file_write_conformance.txt"
    let body = Bytes.fromString("hello write\n")
    match writeFile(path, body) {
        Fail(e) {
            logging.info("write-fail={e}")
        }
        Pass(n) {
            logging.info("wrote={n}")
        }
    }
    match readFile(path) {
        Fail(e) {
            logging.info("read-fail={e}")
        }
        Pass(b) {
            logging.info("body={b.toString()}")
        }
    }
    match appendFile(path, Bytes.fromString("more\n")) {
        Fail(e) {
            logging.info("append-fail={e}")
        }
        Pass(n) {
            logging.info("appended={n}")
        }
    }
    match readFile(path) {
        Fail(e) {
            logging.info("read2-fail={e}")
        }
        Pass(b) {
            logging.info("body2={b.toString()}")
        }
    }
    ## Flags are exported for callers that compose open modes.
    logging.info("flags={oWronly}|{oCreat}|{oTrunc}")
    0
}
