## User+heap field RC: assign, methods, Trial Pass/match/?, sequential calls.
## Also: multi-field String+Bytes, Fail(User) err payload.

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

type Box(s: String) {
    export fn get() -> String {
        s
    }
    export fn clone() -> Box {
        Box(s: s)
    }
}

## Multi-heap-field User (String + Bytes).
type Pair(name: String, data: Bytes) {
    export fn nameOf() -> String {
        name
    }
    export fn dataOf() -> String {
        data.toString()
    }
}

## User as Trial err payload.
type ErrMsg(text: String)

fn makeBox(s!: String) -> Trial<Box, String> {
    if s == "" {
        Fail("empty")
    } else {
        Pass(Box(s: s))
    }
}

fn chain(s!: String) -> Trial<Box, String> {
    let b = makeBox(s)?
    Pass(b)
}

fn makePair(ok!: Bool) -> Trial<Pair, ErrMsg> {
    if ok {
        Pass(Pair(name: "pair", data: Bytes.fromString("ab")))
    } else {
        Fail(ErrMsg(text: "bad"))
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    ## Assign copy: both own the String field
    let a = Box(s: "hello")
    let b = a
    logging.info("{a.s}")
    logging.info("{b.s}")

    ## Method returning Box does not double-free path field
    let c = a.clone()
    logging.info("{c.s}")
    logging.info("{a.get()}")

    ## Trial Pass + match
    match makeBox("x") {
        Pass(box) { logging.info("{box.s}") }
        Fail(e) { logging.info("{e}") }
    }
    match makeBox("") {
        Pass(box) { logging.info("{box.s}") }
        Fail(e) { logging.info("{e}") }
    }

    ## ? rewrap — two sequential calls (ASan must stay clean)
    match chain("y") {
        Pass(box) { logging.info("{box.s}") }
        Fail(e) { logging.info("{e}") }
    }
    match chain("z") {
        Pass(box) { logging.info("{box.s}") }
        Fail(e) { logging.info("{e}") }
    }
    match chain("w") {
        Pass(box) { logging.info("{box.s}") }
        Fail(e) { logging.info("{e}") }
    }

    ## Multi-field String+Bytes: assign copy + method reads
    let p = Pair(name: "pair", data: Bytes.fromString("ab"))
    let q = p
    logging.info("{p.nameOf()}")
    logging.info("{q.dataOf()}")

    ## Trial Pass(Pair) + Fail(ErrMsg) — User on both sides
    match makePair(true) {
        Pass(pr) {
            logging.info("{pr.nameOf()}")
            logging.info("{pr.dataOf()}")
        }
        Fail(er) { logging.info("{er.text}") }
    }
    match makePair(false) {
        Pass(pr) {
            logging.info("{pr.nameOf()}")
            logging.info("{pr.dataOf()}")
        }
        Fail(er) { logging.info("{er.text}") }
    }
    0
}
