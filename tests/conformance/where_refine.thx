## `type T = Int64 where …` + Type.read / Type.from (builtin validation).
import { Issue, message } from "std/json"
import { Pass, Fail, Trial } from "std/fallible"
import logging, { info } from "std/logging"

type Qty = Int64 where >= 1 "need {expected}, got {value}"
type Dozen = Qty where <= 12
type Order(slug: String, qty: Qty)
type Line(n: Int64 where >= 1)
type DrinkSlug = "espresso" | "mocha"
type Drink(slug: DrinkSlug)
type Closed = String where "a" | "b"

fn showQ(t: Trial<Qty, Issue>) -> String {
    match t {
        Fail(e) => "ERR:{message(e)}"
        Pass(q) => "ok:{q}"
    }
}

fn showO(t: Trial<Order, Issue>) -> String {
    match t {
        Fail(e) => "ERR:{message(e)}"
        Pass(o) => "{o.slug}:{o.qty}"
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Qty = 2
    info("lit:{a}")
    let n: Int64 = a
    info("base:{n}")
    info("{a + 40}")

    info(showQ(Qty.from(3)))
    info(showQ(Qty.from(0)))
    match Dozen.from(5) {
        Fail(e) => info("ERR:{message(e)}")
        Pass(q) => info("ok:{q}")
    }
    match Dozen.from(13) {
        Fail(e) => info("ERR:{message(e)}")
        Pass(q) => info("ok:{q}")
    }

    info(showO(Order.read("{{\"slug\":\"mocha\",\"qty\":2}}")))
    info(showO(Order.read("{{\"slug\":\"mocha\",\"qty\":0}}")))
    match Line.read("{{\"n\":0}}") {
        Fail(e) => info("line:{message(e)}")
        Pass(x) => info("lineok:{x.n}")
    }
    match Order.read("{{\"slug\":\"mocha\",\"qty\":2}}") {
        Fail(e) => info("enc:{message(e)}")
        Pass(o) => info(o.encode())
    }
    match DrinkSlug.from("chai") {
        Fail(e) => info("slug:{message(e)}")
        Pass(s) => info("slugok:{s}")
    }
    match DrinkSlug.from("mocha") {
        Fail(e) => info("slug2:{message(e)}")
        Pass(s) {
            let asStr: String = s
            info("slugok:{asStr}")
        }
    }
    match Drink.read("{{\"slug\":\"espresso\"}}") {
        Fail(e) => info("dr:{message(e)}")
        Pass(d) => info("drok:{d.slug}")
    }
    match DrinkSlug.read("\"espresso\"") {
        Fail(e) => info("sr:{message(e)}")
        Pass(s) => info("srok:{s}")
    }
    match Drink.read("{{\"slug\":\"chai\"}}") {
        Fail(e) => info("dr2:{message(e)}")
        Pass(d) => info("drok2:{d.slug}")
    }
    match Closed.from("c") {
        Fail(e) => info("cl:{message(e)}")
        Pass(s) => info("clok:{s}")
    }
    0
}
