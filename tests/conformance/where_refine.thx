## `type T = Int64 where …` + Type.read / `x as T` (builtin validation; `as` replaced Type.from, D191).
import { Issue, messages } from "std/json"
import { Pass, Fail, Trial } from "std/fallible"
import logging, { info } from "std/logging"

type Qty = Int64 where >= 1 "need {expected}, got {value}"
type Dozen = Qty where <= 12
type Order(slug: String, qty: Qty)
type Line(n: Int64 where >= 1)
type DrinkSlug = "espresso" | "mocha"
type Drink(slug: DrinkSlug)
type Closed = String where "a" | "b"

fn showQ(t!: Trial<Qty, Array<Issue>>) -> String {
    match t {
        Fail(issues) => "ERR:{messages(issues)}"
        Pass(q) => "ok:{q}"
    }
}

fn showO(t!: Trial<Order, Array<Issue>>) -> String {
    match t {
        Fail(issues) => "ERR:{messages(issues)}"
        Pass(o) => "{o.slug}:{o.qty}"
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Qty = 2
    info("lit:{a}")
    let n: Int64 = a
    info("base:{n}")
    info("{a + 40}")

    ## A literal operand would be checked at compile time; these are values.
    let three = 3
    let zero = 0
    info(showQ(three as Qty))
    info(showQ(zero as Qty))
    for value in [5, 13] {
        match value as Dozen {
            Fail(issues) => info("ERR:{messages(issues)}")
            Pass(q) => info("ok:{q}")
        }
    }

    info(showO(Order.read("{{\"slug\":\"mocha\",\"qty\":2}}")))
    info(showO(Order.read("{{\"slug\":\"mocha\",\"qty\":0}}")))
    match Line.read("{{\"n\":0}}") {
        Fail(issues) => info("line:{messages(issues)}")
        Pass(x) => info("lineok:{x.n}")
    }
    match Order.read("{{\"slug\":\"mocha\",\"qty\":2}}") {
        Fail(issues) => info("enc:{messages(issues)}")
        Pass(o) => info(o.encode())
    }
    let chai = "chai"
    let mocha = "mocha"
    match chai as DrinkSlug {
        Fail(issues) => info("slug:{messages(issues)}")
        Pass(s) => info("slugok:{s}")
    }
    match mocha as DrinkSlug {
        Fail(issues) => info("slug2:{messages(issues)}")
        Pass(s) {
            let asStr: String = s
            info("slugok:{asStr}")
        }
    }
    match Drink.read("{{\"slug\":\"espresso\"}}") {
        Fail(issues) => info("dr:{messages(issues)}")
        Pass(d) => info("drok:{d.slug}")
    }
    match DrinkSlug.read("\"espresso\"") {
        Fail(issues) => info("sr:{messages(issues)}")
        Pass(s) => info("srok:{s}")
    }
    match Drink.read("{{\"slug\":\"chai\"}}") {
        Fail(issues) => info("dr2:{messages(issues)}")
        Pass(d) => info("drok2:{d.slug}")
    }
    let c = "c"
    match c as Closed {
        Fail(issues) => info("cl:{messages(issues)}")
        Pass(s) => info("clok:{s}")
    }
    0
}
