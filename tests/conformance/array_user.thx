## Array<User>: empty + append + index get + for-in + field access + dropLast.
## Constructor-param User with String fields (inline elems, field RC — D65).
import logging from "std/logging"
type Header(name: String, value: String) {
    export fn label() -> String {
        "{name}={value}"
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    mut xs: Array<Header> = []
    logging.info("empty_count={xs.count}")

    xs.append(Header(name: "Host", value: "ex"))
    xs.append(Header(name: "Accept", value: "*/*"))
    logging.info("count={xs.count}")
    logging.info("first={xs[0].label()}")
    logging.info("second_name={xs[1].name}")
    logging.info("second_value={xs[1].value}")

    mut n = 0
    for h in xs {
        n = n + 1
        logging.info("iter={h.label()}")
    }
    logging.info("iters={n}")

    ## Index set write-back (D133)
    xs[0] = Header(name: "Host", value: "localhost")
    logging.info("mutated={xs[0].label()}")

    mut ys = xs
    ys.dropLast()
    logging.info("dropped_count={ys.count}")
    logging.info("dropped_only={ys[0].label()}")
    ## Original still intact (COW)
    logging.info("orig_count={xs.count}")

    ## Literal of User elements
    let zs = [Header(name: "A", value: "1"), Header(name: "B", value: "2")]
    logging.info("lit_count={zs.count}")
    logging.info("lit0={zs[0].name}")

    ## insertAt / removeAt write-back; source intact via COW
    mut mid = zs
    mid.insertAt(1, Header(name: "M", value: "x"))
    logging.info("ins_count={mid.count} mid={mid[1].name}")
    mut cut = zs
    cut.removeAt(0)
    logging.info("rm_count={cut.count} rm0={cut[0].name}")
    logging.info("zs_still={zs.count}")
    0
}
