## Pure-literal union members (D118).
import logging from "std/logging"
type Flag = 0 | 1
type Mode = "r" | "w"
type Toggle = true | false

fn flagName(f!: Flag) -> String {
    match f {
        0 { "off" }
        1 { "on" }
    }
}

fn takeStr(s!: String) -> String {
    s
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Flag = 0
    let b: Flag = 1
    logging.info("{flagName(a)}")
    logging.info("{flagName(b)}")
    logging.info("{flagName(0)}")
    let m: Mode = "r"
    match m {
        "r" { logging.info("read") }
        "w" { logging.info("write") }
    }
    let t: Toggle = true
    match t {
        true { logging.info("yes") }
        false { logging.info("no") }
    }
    let widened: String = m
    logging.info(takeStr(m))
    logging.info("w:{widened}")
    logging.info("i:{m}")
    let n: Int64 = a
    logging.info("n:{n}")
    0
}
