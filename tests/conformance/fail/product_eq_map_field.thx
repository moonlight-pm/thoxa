## D175: `==` on a product compares its fields, so every field needs `==`.
## Map has none yet.
type Bag(label: String, counts: Map<String, Int64>)

fn main() -> Int64 {
    let left = Bag(label: "a", counts: {apples: 1})
    let right = Bag(label: "a", counts: {apples: 1})
    if left == right {
        return 1
    }
    0
}
