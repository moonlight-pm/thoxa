## D175: `==` on a product compares its fields, so every field needs `==`.
## Array has none yet.
type Bag(label: String, items: Array<Int64>)

fn main() -> Int64 {
    let left = Bag(label: "a", items: [1])
    let right = Bag(label: "a", items: [1])
    if left == right {
        return 1
    }
    0
}
