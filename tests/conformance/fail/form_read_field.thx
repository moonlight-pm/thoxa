## D182 §3: a form holds flat values, so a Map field cannot be read from one.
import { Issue } from "std/json"
import { Request } from "std/http"

type Settings(name: String)
type Profile(name: String, settings: Settings, extras: Map<String, String>)

fn main() -> Int64 {
    match Profile.readForm("name=ada") {
        Pass(profile) => profile.name.count
        Fail(issues) => issues.count
    }
}
