## D173: `main` returns the exit status, 0 to 255. 256 would reach the shell
## as 0 (the kernel keeps the low 8 bits), so it panics instead.
import logging, { info } from "std/logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    info("done")
    255 + 1
}
