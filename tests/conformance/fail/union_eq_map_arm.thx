## D177: `==` on a union compares the arm's payload, so every field of
## every arm needs `==`. Map has none yet.
type Bag(counts: Map<String, Int64>)
type Nothing()
type Holder = Bag | Nothing

fn main() -> Int64 {
    let left: Holder = Bag(counts: {apples: 1})
    let right: Holder = Nothing()
    if left == right {
        return 1
    }
    0
}
