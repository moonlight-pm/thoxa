## Heap payloads in user unions: String/Bytes fields (D118).
import logging from "std/Logging"
type Msg(text: String)
type Empty
type Slot = Msg | Empty?
type Slot2 = Msg | Empty?

fn chain(s!: Slot) -> Slot {
    let t = s?
    let x: Slot = Msg(text: "{t}!")
    x
}

fn describe(s!: Slot) -> String {
    match s {
        Msg(text) { "msg={text}" }
        Empty { "empty" }
    }
}

fn describe2(s!: Slot2) -> String {
    match s {
        Msg(text) { "msg={text}" }
        Empty { "empty" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info(describe(Msg(text: "hi")))
    match chain(Msg(text: "ok")) {
        Msg(text) { logging.info("ch={text}") }
        Empty { logging.info("empty") }
    }
    match chain(Empty()) {
        Msg(text) { logging.info("ch={text}") }
        Empty { logging.info("empty") }
    }
    ## Transparent alias remap with heap payload
    let a: Slot = Msg(text: "ab")
    let b: Slot2 = a
    logging.info("{describe2(b)}")
    0
}
