## Match discard binding `_` (D66): Fail(_) / Pass(_) do not introduce a name.
## Discarded heap payloads are still dropped at function end (RC).
## Pattern `_` only; body `_` is ordinary lookup (no outer `_` here).

type Box(n: Int64) {}

fn half(x: Int64) -> Trial<Int64, String> {
    if x % 2 == 0 {
        Pass(x / 2)
    } else {
        Fail("odd")
    }
}

fn asMsg(ok!: Bool) -> Trial<String, String> {
    if ok {
        Pass("ok")
    } else {
        Fail("err")
    }
}

fn asBytes(ok!: Bool) -> Trial<Bytes, String> {
    if ok {
        Pass(Bytes.fromString("ab"))
    } else {
        Fail("no-bytes")
    }
}

fn asBox(n!: Int64) -> Trial<Box, String> {
    if n < 0 {
        Fail("neg")
    } else {
        Pass(Box(n: n))
    }
}

fn main() -> Int64 {
    ## Bind ok, discard err payload.
    match half(20) {
        Pass(v) { println(v) }
        Fail(_) { println("fail-side") }
    }
    match half(7) {
        Pass(v) { println(v) }
        Fail(_) { println("x") }
    }

    ## Discard ok, bind err.
    match asMsg(false) {
        Pass(_) { println("unexpected-pass") }
        Fail(e) { println(e) }
    }

    ## Discard both sides (heap String payloads still RC-dropped).
    match asMsg(true) {
        Pass(_) { println("pass-disc") }
        Fail(_) { println("fail-disc") }
    }
    match asMsg(false) {
        Pass(_) { println("pass-disc") }
        Fail(_) { println("fail-disc") }
    }

    ## Bytes heap discard.
    match asBytes(true) {
        Pass(_) { println("bytes-ok") }
        Fail(_) { println("bytes-fail") }
    }
    match asBytes(false) {
        Pass(_) { println("bytes-ok") }
        Fail(_) { println("bytes-fail") }
    }

    ## User (Int64 field only) discard — exercises needs_drop && !is_heap Dup path.
    match asBox(3) {
        Pass(_) { println("box-ok") }
        Fail(_) { println("box-fail") }
    }
    match asBox(-1) {
        Pass(_) { println("box-ok") }
        Fail(_) { println("box-fail") }
    }

    0
}
