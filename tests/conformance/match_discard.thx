## Match discard binding `_` (D66): Fail(_) / Pass(_) do not introduce a name.
## Discarded heap payloads are still dropped at function end (RC).
## Pattern `_` only; body `_` is ordinary lookup (no outer `_` here).

import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import logging from "std/Logging"

type Box(n: Int64)

fn half(x: Int64) -> Trial<Int64, String> {
    if x % 2 == 0 {
        Pass(x / 2)
    } else {
        Fail("odd")
    }
}

fn asMsg(ok!: Bool) -> Trial<String, String> {
    if ok {
        Pass("ok")
    } else {
        Fail("err")
    }
}

fn asBytes(ok!: Bool) -> Trial<Bytes, String> {
    if ok {
        Pass(Bytes.fromString("ab"))
    } else {
        Fail("no-bytes")
    }
}

fn asBox(n!: Int64) -> Trial<Box, String> {
    if n < 0 {
        Fail("neg")
    } else {
        Pass(Box(n: n))
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    ## Bind ok, discard err payload.
    match half(20) {
        Pass(v) { logging.info("{v}") }
        Fail(_) { logging.info("fail-side") }
    }
    match half(7) {
        Pass(v) { logging.info("{v}") }
        Fail(_) { logging.info("x") }
    }

    ## Discard ok, bind err.
    match asMsg(false) {
        Pass(_) { logging.info("unexpected-pass") }
        Fail(e) { logging.info("{e}") }
    }

    ## Discard both sides (heap String payloads still RC-dropped).
    match asMsg(true) {
        Pass(_) { logging.info("pass-disc") }
        Fail(_) { logging.info("fail-disc") }
    }
    match asMsg(false) {
        Pass(_) { logging.info("pass-disc") }
        Fail(_) { logging.info("fail-disc") }
    }

    ## Bytes heap discard.
    match asBytes(true) {
        Pass(_) { logging.info("bytes-ok") }
        Fail(_) { logging.info("bytes-fail") }
    }
    match asBytes(false) {
        Pass(_) { logging.info("bytes-ok") }
        Fail(_) { logging.info("bytes-fail") }
    }

    ## User (Int64 field only) discard — exercises needs_drop && !is_heap Dup path.
    match asBox(3) {
        Pass(_) { logging.info("box-ok") }
        Fail(_) { logging.info("box-fail") }
    }
    match asBox(-1) {
        Pass(_) { logging.info("box-ok") }
        Fail(_) { logging.info("box-fail") }
    }

    0
}
