## Net Fail messages include strerror (errno polish, Io-style D80).
import { createSocket } from "std/net"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match createSocket() {
        Fail(e) {
            logging.info("create-fail={e}")
        }
        Pass(first) {
            if first.isOpen() {
                logging.info("first-open")
            } else {
                logging.info("first-already-closed")
            }
            first.close()
            if first.isOpen() {
                logging.info("still-open")
            } else {
                logging.info("first-closed")
            }
            ## Double-close must not close a later socket that reused the fd.
            match createSocket() {
                Fail(e) {
                    logging.info("second-create-fail={e}")
                }
                Pass(second) {
                    first.close()
                    if first.isOpen() {
                        logging.info("first-reopened")
                    } else {
                        logging.info("double-close-ok")
                    }
                    match second.bind(0) {
                        Pass(_) {
                            logging.info("second-bind-ok")
                        }
                        Fail(e) {
                            logging.info("second-bind-fail={e}")
                        }
                    }
                    second.close()
                }
            }
            ## Operations on a closed fd should Fail with "…: Bad file descriptor".
            match first.bind(0) {
                Pass(_) {
                    logging.info("unexpected-bind-ok")
                }
                Fail(e) {
                    logging.info("closed-bind={e}")
                }
            }
            match first.listen(1) {
                Pass(_) {
                    logging.info("unexpected-listen-ok")
                }
                Fail(e) {
                    logging.info("closed-listen={e}")
                }
            }
        }
    }
    0
}
