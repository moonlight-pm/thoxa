## Generic products + generic unions with monomorphization (D118 prelude path).
import logging from "std/Logging"
type Box<T>(value: T)
type Empty
type Opt<T> = Box<T!> | Empty?
type Msg<T> = Box<T!> | Empty?

fn chain(o!: Opt<Int64>) -> Opt<Int64> {
    let n = o?
    let x: Opt<Int64> = Box(value: n + 1)
    x
}

fn label(o!: Opt<Int64>) -> String {
    match o {
        Box(n) { "box={n}" }
        Empty { "empty" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Opt<Int64> = Box(value: 7)
    logging.info("{label(a)}")
    match chain(Box(value: 10)) {
        Box(n) { logging.info("ch={n}") }
        Empty { logging.info("empty") }
    }
    match chain(Empty()) {
        Box(n) { logging.info("ch={n}") }
        Empty { logging.info("empty") }
    }
    let m: Msg<String> = Box(value: "hi")
    match m {
        Box(s) { logging.info("s={s}") }
        Empty { logging.info("empty") }
    }
    0
}
