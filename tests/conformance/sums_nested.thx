## Nested union aliases flatten (D118).
import logging from "std/Logging"
type A
type B
type Inner = A | B
type C
type Outer = Inner | C

fn label(o!: Outer) -> String {
    match o {
        A { "a" }
        B { "b" }
        C { "c" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    logging.info("{label(A())}")
    logging.info("{label(B())}")
    logging.info("{label(C())}")
    ## Inject nested sum value into outer (subset remap)
    let i: Inner = A()
    let o: Outer = i
    logging.info("{label(o)}")
    let i2: Inner = B()
    logging.info("{label(i2)}")
    0
}
