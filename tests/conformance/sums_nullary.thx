## Nullary union types (D118 ladder step 1–2).
import logging from "std/Logging"
type Up
type Down
type Left
type Right
type Dir = Up | Down | Left | Right

fn label(d!: Dir) -> String {
    match d {
        Up { "up" }
        Down { "down" }
        Left { "left" }
        Right { "right" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Dir = Up()
    let b: Dir = Down()
    logging.info("{label(a)}")
    logging.info("{label(b)}")
    logging.info("{label(Left())}")
    logging.info("{label(Right())}")
    ## Exhaustive match expression value
    let s = match a {
        Up { 1 }
        Down { 2 }
        Left { 3 }
        Right { 4 }
    }
    logging.info("{s}")
    0
}
