## if/else-if as an expression, inclusive ranges, and a for loop: FizzBuzz 1..=15.
import logging from "std/logging"
fn label(n!: Int64) -> String {
    if n % 15 == 0 { "FizzBuzz" }
    else if n % 3 == 0 { "Fizz" }
    else if n % 5 == 0 { "Buzz" }
    else { "{n}" }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    for i in 1..=15 {
        logging.info("{label(i)}")
    }
    0
}
