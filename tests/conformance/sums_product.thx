## Multi-field product union members (D118).
import logging from "std/logging"
type Circle(radius: Int64)
type Rect(w: Int64, h: Int64)
type Shape = Circle | Rect

fn area(s!: Shape) -> Int64 {
    match s {
        Circle(r) { r * r }
        Rect(w, h) { w * h }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let c: Shape = Circle(radius: 3)
    let r: Shape = Rect(w: 4, h: 5)
    logging.info("{area(c)}")
    logging.info("{area(r)}")
    match r {
        Circle(r) { logging.info("c={r}") }
        Rect(w, h) { logging.info("rect={w}x{h}") }
    }
    0
}
