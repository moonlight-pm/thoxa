## File I/O — `readFile` via std/Io (D126; errno/OpenMode polish).
import { readFile, oRdonly } from "std/io"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import logging from "std/logging"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    ## OpenMode constant is exported (Linux O_RDONLY == 0).
    logging.info("oRdonly={oRdonly}")

    ## Happy path: whole-file read of a checked-in fixture (cwd = workspace root).
    match readFile("tests/conformance/io_data/sample.txt") {
        Pass(body) {
            logging.info("body={body.toString()}")
            logging.info("count={body.count}")
        }
        Fail(e) {
            logging.info("read-fail={e}")
        }
    }

    ## Missing file → Fail with path + strerror (ENOENT).
    match readFile("tests/conformance/io_data/does-not-exist.txt") {
        Pass(body) {
            logging.info("unexpected={body.count}")
        }
        Fail(e) {
            logging.info("missing={e}")
        }
    }

    ## Second successful read (no leftover fd / RC corruption).
    match readFile("tests/conformance/io_data/sample.txt") {
        Pass(body) {
            logging.info("again={body.toString()}")
        }
        Fail(e) {
            logging.info("again-fail={e}")
        }
    }
    0
}
