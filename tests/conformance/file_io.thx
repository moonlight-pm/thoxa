## File I/O — `readFile` via iolib/Io (R9+; PR9 errno/OpenMode polish).
import { readFile, oRdonly } from "./iolib/Io"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"

fn main() -> Int64 {
    ## OpenMode constant is exported (Linux O_RDONLY == 0).
    println("oRdonly={oRdonly}")

    ## Happy path: whole-file read of a checked-in fixture (cwd = workspace root).
    match readFile("tests/conformance/io_data/sample.txt") {
        Pass(body) {
            println("body={body.toString()}")
            println("count={body.count}")
        }
        Fail(e) {
            println("read-fail={e}")
        }
    }

    ## Missing file → Fail with path + strerror (ENOENT).
    match readFile("tests/conformance/io_data/does-not-exist.txt") {
        Pass(body) {
            println("unexpected={body.count}")
        }
        Fail(e) {
            println("missing={e}")
        }
    }

    ## Second successful read (no leftover fd / RC corruption).
    match readFile("tests/conformance/io_data/sample.txt") {
        Pass(body) {
            println("again={body.toString()}")
        }
        Fail(e) {
            println("again-fail={e}")
        }
    }
    0
}
