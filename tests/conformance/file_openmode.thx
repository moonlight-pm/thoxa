## OpenMode union (D81 polish): nullary access modes + openModeBits → openFile.
import { OpenMode, Rdonly, Wronly, Rdwr, openModeBits, openFile, oRdonly } from "./iolib/Io"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import logging from "std/Logging"

fn label(m!: OpenMode) -> String {
    match m {
        Rdonly { "rdonly" }
        Wronly { "wronly" }
        Rdwr { "rdwr" }
    }
}

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let r: OpenMode = Rdonly()
    let w: OpenMode = Wronly()
    let rw: OpenMode = Rdwr()
    logging.info("{label(r)}")
    logging.info("{label(w)}")
    logging.info("{label(rw)}")
    logging.info("bits={openModeBits(r)}/{openModeBits(w)}/{openModeBits(rw)}")
    ## Same numeric value as the Int32 flag constant.
    logging.info("eq={openModeBits(Rdonly()) == oRdonly}")

    match openFile("tests/conformance/io_data/sample.txt", openModeBits(Rdonly())) {
        Fail(e) {
            logging.info("open-fail={e}")
        }
        Pass(f) {
            match f.readAll() {
                Fail(e) {
                    f.close()
                    logging.info("read-fail={e}")
                }
                Pass(body) {
                    f.close()
                    logging.info("body={body.toString()}")
                }
            }
        }
    }
    0
}
