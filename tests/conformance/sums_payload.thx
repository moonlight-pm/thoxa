## Union with one-field product members (D118).
import logging from "std/logging"
type Empty
type Hold(n: Int64)
type Slot = Empty | Hold

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a: Slot = Empty()
    match a {
        Empty { logging.info("empty") }
        Hold(n) { logging.info("hold={n}") }
    }
    let b: Slot = Hold(n: 42)
    match b {
        Empty { logging.info("empty") }
        Hold(n) { logging.info("hold={n}") }
    }
    ## Inject via call
    logging.info("{describe(Hold(n: 7))}")
    logging.info("{describe(Empty())}")
    0
}

fn describe(s!: Slot) -> String {
    match s {
        Empty { "none" }
        Hold(n) { "n={n}" }
    }
}
