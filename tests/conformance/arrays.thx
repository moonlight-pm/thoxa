## Array literals, indexing, methods, index-assignment on a mutable binding, iteration.
import logging from "std/Logging"
fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let xs = [10, 20, 30]
    logging.info("count={xs.count} first={xs[0]} last={xs[2]}")
    logging.info("appended={xs.append(40)}")
    logging.info("dropped={xs.dropLast()}")
    mut ys = [1, 2, 3]
    ys[1] = 99
    logging.info("mutated={ys}")
    mut total = 0
    for x in xs { total = total + x }
    logging.info("sum={total}")
    0
}
