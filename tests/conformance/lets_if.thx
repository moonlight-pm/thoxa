## let bindings and if/else as an expression.
import logging from "std/logging"
fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    let a = 7
    let b = 3
    let sum = a + b
    logging.info("{sum}")
    let pick = if a > b { a } else { b }
    logging.info("{pick}")
    let label = if sum == 10 { 1 } else { 0 }
    logging.info("{label}")
    0
}
