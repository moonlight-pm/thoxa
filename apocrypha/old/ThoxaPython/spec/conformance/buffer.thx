## Buffer — a growable, value-semantic byte buffer: the prototype's model of a
## systems `Vec<u8>`. Geometric growth (an explicit capacity + reallocation), copy-
## on-write when a buffer is shared (mutate-in-place only when unique), and `freeze`
## to a fixed, FFI-safe `Bytes`. See docs/specs/2026-07-15-thoxa-growable-buffer-design.md.

## A buffer passed into a function is shared, so mutating it here copies-on-write —
## the caller's buffer is untouched. Value semantics, not reference.
fn grown(seed!: Buffer) -> Int64 {
    seed.append(0)
    seed.count
}

fn main() -> Int64 {
    ## Geometric growth: capacity doubles (0 -> 8 -> 16 -> 32) as bytes are appended.
    mut b = Buffer()
    println("empty: count={b.count} cap={b.capacity}")
    mut i = 0
    while i < 20 {
        b.append(65)
        i = i + 1
    }
    println("grown: count={b.count} cap={b.capacity}")

    ## Copy-on-write: `two` aliases `one`; mutating `one` must not touch `two`.
    mut one = Buffer()
    one.append(1)
    one.append(2)
    let two = one
    one.append(3)
    println("cow: one={one.count} two={two.count}")

    ## Value semantics across a call: `grown` mutates its own copy.
    mut c = Buffer()
    c.append(9)
    let inner = grown(c)
    println("call: inner={inner} caller={c.count}")

    ## appendBytes concatenates fixed Bytes; freeze hands back an FFI-safe Bytes.
    mut msg = Buffer()
    msg.appendBytes(Bytes.fromString("Hello, "))
    msg.appendBytes(Bytes.fromString("Thoxa!"))
    let frozen = msg.freeze()
    println("frozen: count={frozen.count} text={frozen.toString()}")
    0
}
