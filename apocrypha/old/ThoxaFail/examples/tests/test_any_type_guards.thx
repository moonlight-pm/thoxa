# Test type guards with Any type

let x: Any = 42;
let y: Any = "hello";

# Test type guard on x (should be Int64)
if x is Int64 {
    @print(1);  # Should print
} else {
    @print(0);
};
@printStr("\n");

# Test type guard on y (should be String) 
if y is String {
    @print(1);  # Should print
} else {
    @print(0);
};
@printStr("\n");

# Test negative case
if x is String {
    @print(1);
} else {
    @print(0);  # Should print
};
@printStr("\n");

0