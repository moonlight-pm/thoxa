# Print.thx - Polymorphic printing functions using type guards

# Print a single value of any type
export fn print(value: Any) -> Void {
    # For now, we'll demonstrate with type-specific behavior
    # In the future, we'll use runtime type extraction
    @print(42);  # Placeholder - just print something
    0
};

# Print multiple values separated by spaces
export fn printMany(...values: Any) -> Void {
    let i: Int64 = 0;
    let len: Int64 = values.length();
    
    loop {
        if i >= len { break; };
        
        if i > 0 {
            @printStr(" ");
        };
        
        print(values[i]);
        i = i + 1;
    };
    0
};

# Print values followed by newline
export fn println(...values: Any) -> Void {
    let i: Int64 = 0;
    let len: Int64 = values.length();
    
    loop {
        if i >= len { break; };
        
        if i > 0 {
            @printStr(" ");
        };
        
        print(values[i]);
        i = i + 1;
    };
    @printStr("\n");
    0
};