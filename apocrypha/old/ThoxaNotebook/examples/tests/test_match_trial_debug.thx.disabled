
fn divide(a: Int, b: Int) -> Trial {
    if b == 0 {
        Fail("Division by zero")
    } else {
        Pass(a / b)
    }
}

fn main() -> Int {
    let result = divide(10, 2);
    
    match result {
        Pass(value) -> { 
            println("Got Pass with value");
            5  
        },
        Fail(msg) -> { 
            println("Got Fail");
            99  
        }
    }
}