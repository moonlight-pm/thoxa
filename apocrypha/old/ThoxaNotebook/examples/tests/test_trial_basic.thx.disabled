
fn divideByTwo(n: Int) -> Trial<Int, String> {
    Pass(n / 2)
}

fn divideWithCheck(a: Int, b: Int) -> Trial<Int, String> {
    if b == 0 {
        Fail("Division by zero")
    } else {
        Pass(a / b)
    }
}

fn main() -> Int {
    mut passed = 0;
    mut failed = 0;
    
    let success = Pass(42);
    passed = passed + 1;  
    
    let failure = Fail("error message");
    passed = passed + 1;  
    
    let result1 = divideByTwo(10);
    passed = passed + 1;  
    
    let result2 = divideWithCheck(20, 5);
    passed = passed + 1;  
    
    let result3 = divideWithCheck(10, 0);
    passed = passed + 1;  
    
    print("Trial basic tests: ");
    printInt(passed);
    print(" passed, ");
    printInt(failed);
    println(" failed");
    
    println("Note: Pattern matching on Trial is broken, so we can only test construction");
    
    failed
}