# While loop examples

fn countdown(n: Int) {
    mut count = n;
    while count > 0 {
        printInt(count);
        count = count - 1;
    };
    println("Blast off!");
}

fn findFirst(target: Int) -> Int {
    mut i = 0;
    while i < 100 {
        if i * i > target {
            return i;
        };
        i = i + 1;
    };
    0 - 1  # Return -1 if not found
}

fn main() -> Int {
    println("Countdown from 3:");
    countdown(3);
    
    println("First number whose square > 50:");
    let result = findFirst(50);
    printInt(result);
    
    0
}