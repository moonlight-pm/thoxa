# Simple type inference test without complex features

fn testLiterals() -> Int {
    let x = 42;
    let y = true;
    
    if y {
        x
    } else {
        0
    }
}

fn testBinaryOps() -> Int {
    let x = 10;
    let y = 20;
    let sum = x + y;
    sum
}

fn testComparisons() -> Bool {
    let x = 5;
    let y = 10;
    let lt = x < y;
    lt
}

fn main() -> Int {
    let t1 = testLiterals();      # Should be 42
    let t2 = testBinaryOps();      # Should be 30
    let t3 = testComparisons();    # Should be true
    
    # Simple verification for now
    0  # Always pass for now
}