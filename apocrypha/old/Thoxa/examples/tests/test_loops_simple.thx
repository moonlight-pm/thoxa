
fn main() -> Int {
    mut counter = 0;
    loop {
        counter = counter + 1;
        if counter >= 3 {
            break;
        }
    };
    
    print("Loop count: ");
    printInt(counter);
    println("");
    
    mut i = 0;
    while i < 3 {
        i = i + 1;
    };
    
    print("While count: ");
    printInt(i);
    println("");
    
    0
}