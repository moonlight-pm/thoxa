
fn divide(a: Int, b: Int) -> Trial {
    if b == 0 {
        Fail("Division by zero")
    } else {
        Pass(a / b)
    }
}

fn testPass() -> Int {
    let result = divide(10, 2);
    match result {
        Pass(v) -> { 1 },  
        Fail(e) -> { 0 }   
    }
}

fn testFail() -> Int {
    let result = divide(10, 0);
    match result {
        Pass(v) -> { 0 },  
        Fail(e) -> { 1 }   
    }
}

fn main() -> Int {
    let test1 = testPass();
    let test2 = testFail();
    
    if test1 == 1 {
        if test2 == 1 {
            println("All tests passed!");
            0  
        } else {
            println("Test 2 failed");
            2
        }
    } else {
        println("Test 1 failed");
        1
    }
}