{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Thoxa",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#characters"},
    {"include": "#numbers"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#functions"},
    {"include": "#operators"},
    {"include": "#punctuation"}
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.thoxa",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.thoxa",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.thoxa",
          "match": "\\\\."
        },
        {
          "name": "variable.other.thoxa",
          "match": "\\{[^}]+\\}"
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.thoxa",
      "match": "'([^'\\\\]|\\\\.)?'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.thoxa",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.thoxa",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.thoxa",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?[fd]?\\b"
        },
        {
          "name": "constant.numeric.integer.thoxa",
          "match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|u8|u16|u32|u64|u)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.thoxa",
          "match": "\\b(if|else|loop|while|for|break|continue|return|match)\\b"
        },
        {
          "name": "keyword.other.thoxa",
          "match": "\\b(fn|type|interface|let|mut|import|export|from|as)\\b"
        },
        {
          "name": "keyword.operator.logical.thoxa",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.thoxa",
          "match": "\\b(true|false|Void)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.thoxa",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|UInt|UInt8|UInt16|UInt32|UInt64|Float|Float32|Float64|Bool|Char|String|Byte|Any|Ptr|Array|Option|Trial)\\b"
        },
        {
          "name": "entity.name.type.thoxa",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.thoxa",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {"name": "keyword.other.fn.thoxa"},
            "2": {"name": "entity.name.function.thoxa"}
          }
        },
        {
          "name": "support.function.builtin.thoxa",
          "match": "\\b(print|println|Value|Pass|Fail)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.thoxa",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.thoxa",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.thoxa",
          "match": "="
        },
        {
          "name": "keyword.operator.question.thoxa",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arrow.thoxa",
          "match": "->"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.thoxa",
          "match": "[,;]"
        },
        {
          "name": "punctuation.brackets.thoxa",
          "match": "[\\[\\]\\(\\)\\{\\}]"
        },
        {
          "name": "punctuation.accessor.thoxa",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.generic.thoxa",
          "match": "[<>]"
        }
      ]
    }
  },
  "scopeName": "source.thoxa"
}