# thoxa.moonlight.pm landing.
#
# The image builds the compiler, emits the site's C, and compiles that C with
# thoxa_rt, so an image built from a commit runs that commit's Thoxa (no host
# emit-c step). Both bases are pinned by digest; the final stage installs
# nothing. The server runs as nobody and, as PID 1, ends on SIGTERM (D170).
#
#   podman build -f workloads/landing/Containerfile \
#     --ignorefile workloads/landing/.containerignore \
#     -t registry.wicket.cloud/thoxa-landing:latest .
#
# Wicket injects PORT / WICKET_PORT_HTTP.
#   podman run --rm -p 8080:8080 thoxa-landing:latest

FROM docker.io/library/rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo .cargo
COPY crates crates
COPY runtime runtime
COPY std std
RUN cargo build --release --locked -p thoxa
# Same flags as the thoxa driver: -fwrapv makes Int64 overflow wrap (D157).
RUN gcc -std=c11 -O2 -fwrapv -fPIC -c runtime/src/thoxa_rt.c -I runtime/include -o thoxa_rt.o
COPY workloads/landing workloads/landing
RUN target/rust/release/thoxa emit-c workloads/landing \
 && gcc -std=c11 -O2 -fwrapv target/thoxa/c/landing.c thoxa_rt.o -I runtime/include -lm -o /landing

FROM docker.io/library/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
COPY --from=build /landing /usr/local/bin/landing
COPY workloads/landing/web /app/web
# The manual page renders the handbook, and the home page shows the samples,
# both read at request time.
COPY docs/handbook /app/manual
COPY workloads/landing/samples /app/samples
RUN chmod 0755 /usr/local /usr/local/bin /usr/local/bin/landing
USER 65534:65534
ENV THOXA_PORT=8080
ENV THOXA_STATIC=/app/web
ENV THOXA_MANUAL=/app/manual
ENV THOXA_SAMPLES=/app/samples
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/landing"]
