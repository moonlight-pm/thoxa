#!/bin/sh
set -eu
# cell:thoxa-landing: thoxa.moonlight.pm, built as the Containerfile builds it
# (the compiler, the site's C, that C with thoxa_rt), but linked static, so it
# runs on nothing but itself.
#
#   bin/thoxa-landing   starts it; THOXA_* default to the folders beside it
#   libexec/landing     the server
#   web/ manual/ samples/  read at request time
SRC=/oath/store/cell/thoxa-landing-src/sha256-d0440d66bb62ac5d9c91b553b1e691ddf5e719cd3c08192f43530f17b5197795
export CC=cc HOME=/tmp/home CARGO_HOME=/tmp/cargo SOURCE_DATE_EPOCH=0
mkdir -p "$HOME" "$CARGO_HOME"
cat >"$CARGO_HOME/config.toml" <<EOF
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "$SRC/vendor"
EOF
cp -R "$SRC/src" /tmp/thoxa
chmod -R u+w /tmp/thoxa
cd /tmp/thoxa
cargo build --release --frozen -p thoxa
# Same flags as the thoxa driver: -fwrapv makes Int64 overflow wrap (D157).
cc -std=c11 -O2 -fwrapv -c runtime/src/thoxa_rt.c -I runtime/include -o /tmp/thoxa_rt.o
target/rust/release/thoxa emit-c workloads/landing
mkdir -p /out/bin /out/libexec
cc -std=c11 -O2 -fwrapv -static target/thoxa/c/landing.c /tmp/thoxa_rt.o \
	-I runtime/include -lm -o /out/libexec/landing
if readelf -lW /out/libexec/landing | grep -q INTERP; then
	echo "landing is dynamically linked; it must be static" >&2
	exit 1
fi
cp -R workloads/landing/web /out/web
cp -R docs/handbook /out/manual
cp -R workloads/landing/samples /out/samples

cat >/out/bin/thoxa-landing <<'EOF'
#!/bin/sh
# Wicket gives PORT; THOXA_PORT is the fallback the server reads after it.
here=/oath/store/cell/thoxa-landing/live
export THOXA_STATIC="${THOXA_STATIC:-$here/web}"
export THOXA_MANUAL="${THOXA_MANUAL:-$here/manual}"
export THOXA_SAMPLES="${THOXA_SAMPLES:-$here/samples}"
exec "$here/libexec/landing" "$@"
EOF
chmod 0755 /out/bin/thoxa-landing
