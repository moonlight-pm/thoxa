## GET / and the not-found page.

import { Page } from "~/app/ui/page"
import samples from "./samples"
import http, { Request, Response } from "std/http"

export fn page(request!: Request) -> Response {
    http.htmlResponse(
        <Page title="Thoxa" request={request}>
            {hero()}
            {now()}
            {example()}
            {surface()}
        </Page>
    )
}

export fn missing(request!: Request) -> Response {
    http.htmlResponseStatus(
        404,
        "Not Found",
        <Page title="Not found · Thoxa" request={request}>
            <section class="panel">
                <h1>No such page</h1>
                <p class="lede">That path is not on this site.</p>
                <p><a class="btn" href="/">Back to Thoxa</a></p>
            </section>
        </Page>
    )
}

fn hero() -> Node {
    <section class="hero">
        <div class="hero-copy">
            <ul class="chips" aria-label="Status">
                <li>Pre-alpha</li>
                <li>Linux</li>
                <li>Native</li>
            </ul>
            <h1>A systems language with a shell</h1>
            <p class="lede">
                Expression-oriented, errors as values, a hybrid layout. Run
                <code>thoxa</code> with no file and you get a prompt: that prompt is
                Thoxa, not a second language. <code>thoxa run</code>,
                <code>thoxa check</code>, and <code>thoxa lsp</code> are the tools.
            </p>
            <p class="hero-actions">
                <a class="btn" href="#example">See the language</a>
            </p>
        </div>
    </section>
}

fn now() -> Node {
    <section class="section" id="now">
        <div class="section-inner">
            <h2>Where it is aimed, and where it is</h2>
            <div class="now-grid">
                <div>
                    <h3>Aimed at</h3>
                    <p>
                        A systems language with a serious type system and one
                        value model from the shell to the metal. You write <code>.thx</code>
                        files. <code>thoxa run</code>, <code>thoxa check</code>, and
                        <code>thoxa lsp</code> are the surface — when there is a
                        public build, those are the names.
                    </p>
                </div>
                <div>
                    <h3>Shipped today</h3>
                    <p>
                        The interactive prompt is Thoxa, not a separate dialect.
                        <code>thoxa run</code> produces a native binary.
                        <code>std/</code> has files, sockets, HTTP, JSON, and SQLite,
                        grown from samples. Heap is simple single-threaded RC.
                        Linux x86_64 only. Windows is out of scope.
                    </p>
                </div>
            </div>
        </div>
    </section>
}

fn example() -> Node {
    <section class="section alt" id="example">
        <div class="section-inner">
            <h2>What a program looks like</h2>
            <p class="lede">
                A few slices. Layout is hybrid — a <code>Point</code> is two integers,
                not two heap boxes. Errors are values. Match takes sums apart.
                Logging is <code>info</code>; there is no ambient <code>println</code>.
            </p>
            {samples.window()}
        </div>
    </section>
}

type Feature(label: String, title: String, body: String)

fn surfaceItems() -> Array<Feature> {
    [
        Feature(
            label: "Native",
            title: "A binary, not a VM",
            body: "thoxa run produces a real program. Not a bytecode VM, not a tree-walk interpreter."
        ),
        Feature(
            label: "Types",
            title: "Sums, clauses, match",
            body: "User types, tagged unions, literal types, and multi-clause functions. Match is how you take them apart — including guards and or-patterns."
        ),
        Feature(
            label: "Errors",
            title: "Values, not exceptions",
            body: "Trial and May live in std/fallible. ? unwraps a success. Fail and Not stay in the type. You import them; they are not ambient."
        ),
        Feature(
            label: "Prompt",
            title: "Interactive Thoxa",
            body: "Run thoxa with no file and you get a prompt. That prompt is Thoxa — the same syntax as a .thx file — not a separate scripting dialect."
        ),
        Feature(
            label: "Interop",
            title: "Talk to C",
            body: "extern fn … from \"c\" calls libc and your own symbols. Same language, no wrapper dialect."
        ),
        Feature(
            label: "Editor",
            title: "Check and hover",
            body: "thoxa check and thoxa lsp. Hover shows types. The editor talks to the same compiler that runs your program."
        ),
    ]
}

fn featureRow(item!: Feature) -> Node {
    <article class="feature">
        <p class="feature-label">{item.label}</p>
        <div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
        </div>
    </article>
}

fn surface() -> Node {
    <section class="section" id="surface">
        <div class="section-inner surface-wrap">
            <div>
                <h2>What systems programmers look for</h2>
                <p class="lede">
                    The type system is the point, not a garnish. Layout is hybrid —
                    scalars stay scalars. RC is simple and single-threaded today;
                    a smarter heap is later work, not a claim.
                </p>
                <div class="features">
                    {for item in surfaceItems() { featureRow(item) }}
                </div>
            </div>
            <figure class="mosaic" aria-hidden="true">
                <img src="/mosaic-types.jpg" width="480" height="480" alt="" />
            </figure>
        </div>
    </section>
}
