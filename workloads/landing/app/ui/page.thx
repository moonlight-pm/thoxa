## HTML shell for thoxa.dev.

import http, { Request } from "std/http"

export let repository = "https://github.com/moonlight-pm/thoxa"

## `current` names the page the navigation marks (`home`, `manual`).
export type Page(title: String, request: Request, current: String = "") {
    export fn view(children: Array<Node>) -> Node {
        <html lang="en">
            <head>
                <meta charset="utf-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1" />
                <title>{title}</title>
                <meta name="description" content="Thoxa is a statically typed, expression-oriented programming language. The compiler emits C; programs are native executables. Pre-alpha, Linux x86-64." />
                <link rel="icon" href="/favicon.png" type="image/png" />
                <link rel="preconnect" href="https://fonts.googleapis.com" />
                <link rel="preconnect" href="https://fonts.gstatic.com" />
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" />
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&text=Thoxa&display=swap" />
                <link rel="stylesheet" href="/style.css" />
            </head>
            <body>
                <header class="site">
                    <nav aria-label="Site">
                        <a class="brand" href="/">
                            <img src="/medallion.png" width="28" height="28" alt="" />
                            <span>Thoxa</span>
                        </a>
                        <a class={marked(current, "manual")} href="/manual">Manual</a>
                        <a href={repository}>Source</a>
                    </nav>
                </header>
                {children}
                <footer class="site">
                    <p>
                        Thoxa is pre-alpha. Source and issues:
                        <a href={repository}>github.com/moonlight-pm/thoxa</a>. This site is a
                        Thoxa program in <a href={"{repository}/tree/master/workloads/landing"}>workloads/landing</a>.
                    </p>
                </footer>
            </body>
        </html>
    }
}

fn marked(current!: String, name!: String) -> String {
    if current == name {
        "current"
    } else {
        ""
    }
}
