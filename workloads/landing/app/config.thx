## Process env for the landing container.
##
## Listen (first set wins):
##   PORT                Wicket-assigned (preferred)
##   WICKET_PORT_HTTP    Wicket named port `http`
##   THOXA_PORT          local / image default (8088 locally; image 8080)
##
##   THOXA_STATIC        asset root (default workloads/landing/web)
##   THOXA_MANUAL        manual chapters (default docs/handbook)
##   THOXA_SAMPLES       home page samples (default workloads/landing/samples)

import env, { getenvOr } from "std/env"
import { Has, Not, May } from "std/fallible"
import { parseUInt, isEmpty } from "std/str"

export fn listenPort() -> Int64 {
    match portFromEnv("PORT") {
        Has(n) => n
        Not {
            match portFromEnv("WICKET_PORT_HTTP") {
                Has(n) => n
                Not {
                    match portFromEnv("THOXA_PORT") {
                        Has(n) => n
                        Not => 8088
                    }
                }
            }
        }
    }
}

fn portFromEnv(name!: String) -> May<Int64> {
    match parseUInt(env.getenv(name)) {
        Not => Not()
        Has(n) {
            if n > 0 {
                if n < 65536 {
                    Has(n)
                } else {
                    Not()
                }
            } else {
                Not()
            }
        }
    }
}

export fn staticRoot() -> String {
    directory("THOXA_STATIC", "workloads/landing/web")
}

export fn manualRoot() -> String {
    directory("THOXA_MANUAL", "docs/handbook")
}

export fn samplesRoot() -> String {
    directory("THOXA_SAMPLES", "workloads/landing/samples")
}

## A directory from the environment; unset or empty means `fallback`, which
## is relative to the workspace root (where `cargo make run` starts).
fn directory(name!: String, fallback!: String) -> String {
    let root = getenvOr(name, fallback)
    if isEmpty(root) {
        fallback
    } else {
        root
    }
}
