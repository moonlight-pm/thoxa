## Markdown → Node, for the manual (docs/handbook/*.md).
##
## Covers the subset the handbook keeps to: ATX headings, paragraphs, `-` and
## `1.` lists (nested by indentation), fenced code, pipe tables, blockquotes,
## and inline code, bold, italic, and links. A link to another chapter becomes
## an anchor on the manual page; any other relative link goes to the
## repository.

import highlight from "./highlight"
import { Has, Not, May } from "std/fallible"
import { Split, splitOnce } from "std/str"

let repository = "https://github.com/moonlight-pm/thoxa/"

let space = 32
let star = 42
let leftParen = 40
let rightParen = 41
let backslash = 92
let leftBracket = 91
let rightBracket = 93
let backtick = 96
let pipe = 124

## A heading as the contents and the anchors see it. `number` is empty below
## the third level.
export type Heading(level: Int64, id: String, number: String, title: String)

## How one chapter's links resolve: its name, the names of all chapters, its
## directory in the repository (`docs/handbook`), and the page the chapters
## are on (`""` on the manual itself, `"/manual"` elsewhere).
export type Chapter(name: String, chapters: Array<String>, directory: String, page: String)

## One block and the line after it.
type Parsed(node: Node, next: Int64)

## Every heading in `text`, numbered from `number` (the chapter's).
export fn headings(text!: String, chapter!: Chapter, number!: Int64) -> Array<Heading> {
    mut found: Array<Heading> = []
    mut used: Map<String, Int64> = Map()
    mut section = 0
    mut subsection = 0
    mut fenced = false
    for line in text.lines() {
        if line.startsWith("```") {
            fenced = not fenced
        } else if not fenced and headingLevel(line) > 0 {
            let level = headingLevel(line)
            let title = line.substring(level + 1, line.count).trim()
            if level == 1 {
                found.append(Heading(level: 1, id: chapter.name, number: "{number}", title: title))
            } else {
                let base = slug(title)
                let seen = match used[base] {
                    Has(count) => count
                    Not => 0
                }
                used.set(base, seen + 1)
                let id = if seen == 0 { "{chapter.name}-{base}" } else { "{chapter.name}-{base}-{seen}" }
                if level == 2 {
                    section = section + 1
                    subsection = 0
                    found.append(Heading(level: 2, id: id, number: "{number}.{section}", title: title))
                } else if level == 3 {
                    subsection = subsection + 1
                    found.append(Heading(level: 3, id: id, number: "{number}.{section}.{subsection}", title: title))
                } else {
                    found.append(Heading(level: level, id: id, number: "", title: title))
                }
            }
        }
    }
    found
}

## `text` as nodes. `headings` must come from `headings(text, …)`.
export fn render(text!: String, chapter!: Chapter, headings!: Array<Heading>) -> Array<Node> {
    blocks(text.lines(), chapter, headings)
}

## A heading's title as inline nodes (for the contents).
export fn title(entry!: Heading, chapter!: Chapter) -> Array<Node> {
    inline(entry.title, chapter)
}

## One line of Markdown text (code, emphasis, links) as inline nodes.
export fn text(line!: String, chapter!: Chapter) -> Array<Node> {
    inline(line, chapter)
}

fn blocks(source!: Array<String>, chapter!: Chapter, headings!: Array<Heading>) -> Array<Node> {
    mut nodes: Array<Node> = []
    mut index = 0
    mut headingIndex = 0
    while index < source.count {
        let line = source[index]
        if isBlank(line) {
            index = index + 1
        } else if line.startsWith("```") {
            let parsed = fence(source, index)
            nodes.append(parsed.node)
            index = parsed.next
        } else if headingLevel(line) > 0 {
            if headingIndex < headings.count {
                nodes.append(heading(headings[headingIndex], chapter))
                headingIndex = headingIndex + 1
            }
            index = index + 1
        } else if line.startsWith("|") {
            let parsed = table(source, index, chapter)
            nodes.append(parsed.node)
            index = parsed.next
        } else if line.startsWith(">") {
            let parsed = quote(source, index, chapter)
            nodes.append(parsed.node)
            index = parsed.next
        } else if markerWidth(line) > 0 {
            let parsed = list(source, index, chapter)
            nodes.append(parsed.node)
            index = parsed.next
        } else {
            let parsed = paragraph(source, index, chapter)
            nodes.append(parsed.node)
            index = parsed.next
        }
    }
    nodes
}

## Chapter titles are `h2` on the page (the page's own title is the `h1`).
fn heading(entry!: Heading, chapter!: Chapter) -> Node {
    mut kids: Array<Node> = []
    if not entry.number.isEmpty() {
        kids.append(<span class="number">{entry.number}</span>)
    }
    for node in inline(entry.title, chapter) {
        kids.append(node)
    }
    kids.append(<a class="anchor" href={"#{entry.id}"} aria-label="Link to this section">§</a>)
    let level = if entry.level >= 5 { 6 } else { entry.level + 1 }
    Element(tag: "h{level}", attrs: [Attr(name: "id", value: entry.id)], kids: kids)
}

fn fence(source!: Array<String>, at!: Int64) -> Parsed {
    let language = source[at].removePrefix("```").trim()
    mut body: Array<String> = []
    mut index = at + 1
    while index < source.count and not source[index].trimStart().startsWith("```") {
        body.append(source[index])
        index = index + 1
    }
    let text = body.join("\n")
    let kind = if language.isEmpty() { "text" } else { language }
    Parsed(node: <pre class={"code lang-{kind}"}><code>{highlight.code(kind, text)}</code></pre>, next: index + 1)
}

fn table(source!: Array<String>, at!: Int64, chapter!: Chapter) -> Parsed {
    let header = cells(source[at])
    mut index = at + 1
    if index < source.count and isSeparatorRow(source[index]) {
        index = index + 1
    }
    mut rows: Array<Node> = []
    while index < source.count and source[index].startsWith("|") {
        let row = cells(source[index])
        rows.append(<tr>{for cell in row { <td>{inline(cell, chapter)}</td> }}</tr>)
        index = index + 1
    }
    let node = <div class="table-wrap">
        <table>
            <thead><tr>{for cell in header { <th>{inline(cell, chapter)}</th> }}</tr></thead>
            <tbody>{rows}</tbody>
        </table>
    </div>
    Parsed(node: node, next: index)
}

## A row's cells: split on `|` not written `\|`, then `\|` → `|`.
fn cells(line!: String) -> Array<String> {
    let source = Bytes.fromString(line.trim())
    mut found: Array<String> = []
    mut start = 1
    mut index = 1
    while index < source.count {
        if source.get(index) == pipe and source.get(index - 1) != backslash {
            found.append(cell(source, start, index))
            start = index + 1
        }
        index = index + 1
    }
    if start < source.count {
        found.append(cell(source, start, source.count))
    }
    found
}

fn cell(source!: Bytes, start!: Int64, stop!: Int64) -> String {
    let text = slice(source, start, stop)
    text.split("\\|").join("|").trim()
}

## `|---|:---|` and the like: only pipes, dashes, colons and spaces.
fn isSeparatorRow(line!: String) -> Bool {
    let source = Bytes.fromString(line.trim())
    mut dashes = 0
    mut index = 0
    while index < source.count {
        let byte = source.get(index)
        if byte == 45 {
            dashes = dashes + 1
        } else if byte != pipe and byte != 58 and byte != space {
            return false
        }
        index = index + 1
    }
    dashes > 0
}

fn quote(source!: Array<String>, at!: Int64, chapter!: Chapter) -> Parsed {
    mut inner: Array<String> = []
    mut index = at
    while index < source.count and source[index].startsWith(">") {
        inner.append(source[index].removePrefix(">").removePrefix(" "))
        index = index + 1
    }
    mut none: Array<Heading> = []
    Parsed(node: <blockquote>{blocks(inner, chapter, none)}</blockquote>, next: index)
}

## A list: items start at a marker; an item's other lines are indented to its
## text. A blank line stays inside an item when indented lines follow it.
fn list(source!: Array<String>, at!: Int64, chapter!: Chapter) -> Parsed {
    let ordered = isOrderedMarker(source[at])
    mut items: Array<Node> = []
    mut index = at
    while index < source.count and markerWidth(source[index]) > 0 and isOrderedMarker(source[index]) == ordered {
        let line = source[index]
        let width = markerWidth(line)
        let indent = spaces(width)
        mut body: Array<String> = []
        body.append(line.substring(width, line.count))
        index = index + 1
        while index < source.count {
            let next = source[index]
            if isBlank(next) {
                if index + 1 < source.count and source[index + 1].startsWith(indent) {
                    body.append("")
                    index = index + 1
                } else {
                    break
                }
            } else if next.startsWith(indent) {
                body.append(next.substring(width, next.count))
                index = index + 1
            } else {
                break
            }
        }
        items.append(<li>{item(body, chapter)}</li>)
        if index + 1 < source.count and isBlank(source[index]) and markerWidth(source[index + 1]) > 0 {
            index = index + 1
        }
    }
    let node = if ordered { <ol>{items}</ol> } else { <ul>{items}</ul> }
    Parsed(node: node, next: index)
}

## An item's first lines are its text (no `<p>`); what follows is blocks.
fn item(body!: Array<String>, chapter!: Chapter) -> Array<Node> {
    mut lead: Array<String> = []
    mut index = 0
    while index < body.count and not isBlank(body[index]) and (index == 0 or not startsBlock(body[index])) {
        lead.append(body[index].trim())
        index = index + 1
    }
    mut rest: Array<String> = []
    while index < body.count {
        rest.append(body[index])
        index = index + 1
    }
    mut nodes = inline(lead.join(" "), chapter)
    mut none: Array<Heading> = []
    for node in blocks(rest, chapter, none) {
        nodes.append(node)
    }
    nodes
}

fn paragraph(source!: Array<String>, at!: Int64, chapter!: Chapter) -> Parsed {
    mut parts: Array<String> = []
    mut index = at
    while index < source.count and not isBlank(source[index]) and (index == at or not startsBlock(source[index])) {
        parts.append(source[index].trim())
        index = index + 1
    }
    Parsed(node: <p>{inline(parts.join(" "), chapter)}</p>, next: index)
}

fn startsBlock(line!: String) -> Bool {
    line.startsWith("```") or headingLevel(line) > 0 or line.startsWith("|") or line.startsWith(">") or markerWidth(line) > 0
}

## `#` to `######` and a space.
fn headingLevel(line!: String) -> Int64 {
    let source = Bytes.fromString(line)
    mut count = 0
    while count < source.count and source.get(count) == 35 {
        count = count + 1
    }
    if count >= 1 and count <= 6 and count < source.count and source.get(count) == space {
        count
    } else {
        0
    }
}

## Width of a list marker and its space (`- ` is 2, `12. ` is 4), or 0.
fn markerWidth(line!: String) -> Int64 {
    if line.startsWith("- ") or line.startsWith("* ") {
        return 2
    }
    let source = Bytes.fromString(line)
    mut digits = 0
    while digits < source.count and source.get(digits) >= 48 and source.get(digits) <= 57 {
        digits = digits + 1
    }
    if digits > 0 and digits + 1 < source.count and source.get(digits) == 46 and source.get(digits + 1) == space {
        digits + 2
    } else {
        0
    }
}

fn isOrderedMarker(line!: String) -> Bool {
    not (line.startsWith("- ") or line.startsWith("* "))
}

## Inline spans: `code`, **bold**, *italic*, [links](target), `\` escapes.
fn inline(text!: String, chapter!: Chapter) -> Array<Node> {
    let source = Bytes.fromString(text)
    mut nodes: Array<Node> = []
    mut run = 0
    mut index = 0
    while index < source.count {
        let byte = source.get(index)
        let next: Int64 = if index + 1 < source.count { source.get(index + 1) } else { 0 }
        let before: Int64 = if index > 0 { source.get(index - 1) } else { space }
        if byte == backslash and isPunctuation(next) {
            if index > run {
                nodes.append(Text(s: slice(source, run, index)))
            }
            run = index + 1
            index = index + 2
        } else if byte == backtick {
            let ticks = runLength(source, index, backtick)
            let close = findRun(source, index + ticks, backtick, ticks)
            if close < 0 {
                index = index + ticks
            } else {
                if index > run {
                    nodes.append(Text(s: slice(source, run, index)))
                }
                nodes.append(<code>{codeText(slice(source, index + ticks, close))}</code>)
                index = close + ticks
                run = index
            }
        } else if byte == star and next == star {
            let close = findPair(source, index + 2)
            if close < 0 {
                index = index + 2
            } else {
                if index > run {
                    nodes.append(Text(s: slice(source, run, index)))
                }
                nodes.append(<strong>{inline(slice(source, index + 2, close), chapter)}</strong>)
                index = close + 2
                run = index
            }
        } else if byte == star and next != space and next != 0 and not isWordByte(before) {
            let close = findEmphasis(source, index + 1)
            if close < 0 {
                index = index + 1
            } else {
                if index > run {
                    nodes.append(Text(s: slice(source, run, index)))
                }
                nodes.append(<em>{inline(slice(source, index + 1, close), chapter)}</em>)
                index = close + 1
                run = index
            }
        } else if byte == leftBracket {
            let close = findLinkText(source, index)
            let opens = close > 0 and close + 1 < source.count and source.get(close + 1) == leftParen
            let stop = if opens { findByte(source, rightParen, close + 2) } else { 0 - 1 }
            if stop < 0 {
                index = index + 1
            } else {
                if index > run {
                    nodes.append(Text(s: slice(source, run, index)))
                }
                let label = slice(source, index + 1, close)
                let target = slice(source, close + 2, stop)
                nodes.append(<a href={href(target, chapter)}>{inline(label, chapter)}</a>)
                index = stop + 1
                run = index
            }
        } else {
            index = index + 1
        }
    }
    if source.count > run {
        nodes.append(Text(s: slice(source, run, source.count)))
    }
    nodes
}

## A link target as the page needs it: another chapter → its anchor here;
## a relative path → the file in the repository.
fn href(target!: String, chapter!: Chapter) -> String {
    if target.startsWith("http://") or target.startsWith("https://") or target.startsWith("mailto:") {
        return target
    }
    if target.startsWith("#") {
        return "{chapter.page}#{chapter.name}-{target.removePrefix("#")}"
    }
    let parts = match splitOnce(target, "#") {
        Has(found) => found
        Not => Split(before: target, after: "")
    }
    if parts.before.endsWith(".md") and not parts.before.contains("/") {
        let name = parts.before.removeSuffix(".md")
        for candidate in chapter.chapters {
            if candidate == name {
                if parts.after.isEmpty() {
                    return "{chapter.page}#{name}"
                }
                return "{chapter.page}#{name}-{parts.after}"
            }
        }
    }
    let file = resolve(chapter.directory, parts.before)
    let kind = if file.endsWith("/") { "tree" } else { "blob" }
    if parts.after.isEmpty() {
        "{repository}{kind}/master/{file}"
    } else {
        "{repository}{kind}/master/{file}#{parts.after}"
    }
}

## `directory` joined with `relative`, with `.` and `..` resolved. A trailing
## `/` is kept.
fn resolve(directory!: String, relative!: String) -> String {
    mut kept: Array<String> = []
    for segment in "{directory}/{relative}".split("/") {
        if segment == ".." {
            if kept.count > 0 {
                kept.dropLast()
            }
        } else if segment != "." and segment != "" {
            kept.append(segment)
        }
    }
    let joined = kept.join("/")
    if relative.endsWith("/") {
        "{joined}/"
    } else {
        joined
    }
}

## GitHub's heading anchors: lower case; letters, digits, `-` and `_` kept;
## spaces become `-`; everything else dropped.
fn slug(title!: String) -> String {
    let source = Bytes.fromString(title.toLower())
    mut out = Bytes(source.count)
    mut size = 0
    mut index = 0
    while index < source.count {
        let byte = source.get(index)
        if isWordByte(byte) or byte == 45 {
            out.set(size, byte)
            size = size + 1
        } else if byte == space {
            out.set(size, 45)
            size = size + 1
        }
        index = index + 1
    }
    slice(out, 0, size)
}

## CommonMark: one space is stripped from each end when both ends have one.
fn codeText(text!: String) -> String {
    if text.count > 2 and text.startsWith(" ") and text.endsWith(" ") {
        text.substring(1, text.count - 1)
    } else {
        text
    }
}

fn runLength(source!: Bytes, at!: Int64, byte!: Int64) -> Int64 {
    mut index = at
    while index < source.count and source.get(index) == byte {
        index = index + 1
    }
    index - at
}

## Start of the next run of exactly `count` copies of `byte`, or -1.
fn findRun(source!: Bytes, at!: Int64, byte!: Int64, count!: Int64) -> Int64 {
    mut index = at
    while index < source.count {
        if source.get(index) == byte {
            let size = runLength(source, index, byte)
            if size == count {
                return index
            }
            index = index + size
        } else {
            index = index + 1
        }
    }
    0 - 1
}

## The `**` that closes a bold span opened before `at`, or -1.
fn findPair(source!: Bytes, at!: Int64) -> Int64 {
    mut index = at
    while index + 1 < source.count {
        if source.get(index) == backtick {
            let ticks = runLength(source, index, backtick)
            let close = findRun(source, index + ticks, backtick, ticks)
            index = if close < 0 { index + ticks } else { close + ticks }
        } else if source.get(index) == star and source.get(index + 1) == star {
            return index
        } else {
            index = index + 1
        }
    }
    0 - 1
}

## A single `*` after text that is not a space, not part of `**`, or -1.
fn findEmphasis(source!: Bytes, at!: Int64) -> Int64 {
    mut index = at
    while index < source.count {
        let byte = source.get(index)
        if byte == backtick {
            let ticks = runLength(source, index, backtick)
            let close = findRun(source, index + ticks, backtick, ticks)
            index = if close < 0 { index + ticks } else { close + ticks }
        } else if byte == star {
            let doubled = index + 1 < source.count and source.get(index + 1) == star
            if not doubled and source.get(index - 1) != space {
                return index
            }
            index = if doubled { index + 2 } else { index + 1 }
        } else {
            index = index + 1
        }
    }
    0 - 1
}

## The `]` that closes the `[` at `at` (brackets nest; code spans skipped), or -1.
fn findLinkText(source!: Bytes, at!: Int64) -> Int64 {
    mut depth = 0
    mut index = at
    while index < source.count {
        let byte = source.get(index)
        if byte == backtick {
            let ticks = runLength(source, index, backtick)
            let close = findRun(source, index + ticks, backtick, ticks)
            index = if close < 0 { index + ticks } else { close + ticks }
        } else {
            if byte == leftBracket {
                depth = depth + 1
            } else if byte == rightBracket {
                depth = depth - 1
                if depth == 0 {
                    return index
                }
            }
            index = index + 1
        }
    }
    0 - 1
}

fn findByte(source!: Bytes, byte!: Int64, at!: Int64) -> Int64 {
    mut index = at
    while index < source.count {
        if source.get(index) == byte {
            return index
        }
        index = index + 1
    }
    0 - 1
}

fn spaces(count!: Int64) -> String {
    mut out = ""
    mut index = 0
    while index < count {
        out = "{out} "
        index = index + 1
    }
    out
}

fn slice(source!: Bytes, at!: Int64, stop!: Int64) -> String {
    if stop > at {
        source.slice(at, stop).toString()
    } else {
        ""
    }
}

fn isBlank(line!: String) -> Bool {
    line.trim().isEmpty()
}

fn isWordByte(byte!: Int64) -> Bool {
    (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 95
}

## ASCII punctuation a backslash may escape.
fn isPunctuation(byte!: Int64) -> Bool {
    (byte >= 33 and byte <= 47) or (byte >= 58 and byte <= 64) or (byte >= 91 and byte <= 96) or (byte >= 123 and byte <= 126)
}
