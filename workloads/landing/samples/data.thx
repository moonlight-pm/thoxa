## Types that check their values
## `where` narrows a type; a literal union names the values a string may
## take. `T.fromJson` (or `T.read` for text) builds a `T` and reports every
## problem it finds; `encode` writes any value back out. Nothing is derived
## or registered: the compiler reads the type.
import { Pass, Fail } from "std/fallible"
import { Json, messages } from "std/json"
import logging, { info } from "std/logging"

type Quantity = Int64 where >= 1 & <= 12
type Size = "small" | "large"
type Line(drink: String, size: Size, quantity: Quantity = 1)
type Order(table: Int64, lines: Array<Line>)

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    let good: Json = { table: 4, lines: [{ drink: "mocha", size: "large" }] }
    let bad: Json = {
        table: "four",
        lines: [{ drink: "mocha", size: "huge", quantity: 40 }],
    }
    for input in [good, bad] {
        match Order.fromJson(input) {
            Pass(order) => info("ok: {order.encode()}")
            Fail(issues) => info("rejected: {messages(issues)}")
        }
    }
    0
}
