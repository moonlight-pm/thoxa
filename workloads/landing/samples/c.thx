## Calling C
## `extern fn` declares a C function and the compiler writes its prototype,
## so anything in libc (or another linked library) can be called. A type
## with body fields has C layout, and `Address<T>` passes it by pointer. This
## program asks the kernel its name with `uname(2)` and writes the answer
## with `write(2)`.

## struct utsname on Linux: six 65-byte fields.
type SystemName {
    mut sysname: Array<Byte, 65>
    mut nodename: Array<Byte, 65>
    mut release: Array<Byte, 65>
    mut version: Array<Byte, 65>
    mut machine: Array<Byte, 65>
    mut domainname: Array<Byte, 65>
}

extern fn uname(name!: Address<SystemName>) -> Int32 from "c"
extern fn write(fd!: Int32, data!: Bytes, count!: UInt64) -> Int64 from "c"

fn print(text!: String) {
    let data = Bytes.fromString("{text}\n")
    write(1, data, data.count)
}

fn main() -> Int64 {
    mut name = SystemName()
    if uname(name) != 0 {
        print("uname failed")
        return 1
    }
    mut kernel = Bytes(0)
    mut index = 0
    while index < 65 and name.sysname[index] != 0 {
        kernel = kernel.insert(name.sysname[index], at: kernel.count)
        index = index + 1
    }
    print("kernel: {kernel.toString()}")
    0
}
