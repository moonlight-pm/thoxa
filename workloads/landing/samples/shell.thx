## The shell
## `thoxa` with no file is an interactive shell, and a file without `main` is
## a script for it. A line that reads as a command runs as one, with real
## pipes and redirections; the rest is Thoxa. The shell is a value, `shell`,
## that Thoxa code can call.
echo one two three four five | wc -w
test -d /nonexistent
status
let names = ["ada", "grace", "barbara"]
for name in names {
    shell = shell.run(["printf", "%-8s %s letters\n", name, "{name.count}"])
}
