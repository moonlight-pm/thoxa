## Landing routes + static fallback.

import home from "./pages/home"
import config from "./config"
import httpStatic from "std/http/static"
import { Request, Response, cached, withHeader } from "std/http"

## Fonts come from Google. Nothing runs script, embeds a frame, or posts a form.
let contentSecurityPolicy = "default-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

export fn listenPort() -> Int64 {
    config.listenPort()
}

type Routes {
    GET "/" (request: Request) -> Response {
        home.page(request)
    }
}

## An image or a font is reused for a day before it is checked again. A page
## or a stylesheet is checked on every load, so a deploy shows at once.
fn cacheControlFor(response!: Response) -> String {
    for header in response.headers {
        if header.name.toLower() == "content-type" {
            if header.value.startsWith("image/") or header.value.startsWith("font/") {
                return "public, max-age=86400"
            }
        }
    }
    "no-cache"
}

## Every response carries the security headers. A 200 also carries an ETag,
## so a repeat visit gets a 304 instead of the bytes again.
fn finish(request!: Request, response!: Response) -> Response {
    let validated = if response.status == 200 {
        cached(request, response, cacheControlFor(response))
    } else {
        withHeader(response, "Cache-Control", "no-cache")
    }
    let policed = withHeader(validated, "Content-Security-Policy", contentSecurityPolicy)
    let typed = withHeader(policed, "X-Content-Type-Options", "nosniff")
    let referred = withHeader(typed, "Referrer-Policy", "strict-origin-when-cross-origin")
    withHeader(referred, "Strict-Transport-Security", "max-age=31536000")
}

export fn handle(request!: Request) -> Response {
    let response = Routes().route(request)
    if response.status == 404 {
        let files = httpStatic.Router(root: config.staticRoot())
        let served = files.handle(request)
        if served.status == 404 {
            finish(request, home.missing(request))
        } else {
            finish(request, served)
        }
    } else {
        finish(request, response)
    }
}
