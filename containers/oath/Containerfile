# oath.wicket.cloud landing.
#
# Host compiles Thoxa → C. The image rebuilds that C plus thoxa_rt with Debian
# gcc so the binary is not tied to the host linker (Nix glibc, etc.).
#
#   cargo make emit-c containers/oath
#   podman build -f containers/oath/Containerfile \
#     --ignorefile containers/oath/.containerignore \
#     -t registry.wicket.cloud/oath-landing:latest .
#
# Wicket injects PORT / WICKET_PORT_HTTP.
#   podman run --rm -p 8080:8080 oath-landing:latest

FROM docker.io/library/debian:bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY runtime/include runtime/include
COPY runtime/src runtime/src
COPY target/thoxa/c/oath.c oath.c
RUN gcc -std=c11 -O2 -fPIC -c runtime/src/thoxa_rt.c -I runtime/include -o thoxa_rt.o \
 && gcc -std=c11 -O2 oath.c thoxa_rt.o -I runtime/include -lm -o /oath-landing

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /oath-landing /usr/local/bin/oath-landing
COPY containers/oath/web /app/web
RUN chmod 0755 /usr/local /usr/local/bin /usr/local/bin/oath-landing
ENV THOXA_PORT=8080
ENV THOXA_STATIC=/app/web
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/oath-landing"]
