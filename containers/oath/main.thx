## oath.wicket.cloud landing — process entry.
##
##   cargo make run containers/oath
##
## Prints the listen URL and opens it in the local browser (xdg-open).
## Set THOXA_NO_BROWSER=1 to skip. No-op when DISPLAY / WAYLAND_DISPLAY are unset.

import server from "std/http/server"
import routes from "./app/routes"
import { hasEnv } from "std/env"
import { Pass, Fail } from "std/fallible"
import logging, { warn } from "std/logging"

extern fn sysSystem(command!: String) -> Int32 from "c" "system"

fn siteUrl(port!: Int64) -> String {
    "http://127.0.0.1:{port}/"
}

fn shouldOpenBrowser() -> Bool {
    if hasEnv("THOXA_NO_BROWSER") {
        false
    } else {
        if hasEnv("DISPLAY") {
            true
        } else {
            hasEnv("WAYLAND_DISPLAY")
        }
    }
}

## Fire-and-forget: trailing `&` so we do not wait for the browser.
fn openBrowser(url!: String) {
    if shouldOpenBrowser() {
        let status = sysSystem("xdg-open '{url}' >/dev/null 2>&1 &")
        if status != 0 {
            warn("could not open {url}")
        }
    }
}

fn main() {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    let port = routes.listenPort()
    openBrowser(siteUrl(port))
    match server.serve(port, routes.handle) {
        Pass => 0
        Fail(error) {
            warn("server error: {error}")
            1
        }
    }
}
