## Tabbed example window. CSS-only radios — no JS.

fn kw(word!: String) -> Node {
    <span class="c-kw">{word}</span>
}

fn ty(word!: String) -> Node {
    <span class="c-ty">{word}</span>
}

fn st(word!: String) -> Node {
    <span class="c-st">{word}</span>
}

fn cm(word!: String) -> Node {
    <span class="c-com">{word}</span>
}

fn nu(word!: String) -> Node {
    <span class="c-nu">{word}</span>
}

fn tx(word!: String) -> Node {
    <span>{word}</span>
}

fn codeLine(parts!: Array<Node>) -> Node {
    <div class="code-line">{parts}</div>
}

fn tab(id!: String, label!: String, selected: Bool) -> Node {
    if selected {
        <label class="tab">
            <input type="radio" name="sample" id={id} checked />
            {label}
        </label>
    } else {
        <label class="tab">
            <input type="radio" name="sample" id={id} />
            {label}
        </label>
    }
}

fn panel(klass!: String, lines!: Array<Node>) -> Node {
    <div class={klass} role="tabpanel">{lines}</div>
}

fn layoutPanel() -> Node {
    panel("code panel-layout", [
        codeLine([cm("# hybrid layout, errors as values")]),
        codeLine([kw("import"), tx(" {{ info }} from "), st("\"std/logging\"")]),
        codeLine([kw("import"), tx(" {{ Pass, Fail, Trial }} from "), st("\"std/fallible\"")]),
        codeLine([tx("")]),
        codeLine([kw("type"), tx(" "), ty("Point"), tx("(x: "), ty("Int64"), tx(", y: "), ty("Int64"), tx(")")]),
        codeLine([tx("")]),
        codeLine([kw("fn"), tx(" load(path: "), ty("String"), tx(") → "), ty("Trial"), tx("<"), ty("Bytes"), tx(", "), ty("String"), tx("> {{ … }}")]),
        codeLine([kw("fn"), tx(" main() → "), ty("Int64"), tx(" {{")]),
        codeLine([tx("    "), kw("let"), tx(" data = load("), st("\"./cfg\""), tx(")?")]),
        codeLine([tx("    "), kw("match"), tx(" data.count {{")]),
        codeLine([tx("        "), nu("0"), tx(" | "), nu("1"), tx(" {{ info("), st("\"tiny\""), tx(") }}")]),
        codeLine([tx("        n {{ info("), st("\"{{n}} bytes\""), tx(") }}")]),
        codeLine([tx("    }}")]),
        codeLine([tx("    "), nu("0")]),
        codeLine([tx("}}")]),
    ])
}

fn sumsPanel() -> Node {
    panel("code panel-sums", [
        codeLine([cm("# tagged unions; match takes them apart")]),
        codeLine([kw("type"), tx(" "), ty("Roast"), tx(" = "), ty("Light"), tx(" | "), ty("Medium"), tx(" | "), ty("Dark")]),
        codeLine([tx("")]),
        codeLine([kw("fn"), tx(" name(roast: "), ty("Roast"), tx(") → "), ty("String"), tx(" {{")]),
        codeLine([tx("    "), kw("match"), tx(" roast {{")]),
        codeLine([tx("        "), ty("Light"), tx(" {{ "), st("\"light\""), tx(" }}")]),
        codeLine([tx("        "), ty("Medium"), tx(" {{ "), st("\"medium\""), tx(" }}")]),
        codeLine([tx("        "), ty("Dark"), tx(" {{ "), st("\"dark\""), tx(" }}")]),
        codeLine([tx("    }}")]),
        codeLine([tx("}}")]),
    ])
}

fn clausesPanel() -> Node {
    panel("code panel-clauses", [
        codeLine([cm("# same name, different types → one function")]),
        codeLine([kw("fn"), tx(" show(n: "), ty("Int64"), tx(") → "), ty("String"), tx(" {{")]),
        codeLine([tx("    "), st("\"{{n}}\"")]),
        codeLine([tx("}}")]),
        codeLine([tx("")]),
        codeLine([kw("fn"), tx(" show(ok: "), ty("Bool"), tx(") → "), ty("String"), tx(" {{")]),
        codeLine([tx("    "), kw("if"), tx(" ok {{")]),
        codeLine([tx("        "), st("\"yes\"")]),
        codeLine([tx("    }} "), kw("else"), tx(" {{")]),
        codeLine([tx("        "), st("\"no\"")]),
        codeLine([tx("    }}")]),
        codeLine([tx("}}")]),
    ])
}

fn errorsPanel() -> Node {
    panel("code panel-errors", [
        codeLine([cm("# May is a value. Import it; it is not ambient.")]),
        codeLine([kw("import"), tx(" {{ Has, Not, May }} from "), st("\"std/fallible\"")]),
        codeLine([tx("")]),
        codeLine([kw("fn"), tx(" first(xs: "), ty("Array"), tx("<"), ty("String"), tx(">) → "), ty("May"), tx("<"), ty("String"), tx("> {{")]),
        codeLine([tx("    "), kw("if"), tx(" xs.count == "), nu("0"), tx(" {{")]),
        codeLine([tx("        "), ty("Not"), tx("()")]),
        codeLine([tx("    }} "), kw("else"), tx(" {{")]),
        codeLine([tx("        "), ty("Has"), tx("(xs["), nu("0"), tx("])")]),
        codeLine([tx("    }}")]),
        codeLine([tx("}}")]),
    ])
}

fn ffiPanel() -> Node {
    panel("code panel-ffi", [
        codeLine([cm("# call libc from Thoxa")]),
        codeLine([kw("extern"), tx(" "), kw("fn"), tx(" sysWrite(")]),
        codeLine([tx("    fd: "), ty("Int32"), tx(", buf: "), ty("Bytes"), tx(", n: "), ty("UInt64")]),
        codeLine([tx(") → "), ty("Int64"), tx(" from "), st("\"c\""), tx(" "), st("\"write\"")]),
        codeLine([tx("")]),
        codeLine([kw("fn"), tx(" put(text: "), ty("String"), tx(") {{")]),
        codeLine([tx("    "), kw("let"), tx(" data = "), ty("Bytes"), tx(".fromString(text)")]),
        codeLine([tx("    sysWrite("), nu("1"), tx(", data, data.count)")]),
        codeLine([tx("}}")]),
    ])
}

fn sqlPanel() -> Node {
    panel("code panel-sql", [
        codeLine([cm("# holes quote themselves")]),
        codeLine([tx("db.exec("), kw("sql"), st("\"")]),
        codeLine([st("    INSERT INTO news (email)")]),
        codeLine([st("    VALUES ({{email}})")]),
        codeLine([st("\""), tx(")?")]),
    ])
}

export fn window() -> Node {
    <div class="code-window">
        <div class="code-tabs" role="tablist" aria-label="Code examples">
            {tab("ex-layout", "Layout", true)}
            {tab("ex-sums", "Sums", false)}
            {tab("ex-clauses", "Clauses", false)}
            {tab("ex-errors", "Errors", false)}
            {tab("ex-ffi", "C", false)}
            {tab("ex-sql", "SQL", false)}
        </div>
        {layoutPanel()}
        {sumsPanel()}
        {clausesPanel()}
        {errorsPanel()}
        {ffiPanel()}
        {sqlPanel()}
    </div>
}
