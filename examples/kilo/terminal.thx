## Terminal — raw mode + window size via Bytes buffers (matches termios/winsize ABI).

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"

extern fn sysTcgetattr(fd!: Int32, p!: Bytes) -> Int32 from "c" "tcgetattr"
extern fn sysTcsetattr(fd!: Int32, act!: Int32, p!: Bytes) -> Int32 from "c" "tcsetattr"
extern fn sysIoctl(fd!: Int32, request!: UInt64, ws!: Bytes) -> Int32 from "c" "ioctl"
extern fn sysStrerror(errnum!: Int32) -> String from "c" "strerror"
extern fn sysErrno() -> Int32 from "c" "thoxa_errno"

let echo = 8
let icanon = 2
let isig = 1
let iexten = 32768
let ixon = 1024
let icrnl = 256
let brkint = 2
let inpck = 16
let istrip = 32
let opost = 1
let cs8 = 48
let vmin = 6
let vtime = 5
let tcsaflush = 2
let tiocgwinsz = 21523
let stdinFileno = 0
let stdoutFileno = 1

fn termErr(what!: String) -> String {
    "{what}: {sysStrerror(sysErrno())}"
}

fn getU32(b!: Bytes, at!: Int64) -> Int64 {
    let b0 = b.get(at)
    let b1 = b.get(at + 1)
    let b2 = b.get(at + 2)
    let b3 = b.get(at + 3)
    b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

fn putU32(b!: Bytes, at!: Int64, v!: Int64) -> Void {
    b.set(at, v % 256)
    b.set(at + 1, (v / 256) % 256)
    b.set(at + 2, (v / 65536) % 256)
    b.set(at + 3, (v / 16777216) % 256)
    Void
}

fn getU16(b!: Bytes, at!: Int64) -> Int64 {
    b.get(at) + b.get(at + 1) * 256
}

mut orig = Bytes(60)
mut active = false

export type WindowSize(rows: Int64, cols: Int64)

export fn enable() -> Trial<Void, String> {
    if sysTcgetattr(stdinFileno, orig) < 0 {
        return Fail(termErr("tcgetattr"))
    }
    mut raw = Bytes(60)
    if sysTcgetattr(stdinFileno, raw) < 0 {
        return Fail(termErr("tcgetattr"))
    }
    ## new = old & ~mask  as  old - (old & mask) when mask bits ⊆ old (flag clears)
    let maskIn = brkint | icrnl | inpck | istrip | ixon
    let maskL = echo | icanon | iexten | isig
    let iflag = getU32(raw, 0)
    let oflag = getU32(raw, 4)
    let cflag = getU32(raw, 8)
    let lflag = getU32(raw, 12)
    putU32(raw, 0, iflag - (iflag & maskIn))
    putU32(raw, 4, oflag - (oflag & opost))
    putU32(raw, 8, cflag | cs8)
    putU32(raw, 12, lflag - (lflag & maskL))
    raw.set(17 + vmin, 0)
    raw.set(17 + vtime, 1)
    if sysTcsetattr(stdinFileno, tcsaflush, raw) < 0 {
        return Fail(termErr("tcsetattr"))
    }
    active = true
    Pass(Void)
}

export fn restore() -> Trial<Void, String> {
    if not active {
        return Pass(Void)
    }
    if sysTcsetattr(stdinFileno, tcsaflush, orig) < 0 {
        return Fail(termErr("tcsetattr"))
    }
    active = false
    Pass(Void)
}

export fn windowSize() -> Trial<WindowSize, String> {
    mut ws = Bytes(8)
    if sysIoctl(stdoutFileno, tiocgwinsz, ws) < 0 {
        Fail(termErr("ioctl TIOCGWINSZ"))
    } else {
        let rows = getU16(ws, 0)
        let cols = getU16(ws, 2)
        if cols == 0 {
            Fail("ioctl TIOCGWINSZ: zero columns")
        } else {
            Pass(WindowSize(rows, cols))
        }
    }
}
