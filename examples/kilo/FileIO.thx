## FileIO — open / save a file as Array<Row>.

import { Row, make } from "./Row"

extern fn sysOpen(path!: String, flags!: Int32) -> Int32 from "c" "open"
extern fn sysOpen3(path!: String, flags!: Int32, mode!: Int32) -> Int32 from "c" "open"
extern fn sysRead(fd!: Int32, buf!: Bytes, count!: UInt64) -> Int64 from "c" "read"
extern fn sysWrite(fd!: Int32, buf!: Bytes, count!: UInt64) -> Int64 from "c" "write"
extern fn sysLseek(fd!: Int32, offset!: Int64, whence!: Int32) -> Int64 from "c" "lseek"
extern fn sysClose(fd!: Int32) -> Int32 from "c" "close"
extern fn sysStrerror(errnum!: Int32) -> String from "c" "strerror"
extern fn sysErrno() -> Int32 from "c" "thoxa_errno"

let oRdOnly = 0
let seekSet = 0
let seekEnd = 2
let oWrOnly = 1
let oCreat = 64
let oTrunc = 512
let mode644 = 420
let nl = 10
let cr = 13

fn fileErr(what!: String) -> String {
    "{what}: {sysStrerror(sysErrno())}"
}

fn emptyRows() -> Array<Row> {
    mut xs: Array<Row> = []
    xs
}

fn splitRows(data!: Bytes) -> Array<Row> {
    mut rows = emptyRows()
    let n = data.count
    mut start = 0
    mut i = 0
    loop {
        if i >= n {
            break
        }
        if data.get(i) == nl {
            mut end = i
            if end > start {
                if data.get(end - 1) == cr {
                    end = end - 1
                }
            }
            rows = rows.append(make(data.slice(start, end)))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        rows = rows.append(make(data.slice(start, n)))
    }
    rows
}

export fn open(path!: String) -> Trial<Array<Row>, String> {
    let fd = sysOpen(path, oRdOnly)
    if fd < 0 {
        return Fail(fileErr("open {path}"))
    }
    let size = sysLseek(fd, 0, seekEnd)
    sysLseek(fd, 0, seekSet)
    if size < 0 {
        sysClose(fd)
        return Fail(fileErr("seek {path}"))
    }
    if size == 0 {
        sysClose(fd)
        return Pass(emptyRows())
    }
    let buf = Bytes(size)
    let got = sysRead(fd, buf, size)
    sysClose(fd)
    if got < 0 {
        return Fail(fileErr("read {path}"))
    }
    Pass(splitRows(buf))
}

fn rowsToString(rows!: Array<Row>) -> Bytes {
    mut buf = Buffer()
    mut i = 0
    loop {
        if i >= rows.count {
            break
        }
        buf.appendBytes(rows[i].bytes())
        buf.append(nl)
        i = i + 1
    }
    buf.freeze()
}

export fn save(path!: String, rows!: Array<Row>) -> Trial<Int64, String> {
    let data = rowsToString(rows)
    let flags = oWrOnly | oCreat | oTrunc
    let fd = sysOpen3(path, flags, mode644)
    if fd < 0 {
        return Fail(fileErr("open {path}"))
    }
    let n = sysWrite(fd, data, data.count)
    sysClose(fd)
    if n < 0 {
        return Fail(fileErr("write {path}"))
    }
    if n < data.count {
        return Fail("write {path}: incomplete write ({n} of {data.count} bytes)")
    }
    Pass(n)
}
