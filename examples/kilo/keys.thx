## Keys — read and decode one keypress from stdin (VT100 escape sequences).
## Key payload bytes are Int64 (0–255); no byte-literal syntax yet.

import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"

extern fn sysRead(fd!: Int32, buf!: Bytes, n!: UInt64) -> Int64 from "c" "read"
extern fn sysStrerror(errnum!: Int32) -> String from "c" "strerror"
extern fn sysErrno() -> Int32 from "c" "thoxa_errno"

let stdinFd = 0
let esc = 27

export type Press(byte: Int64)
export type Up
export type Down
export type Left
export type Right
export type Home
export type End
export type PageUp
export type PageDown
export type Delete
export type Key = Press | Up | Down | Left | Right | Home | End | PageUp | PageDown | Delete

## CTRL_KEY(k) = k & 0x1f
export fn ctrlKey(k: Int64) -> Int64 {
    k & 31
}

fn readByte() -> Trial<Int64, String> {
    let buf = Bytes(1)
    loop {
        let n = sysRead(stdinFd, buf, 1)
        if n < 0 {
            return Fail("read: {sysStrerror(sysErrno())}")
        }
        if n > 0 {
            return Pass(buf.get(0))
        }
        ## n == 0: VTIME idle timeout under raw mode — keep waiting
    }
    Fail("read: unreachable")
}

fn readByteOnce() -> Int64 {
    let buf = Bytes(1)
    let n = sysRead(stdinFd, buf, 1)
    if n == 1 {
        buf.get(0)
    } else {
        -1
    }
}

export fn readKey() -> Trial<Key, String> {
    let c = readByte()?
    if c != esc {
        return Pass(Press(byte: c))
    }
    let s0 = readByteOnce()
    if s0 < 0 {
        return Pass(Press(byte: esc))
    }
    let s1 = readByteOnce()
    if s1 < 0 {
        return Pass(Press(byte: esc))
    }

    ## ESC [ …
    if s0 == 91 {
        if s1 >= 48 {
            if s1 <= 57 {
                let s2 = readByteOnce()
                if s2 < 0 {
                    return Pass(Press(byte: esc))
                }
                if s2 != 126 {
                    return Pass(Press(byte: esc))
                }
                ## ~ terminated: Home/Delete/End/PageUp/PageDown
                if s1 == 49 {
                    return Pass(Home())
                }
                if s1 == 51 {
                    return Pass(Delete())
                }
                if s1 == 52 {
                    return Pass(End())
                }
                if s1 == 53 {
                    return Pass(PageUp())
                }
                if s1 == 54 {
                    return Pass(PageDown())
                }
                if s1 == 55 {
                    return Pass(Home())
                }
                if s1 == 56 {
                    return Pass(End())
                }
                return Pass(Press(byte: esc))
            }
        }
        if s1 == 65 {
            return Pass(Up())
        }
        if s1 == 66 {
            return Pass(Down())
        }
        if s1 == 67 {
            return Pass(Right())
        }
        if s1 == 68 {
            return Pass(Left())
        }
        if s1 == 72 {
            return Pass(Home())
        }
        if s1 == 70 {
            return Pass(End())
        }
        return Pass(Press(byte: esc))
    }
    ## ESC O …
    if s0 == 79 {
        if s1 == 72 {
            return Pass(Home())
        }
        if s1 == 70 {
            return Pass(End())
        }
        return Pass(Press(byte: esc))
    }
    Pass(Press(byte: esc))
}
