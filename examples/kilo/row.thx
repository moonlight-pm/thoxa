## Row — one text line: raw `chars` + tab-expanded `render` (both stored).

let tabStop = 8
let tabByte = 9
let spaceByte = 32

fn expandTabs(chars!: Bytes) -> Bytes {
    mut buf = Buffer()
    mut col = 0
    mut i = 0
    let n = chars.count
    loop {
        if i >= n {
            break
        }
        let b = chars.get(i)
        if b == tabByte {
            buf.append(spaceByte)
            col = col + 1
            loop {
                if col % tabStop == 0 {
                    break
                }
                buf.append(spaceByte)
                col = col + 1
            }
        } else {
            buf.append(b)
            col = col + 1
        }
        i = i + 1
    }
    buf.freeze()
}

## Construct a row; always rebuilds render from chars.
export fn make(chars!: Bytes) -> Row {
    Row(chars: chars, render: expandTabs(chars))
}

export type Row(chars: Bytes, render: Bytes) {
    export fn charCount() -> Int64 {
        chars.count
    }
    export fn renderCount() -> Int64 {
        render.count
    }

    export fn cxToRx(cx: Int64) -> Int64 {
        mut rx = 0
        mut i = 0
        loop {
            if i >= cx {
                break
            }
            if chars.get(i) == tabByte {
                rx = rx + (tabStop - 1) - (rx % tabStop)
            }
            rx = rx + 1
            i = i + 1
        }
        rx
    }

    export fn window(coloff: Int64, width: Int64) -> Bytes {
        let count = render.count
        let begin = if coloff > count {
            count
        } else {
            coloff
        }
        let stop = if coloff + width > count {
            count
        } else {
            coloff + width
        }
        render.slice(begin, stop)
    }

    export fn insertChar(at: Int64, byte: Int64) -> Row {
        make(chars.insertAt(at, byte))
    }

    export fn deleteChar(at: Int64) -> Row {
        make(chars.removeAt(at))
    }

    export fn take(count: Int64) -> Row {
        make(chars.slice(0, count))
    }

    export fn skip(count: Int64) -> Row {
        make(chars.slice(count, chars.count))
    }

    export fn concat(other!: Row) -> Row {
        mut buf = Buffer()
        buf.appendBytes(chars)
        buf.appendBytes(other.bytes())
        make(buf.freeze())
    }

    export fn bytes() -> Bytes {
        chars.slice(0, chars.count)
    }

    export fn renderBytes() -> Bytes {
        render.slice(0, render.count)
    }

    export fn text() -> String {
        chars.toString()
    }
}
