## App layer — returning customer via Cookie (domain helper over Framework.Wire).

import wire from "~/Framework/Wire"
import { Request, Response } from "std/Http"
import { Has, Not, May } from "std/Fallible"
import { trim, split, isEmpty, startsWith, dropPrefix } from "std/Str"

let cookieName = "customer"
let maxAgeSecs = 2592000

export fn current(req!: Request) -> May<String> {
    match wire.headerGet(req, "Cookie") {
        Not => Not()
        Has(raw) {
            findCookie(raw, cookieName)
        }
    }
}

fn findCookie(header!: String, name!: String) -> May<String> {
    let parts = split(header, ";")
    let prefix = "{name}="
    for part in parts {
        let p = trim(part)
        if startsWith(p, prefix) {
            let val = trim(dropPrefix(p, prefix))
            if isEmpty(val) {
                return Not()
            } else {
                return Has(val)
            }
        }
    }
    Not()
}

export fn rememberHeader(name!: String) -> String {
    "{cookieName}={name}; Path=/; HttpOnly; SameSite=Lax; Max-Age={maxAgeSecs}"
}

export fn forgetHeader() -> String {
    "{cookieName}=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0"
}

export fn withRemember(res!: Response, name!: String) -> Response {
    wire.withHeader(res, "Set-Cookie", rememberHeader(name))
}

export fn withForget(res!: Response) -> Response {
    wire.withHeader(res, "Set-Cookie", forgetHeader())
}

export fn greeting(req!: Request) -> String {
    match current(req) {
        Not => ""
        Has(name) {
            name
        }
    }
}
