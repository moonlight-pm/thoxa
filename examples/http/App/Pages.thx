## App layer — HTML pages for Little Crema.

import layout from "./Layout"
import models, { Drink, formatPrice } from "./Models"
import customer from "./Customer"
import wire from "~/Framework/Wire"
import { Response, notFound } from "std/Http"
import { Has, Not } from "std/Fallible"
import { isEmpty, trim, replaceAll } from "std/Str"

export fn home(who!: String) -> Response {
    let n = models.drinkCount()
    let card = homeCard(who)
    let body = "<section class=\"hero\">\n<h1>Little Crema</h1>\n<p class=\"lede\">Six drinks, one tiny counter, and a Thoxa feature in every pour.</p>\n<p><a class=\"button\" href=\"/menu\">Browse the menu</a></p>\n<p class=\"muted\">{n} drinks brewed fresh daily.</p>\n</section>\n{card}"
    layout.page("Home", body, who)
}

fn homeCard(who!: String) -> String {
    if isEmpty(who) {
        "<section class=\"card-form\">\n<h2>Are you a regular?</h2>\n<p class=\"muted\">Leave your name and the counter remembers you.</p>\n<form method=\"post\" action=\"/\">\n<label for=\"name\">Your name</label>\n<input id=\"name\" name=\"name\" type=\"text\" placeholder=\"Ada\" required>\n<button type=\"submit\">Remember me</button>\n</form>\n</section>\n"
    } else {
        "<section class=\"card-form\">\n<h2>Welcome back, {who}</h2>\n<p class=\"muted\">Your usual table is free.</p>\n<form method=\"post\" action=\"/\">\n<input type=\"hidden\" name=\"name\" value=\"\">\n<button type=\"submit\" class=\"outline\">Not {who}?</button>\n</form>\n</section>\n"
    }
}

fn drinkCards(drinks!: Array<Drink>) -> String {
    mut items = ""
    for d in drinks {
        let price = formatPrice(d.priceCents)
        items = "{items}<li class=\"card\">\n<a href=\"/menu/{d.slug}\">\n<span class=\"name\">{d.name}</span>\n<span class=\"meta\">{d.roast} · {price}</span>\n<span class=\"notes\">{d.notes}</span>\n</a>\n</li>\n"
    }
    items
}

fn escapeAttr(s!: String) -> String {
    replaceAll(replaceAll(s, "&", "&amp;"), "\"", "&quot;")
}

export fn menu(who!: String, q!: String) -> Response {
    let needle = trim(q)
    let drinks = models.searchDrinks(needle)
    let items = drinkCards(drinks)
    let qAttr = escapeAttr(needle)
    let search = "<form class=\"search\" method=\"get\" action=\"/menu\">\n<label for=\"q\">Search the menu</label>\n<div class=\"search-row\">\n<input id=\"q\" name=\"q\" type=\"search\" value=\"{qAttr}\" placeholder=\"espresso, chocolate, light…\">\n<button type=\"submit\">Search</button>\n</div>\n</form>\n"
    let emptyNote = if drinks.count == 0 {
        "<p class=\"muted\">Nothing matches. The barista suggests an espresso.</p>\n"
    } else {
        ""
    }
    let clear = if isEmpty(needle) {
        ""
    } else {
        "<p class=\"muted\"><a href=\"/menu\">Clear search</a> · showing {drinks.count} of {models.drinkCount()}</p>\n"
    }
    let body = "<h1>The menu</h1>\n{search}{clear}{emptyNote}<ul class=\"menu\">\n{items}</ul>\n"
    layout.page("Menu", body, who)
}

export fn drink(slug!: String, who!: String) -> Response {
    match models.findBySlug(slug) {
        Not => notFound()
        Has(d) {
            drinkPage(d, who)
        }
    }
}

fn drinkPage(d!: Drink, who!: String) -> Response {
    let price = formatPrice(d.priceCents)
    let body = "<p class=\"back\"><a href=\"/menu\">← Back to the menu</a></p>\n<article class=\"drink\">\n<h1>{d.name}</h1>\n<p class=\"badge\">{d.roast}</p>\n<p class=\"notes\">{d.notes}</p>\n<p class=\"price\">{price}</p>\n</article>\n"
    layout.page(d.name, body, who)
}

export fn signIn(body!: Bytes) -> Response {
    let redirect = wire.seeOther("/")
    match wire.formField(body, "name") {
        Not {
            redirect
        }
        Has(raw) {
            let name = trim(raw)
            if isEmpty(name) {
                customer.withForget(redirect)
            } else {
                customer.withRemember(redirect, name)
            }
        }
    }
}
