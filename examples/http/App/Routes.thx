## App layer — route table for Little Crema (what a user writes).
## Uses Framework.Wire for query/HEAD; does not own the accept loop.

import pages from "./Pages"
import api from "./Api"
import customer from "./Customer"
import wire from "~/Framework/Wire"
import { Router } from "std/HttpStatic"
import { Request, Response, methodNotAllowed, notFound } from "std/Http"
import { startsWith, dropPrefix, contains, isEmpty } from "std/Str"
import { Has, Not } from "std/Fallible"

## cwd-relative static root when run from workspace (`cargo make run examples/http`).
let staticRoot = "examples/http/web"

fn isReadMethod(method!: String) -> Bool {
    if method == "GET" {
        true
    } else {
        method == "HEAD"
    }
}

## App entry the framework calls. Full responses; Wire.finalize applies HEAD.
export fn handle(req!: Request, body!: Bytes, query!: String) -> Response {
    let res = if req.method == "POST" {
        routePost(req, body)
    } else {
        if isReadMethod(req.method) {
            routeRead(req, query)
        } else {
            methodNotAllowed("GET, HEAD, POST")
        }
    }
    wire.finalize(req.method, res)
}

fn routePost(req!: Request, body!: Bytes) -> Response {
    if req.path == "/" {
        pages.signIn(body)
    } else {
        methodNotAllowed("GET, HEAD")
    }
}

fn routeRead(req!: Request, query!: String) -> Response {
    let who = customer.greeting(req)
    let p = req.path
    if p == "/api/health" {
        return api.health()
    }
    if p == "/" {
        return pages.home(who)
    }
    if p == "/menu" {
        let q = match wire.queryParam(query, "q") {
            Not => ""
            Has(v) { v }
        }
        return pages.menu(who, q)
    }
    if startsWith(p, "/menu/") {
        let slug = dropPrefix(p, "/menu/")
        if isEmpty(slug) {
            return notFound()
        }
        if contains(slug, "/") {
            return notFound()
        }
        if contains(slug, "..") {
            return notFound()
        }
        return pages.drink(slug, who)
    }
    let files = Router(root: staticRoot)
    files.handle(req)
}
