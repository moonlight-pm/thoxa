## Little Crema — process entry only.
## framework/ is a pure host library (std only); app/Listen wires it to Routes.
##
##   cargo make run examples/http
##
## Charter: docs/ideas/2026-08-10-examples-http-crema-experiment.md

import listen from "./app/Listen"
import { Pass, Fail } from "std/Fallible"
import logging, { warn } from "std/Logging"

let listenPort = 9091

fn main() {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match listen.run(listenPort) {
        Pass => 0
        Fail(e) {
            warn("server error: {e}")
            1
        }
    }
}
