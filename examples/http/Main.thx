## Minimal HTTP/1.1 static file server (real listen loop).
## Uses product std: Net, Http, HttpStatic (static Router), Logging.
##
##   cargo make run examples/http
##   # or: cargo run -p thoxa -- run examples/http
##
## From the workspace root (cwd-relative web root):
##   curl -s  http://127.0.0.1:9091/
##   curl -s  http://127.0.0.1:9091/about/
##   curl -sD- http://127.0.0.1:9091/style.css
##   curl -s  http://127.0.0.1:9091/nope.html   # 404
##   curl -sI http://127.0.0.1:9091/            # HEAD
##
## Ctrl-C to stop. Port 9091; SO_REUSEADDR enabled.
## Setup failures (bind/listen) exit the process; accept/recv/send issues log and continue.

import net, { Socket } from "std/Net"
import http from "std/Http"
import { Router } from "std/HttpStatic"
import { Pass, Fail, Trial } from "std/Fallible"
import logging, { info, warn } from "std/Logging"

let listenPort = 9091
let webRoot = "examples/http/web"

fn main() -> Int64 {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match run() {
        Pass(_) {
            0
        }
        Fail(e) {
            warn("server error: {e}")
            1
        }
    }
}

fn run() -> Trial<Void, String> {
    let server = net.createSocket()?
    server.reuseAddr()?
    server.bind(listenPort)?
    server.listen(16)?
    info("http server listening on 127.0.0.1:{listenPort}")
    info("serving files from {webRoot}/  (Ctrl-C to stop)")
    let router = Router(root: webRoot)
    loop {
        match server.accept() {
            Fail(e) {
                ## Transient accept errors (EINTR, ECONNABORTED, ...) must not kill the server.
                warn("accept: {e}")
            }
            Pass(peer) {
                serveOne(peer, router)
                peer.close()
            }
        }
    }
    ## Unreachable; keeps Trial return shape if the loop ever breaks.
    Pass(Void)
}

## One connection: read headers, route, write full response. Never fails the process.
## (No `->` annotation ⇒ return type is Void.)
fn serveOne(peer!: Socket, router!: Router) {
    match peer.receiveRequest() {
        Fail(e) {
            warn("recv: {e}")
        }
        Pass(raw) {
            if raw.count == 0 {
                ## Peer closed without sending data — quiet.
            } else {
                let response = match http.parseRequest(raw) {
                    Pass(req) {
                        let res = router.handle(req)
                        info("{req.method} {req.path} -> {res.status} {res.reason}")
                        res
                    }
                    Fail(msg) {
                        warn("parse: {msg}")
                        http.badRequest(msg)
                    }
                }
                let wire = http.writeResponse(response)
                match peer.sendAll(wire) {
                    Pass(_) { }
                    Fail(e) {
                        warn("send: {e}")
                    }
                }
            }
        }
    }
}
