## Little Crema — process entry (glue only).
## Framework owns the server loop; App owns routes and domain.
##
##   cargo make run examples/http
##
## Layout:
##   Framework/  — host pipeline (candidate std)
##   App/        — Little Crema application
##   web/        — static assets
##
## Charter: docs/ideas/2026-08-10-examples-http-crema-experiment.md

import server from "./Framework/Server"
import { Pass, Fail } from "std/Fallible"
import logging, { warn } from "std/Logging"

let listenPort = 9091

fn main() {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)

    match server.run(listenPort) {
        Pass => 0
        Fail(e) {
            warn("server error: {e}")
            1
        }
    }
}
