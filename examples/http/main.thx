## Little Crema — process entry.
##
##   cargo make run examples/http
##
## Host is product `std/http/server`. Charter:
## docs/ideas/2026-08-10-examples-http-crema-experiment.md

import server from "std/http/server"
import routes from "./app/routes"
import store from "./app/store"
import { Pass, Fail } from "std/fallible"
import logging, { warn } from "std/logging"

fn main() {
    logging.toStdout()
    logging.setFormat(logging.formatPlain)
    match store.open() {
        Fail(error) {
            warn("store error: {error}")
            1
        }
        Pass {
            match server.serve(routes.port, routes.handle) {
                Pass => 0
                Fail(error) {
                    warn("server error: {error}")
                    1
                }
            }
        }
    }
}
