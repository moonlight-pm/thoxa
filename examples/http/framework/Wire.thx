## Framework — HTTP request/response helpers (candidate std surface).
## Body completion, query recovery, headers, form decode, redirects, HEAD finalize.
## Never imports app/.

import { Socket } from "std/Net"
import { Request, Response, Header } from "std/Http"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import { toLowerAscii, trim, split, isEmpty, byteAt, length } from "std/Str"

let maxBodyBytes = 65536
let queryHeaderName = "X-Thoxa-Query"

type Kv(key: String, val: String)

## Example-only: std Request has no query field (path is `?`-stripped).
## Server attaches the recovered query so route clauses can read it.
export fn withQuery(req!: Request, query!: String) -> Request {
    mut headers: Array<Header> = []
    let want = toLowerAscii(queryHeaderName)
    for h in req.headers {
        if toLowerAscii(h.name) != want {
            headers = headers.append(h)
        }
    }
    headers = headers.append(Header(name: queryHeaderName, value: query))
    Request(
        method: req.method,
        path: req.path,
        version: req.version,
        headers: headers,
        body: req.body
    )
}

export fn requestQuery(req!: Request) -> String {
    match headerGet(req, queryHeaderName) {
        Not => ""
        Has(v) { v }
    }
}

export fn headerGet(req!: Request, name!: String) -> May<String> {
    let want = toLowerAscii(name)
    for h in req.headers {
        if toLowerAscii(h.name) == want {
            return Has(h.value)
        }
    }
    Not()
}

export fn parseUInt(s!: String) -> May<Int64> {
    let n = length(s)
    if n == 0 {
        Not()
    } else {
        mut val = 0
        mut i = 0
        mut ok = true
        loop {
            if i >= n {
                break
            }
            let c = byteAt(s, i)
            if c < 48 {
                ok = false
                break
            }
            if c > 57 {
                ok = false
                break
            }
            val = val * 10 + (c - 48)
            i = i + 1
        }
        if ok {
            Has(val)
        } else {
            Not()
        }
    }
}

export fn contentLength(req!: Request) -> May<Int64> {
    match headerGet(req, "Content-Length") {
        Not => Not()
        Has(v) {
            parseUInt(trim(v))
        }
    }
}

fn bodyPrefix(raw!: Bytes) -> Bytes {
    let sep = Bytes.fromString("\r\n\r\n")
    match raw.find(sep) {
        Not => Bytes(0)
        Has(at) {
            raw.slice(at + 4, raw.count)
        }
    }
}

fn readUntil(peer!: Socket, start!: Bytes, need!: Int64) -> Trial<Bytes, String> {
    if need > maxBodyBytes {
        return Fail("request body too large")
    }
    mut acc = start
    loop {
        if acc.count >= need {
            return Pass(acc.slice(0, need))
        }
        let chunk = peer.receive()
        if chunk.count == 0 {
            return Fail("incomplete request body")
        }
        if acc.count + chunk.count > maxBodyBytes {
            return Fail("request body too large")
        }
        mut buf = Buffer()
        buf.appendBytes(acc)
        buf.appendBytes(chunk)
        acc = buf.freeze()
    }
    Fail("readUntil: internal")
}

## Query string without leading `?` (std Request.path is query-stripped).
export fn rawQuery(raw!: Bytes) -> String {
    let crlf = Bytes.fromString("\r\n")
    let lineEnd = match raw.find(crlf) {
        Not => raw.count
        Has(at) { at }
    }
    if lineEnd <= 0 {
        return ""
    }
    let reqLine = raw.slice(0, lineEnd)
    let sp = Bytes.fromString(" ")
    match reqLine.find(sp) {
        Not => ""
        Has(sp1) {
            match reqLine.find(sp, sp1 + 1) {
                Not => ""
                Has(sp2) {
                    let target = reqLine.slice(sp1 + 1, sp2)
                    match target.find(Bytes.fromString("?")) {
                        Not => ""
                        Has(q) {
                            target.slice(q + 1, target.count).toString()
                        }
                    }
                }
            }
        }
    }
}

export fn queryParam(query!: String, key!: String) -> May<String> {
    formField(Bytes.fromString(query), key)
}

export fn readBody(peer!: Socket, raw!: Bytes, req!: Request) -> Trial<Bytes, String> {
    let have = bodyPrefix(raw)
    match contentLength(req) {
        Not {
            Pass(have)
        }
        Has(n) {
            if n == 0 {
                Pass(Bytes(0))
            } else {
                if n > maxBodyBytes {
                    Fail("request body too large")
                } else {
                    readUntil(peer, have, n)
                }
            }
        }
    }
}

export fn urlDecode(s!: String) -> String {
    let b = Bytes.fromString(s)
    mut out = Buffer()
    mut i = 0
    loop {
        if i >= b.count {
            break
        }
        let c = b.get(i)
        if c == 43 {
            out.appendBytes(Bytes.fromString(" "))
            i = i + 1
        } else {
            if c == 37 {
                if i + 2 < b.count {
                    match hexByte(b.get(i + 1), b.get(i + 2)) {
                        Not {
                            out.appendBytes(b.slice(i, i + 1))
                            i = i + 1
                        }
                        Has(byte) {
                            let one = Bytes(1)
                            one.set(0, byte)
                            out.appendBytes(one)
                            i = i + 3
                        }
                    }
                } else {
                    out.appendBytes(b.slice(i, i + 1))
                    i = i + 1
                }
            } else {
                out.appendBytes(b.slice(i, i + 1))
                i = i + 1
            }
        }
    }
    out.freeze().toString()
}

fn hexNibble(c!: Int64) -> May<Int64> {
    if c >= 48 {
        if c <= 57 {
            return Has(c - 48)
        }
    }
    if c >= 65 {
        if c <= 70 {
            return Has(c - 55)
        }
    }
    if c >= 97 {
        if c <= 102 {
            return Has(c - 87)
        }
    }
    Not()
}

fn hexByte(hi!: Int64, lo!: Int64) -> May<Int64> {
    match hexNibble(hi) {
        Not => Not()
        Has(h) {
            match hexNibble(lo) {
                Not => Not()
                Has(l) {
                    Has(h * 16 + l)
                }
            }
        }
    }
}

export fn formField(body!: Bytes, key!: String) -> May<String> {
    let raw = body.toString()
    if isEmpty(raw) {
        Not()
    } else {
        let pairs = split(raw, "&")
        for pair in pairs {
            match splitOnce(pair, "=") {
                Not {
                    if pair == key {
                        return Has("")
                    }
                }
                Has(kv) {
                    if kv.key == key {
                        return Has(urlDecode(kv.val))
                    }
                }
            }
        }
        Not()
    }
}

fn splitOnce(s!: String, sep!: String) -> May<Kv> {
    let b = Bytes.fromString(s)
    let needle = Bytes.fromString(sep)
    match b.find(needle) {
        Not => Not()
        Has(at) {
            Has(Kv(
                key: b.slice(0, at).toString(),
                val: b.slice(at + needle.count, b.count).toString()
            ))
        }
    }
}

export fn seeOther(location!: String) -> Response {
    Response(
        status: 303,
        reason: "See Other",
        headers: [
            Header(name: "Location", value: location),
            Header(name: "Content-Length", value: "0"),
            Header(name: "Connection", value: "close"),
        ],
        body: Bytes(0)
    )
}

export fn withHeader(res!: Response, name!: String, value!: String) -> Response {
    Response(
        status: res.status,
        reason: res.reason,
        headers: res.headers.append(Header(name: name, value: value)),
        body: res.body
    )
}

fn hasConnToken(header!: String, token!: String) -> Bool {
    let want = toLowerAscii(token)
    let parts = split(header, ",")
    for p in parts {
        if toLowerAscii(trim(p)) == want {
            return true
        }
    }
    false
}

## HTTP/1.1 stays open unless Connection: close. HTTP/1.0 closes unless keep-alive.
export fn wantsKeepAlive(version!: String, req!: Request) -> Bool {
    match headerGet(req, "Connection") {
        Not {
            version == "HTTP/1.1"
        }
        Has(v) {
            if hasConnToken(v, "close") {
                false
            } else {
                if version == "HTTP/1.1" {
                    true
                } else {
                    hasConnToken(v, "keep-alive")
                }
            }
        }
    }
}

## HEAD: keep headers (incl. Content-Length), drop body (RFC 9110 §9.3.2).
## Rewrite Connection to match whether this peer will read another request.
export fn finalize(method!: String, res!: Response, keepAlive!: Bool) -> Response {
    let conn = if keepAlive {
        "keep-alive"
    } else {
        "close"
    }
    mut headers: Array<Header> = []
    for h in res.headers {
        if toLowerAscii(h.name) != "connection" {
            headers = headers.append(h)
        }
    }
    headers = headers.append(Header(name: "Connection", value: conn))
    let body = if method == "HEAD" {
        Bytes(0)
    } else {
        res.body
    }
    Response(
        status: res.status,
        reason: res.reason,
        headers: headers,
        body: body
    )
}
