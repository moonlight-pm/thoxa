## Framework — HTTP server host (candidate std).
## Imports only std/ and framework/*. Host takes port + handle (D132).
## Completes body + query onto Request so the app handle / `Routes.route` see them.
## Does not import app pages, models, or other domain modules.

import net, { Socket } from "std/Net"
import http, { Request, Response, Header } from "std/Http"
import wire from "./Wire"
import { Has, Not, May, Pass, Fail, Trial } from "std/Fallible"
import { split } from "std/Str"
import logging, { info, warn } from "std/Logging"

## Full request entity. Headers packed as `name\\tvalue\\n` lines.
export type Incoming(
    method: String,
    path: String,
    version: String,
    headersWire: Bytes,
    body: Bytes,
    query: String
)

export fn isQuietClose(inc!: Incoming) -> Bool {
    if inc.method == "" {
        inc.path == ""
    } else {
        false
    }
}

export fn bindListen(port!: Int64) -> Trial<Socket, String> {
    let server = net.createSocket()?
    server.reuseAddr()?
    server.bind(port)?
    server.listen(16)?
    Pass(server)
}

fn packHeaders(headers!: Array<Header>) -> Bytes {
    mut buf = Buffer()
    for h in headers {
        buf.appendBytes(Bytes.fromString("{h.name}\t{h.value}\n"))
    }
    buf.freeze()
}

fn unpackHeaders(packed!: Bytes) -> Array<Header> {
    let text = packed.toString()
    let lines = split(text, "\n")
    mut headers: Array<Header> = []
    for line in lines {
        match splitOnceTab(line) {
            Not { }
            Has(kv) {
                headers = headers.append(Header(name: kv.name, value: kv.value))
            }
        }
    }
    headers
}

type NameVal(name: String, value: String)

fn splitOnceTab(line!: String) -> May<NameVal> {
    let b = Bytes.fromString(line)
    let tab = Bytes.fromString("\t")
    match b.find(tab) {
        Not {
            Not()
        }
        Has(t) {
            Has(NameVal(
                name: b.slice(0, t).toString(),
                value: b.slice(t + 1, b.count).toString()
            ))
        }
    }
}

export fn readIncoming(peer!: Socket) -> Trial<Incoming, String> {
    match peer.receiveRequest() {
        Fail(e) {
            Fail(e)
        }
        Pass(raw) {
            if raw.count == 0 {
                Pass(Incoming(
                    method: "",
                    path: "",
                    version: "",
                    headersWire: Bytes(0),
                    body: Bytes(0),
                    query: ""
                ))
            } else {
                match http.parseRequest(raw) {
                    Fail(msg) {
                        Fail(msg)
                    }
                    Pass(req) {
                        match wire.readBody(peer, raw, req) {
                            Fail(e) {
                                Fail(e)
                            }
                            Pass(body) {
                                let query = wire.rawQuery(raw)
                                Pass(Incoming(
                                    method: req.method,
                                    path: req.path,
                                    version: req.version,
                                    headersWire: packHeaders(req.headers),
                                    body: body,
                                    query: query
                                ))
                            }
                        }
                    }
                }
            }
        }
    }
}

export fn requestOf(inc!: Incoming) -> Request {
    ## Route clauses match method exactly; GET registrations also answer HEAD
    ## (same as the old example Router). finalize() still sees the real method.
    let method = if inc.method == "HEAD" {
        "GET"
    } else {
        inc.method
    }
    let req = Request(
        method: method,
        path: inc.path,
        version: inc.version,
        headers: unpackHeaders(inc.headersWire),
        body: inc.body
    )
    wire.withQuery(req, inc.query)
}

export fn writeResponse(
    peer!: Socket,
    method!: String,
    res!: Response,
    keepAlive!: Bool
) -> Trial<Void, String> {
    let final = wire.finalize(method, res, keepAlive)
    let wireBytes = http.writeResponse(final)
    match peer.sendAll(wireBytes) {
        Pass(_) {
            Pass(Void)
        }
        Fail(e) {
            Fail(e)
        }
    }
}

export fn writeBadRequest(peer!: Socket, msg!: String) -> Trial<Void, String> {
    writeResponse(peer, "GET", http.badRequest(msg), false)
}

## Run the host forever. `handle` is a free fn or bound method (D132).
## `--> serveOne` is the omitted await: an idle peer parks in recv without
## stalling accept (experiment/implicit-async).
export fn serve(
    port!: Int64,
    handle!: (req: Request) -> Response
) -> Trial<Void, String> {
    let listener = bindListen(port)?
    info("http server listening on 127.0.0.1:{port}")
    info("framework Server.serve (Ctrl-C to stop)")
    loop {
        match listener.accept() {
            Fail(e) {
                warn("accept: {e}")
            }
            Pass(peer) {
                --> serveOne(peer, handle)
            }
        }
    }
}

fn serveOne(peer!: Socket, handle!: (req: Request) -> Response) {
    loop {
        match readIncoming(peer) {
            Fail(e) {
                warn("recv: {e}")
                match writeBadRequest(peer, e) {
                    Pass(_) { }
                    Fail(se) {
                        warn("send: {se}")
                    }
                }
                break
            }
            Pass(inc) {
                if isQuietClose(inc) {
                    break
                }
                let req = requestOf(inc)
                let keep = wire.wantsKeepAlive(inc.version, req)
                let res = handle(req)
                info("{inc.method} {inc.path} -> {res.status} {res.reason}")
                match writeResponse(peer, inc.method, res, keep) {
                    Fail(se) {
                        warn("send: {se}")
                        break
                    }
                    Pass(_) {
                        if not keep {
                            break
                        }
                    }
                }
            }
        }
    }
    peer.close()
}
