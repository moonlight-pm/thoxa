## Framework layer — TCP accept loop and per-connection HTTP pipeline.
## Mounts the app at `~/App/Routes` (only Framework→App edge; no fn values yet).
## Candidate future std surface: listen + serve with a handler hook.

import net, { Socket } from "std/Net"
import http from "std/Http"
import wire from "./Wire"
import routes from "~/App/Routes"
import { Pass, Fail, Trial } from "std/Fallible"
import logging, { info, warn } from "std/Logging"

## Bind, listen, accept forever. Setup failures return Fail; accept errors log.
export fn run(port!: Int64) -> Trial<Void, String> {
    let server = net.createSocket()?
    server.reuseAddr()?
    server.bind(port)?
    server.listen(16)?
    info("http server listening on 127.0.0.1:{port}")
    info("framework ready — app mounted at App/Routes (Ctrl-C to stop)")
    loop {
        match server.accept() {
            Fail(e) {
                warn("accept: {e}")
            }
            Pass(peer) {
                serveOne(peer)
                peer.close()
            }
        }
    }
}

## One connection: headers → body → query → app routes → HEAD finalize → send.
fn serveOne(peer!: Socket) {
    match peer.receiveRequest() {
        Fail(e) {
            warn("recv: {e}")
        }
        Pass(raw) {
            if raw.count == 0 {
                ## Peer closed without sending data — quiet.
            } else {
                let response = match http.parseRequest(raw) {
                    Pass(req) {
                        match wire.readBody(peer, raw, req) {
                            Fail(e) {
                                warn("body: {e}")
                                http.badRequest(e)
                            }
                            Pass(body) {
                                let query = wire.rawQuery(raw)
                                let res = routes.handle(req, body, query)
                                info("{req.method} {req.path} -> {res.status} {res.reason}")
                                res
                            }
                        }
                    }
                    Fail(msg) {
                        warn("parse: {msg}")
                        http.badRequest(msg)
                    }
                }
                let wireBytes = http.writeResponse(response)
                match peer.sendAll(wireBytes) {
                    Pass(_) { }
                    Fail(e) {
                        warn("send: {e}")
                    }
                }
            }
        }
    }
}
