## Application router — manual method+path dispatch (Topcoat manual-router spirit).
## Dynamic pages and API first; static files via std/HttpStatic fallback.
## HEAD: handlers return full responses; Wire.finalize strips the body.
## All logic stays in examples/http — no std growth.

import pages from "./Pages"
import api from "./Api"
import customer from "./Customer"
import wire from "./Wire"
import { Router } from "std/HttpStatic"
import { Request, Response, methodNotAllowed, notFound } from "std/Http"
import { startsWith, dropPrefix, contains, isEmpty } from "std/Str"

## True for GET or HEAD.
fn isReadMethod(method!: String) -> Bool {
    if method == "GET" {
        true
    } else {
        method == "HEAD"
    }
}

## Dispatch one request to a Response. `body` is the raw request body
## (example-completed; std Request.body stays empty).
export fn handle(req!: Request, body!: Bytes) -> Response {
    let res = if req.method == "POST" {
        routePost(req, body)
    } else {
        if isReadMethod(req.method) {
            routeRead(req)
        } else {
            methodNotAllowed("GET, HEAD, POST")
        }
    }
    wire.finalize(req.method, res)
}

fn routePost(req!: Request, body!: Bytes) -> Response {
    if req.path == "/" {
        pages.signIn(body)
    } else {
        methodNotAllowed("GET, HEAD")
    }
}

fn routeRead(req!: Request) -> Response {
    let who = customer.greeting(req)
    let p = req.path
    if p == "/api/health" {
        return api.health()
    }
    if p == "/" {
        return pages.home(who)
    }
    if p == "/menu" {
        return pages.menu(who)
    }
    if startsWith(p, "/menu/") {
        let slug = dropPrefix(p, "/menu/")
        if isEmpty(slug) {
            return notFound()
        }
        if contains(slug, "/") {
            return notFound()
        }
        if contains(slug, "..") {
            return notFound()
        }
        return pages.drink(slug, who)
    }
    ## CSS and any leftover static files under web/ (cwd-relative).
    ## HttpStatic already handles HEAD; finalize is a no-op on empty body.
    let files = Router(root: "examples/http/web")
    files.handle(req)
}
