## App layer — in-memory drink catalog (domain data).

import { Has, Not, May } from "std/Fallible"
import { containsIgnoreCaseAscii, isEmpty, trim } from "std/Str"

export type Dark
export type Medium
export type Light
export type Roast = Dark | Medium | Light

export type Drink(
    slug: String,
    name: String,
    notes: String,
    priceCents: Int64,
    roast: Roast
)

export fn roastLabel(r: Roast) -> String {
    match r {
        Dark => "Dark roast"
        Medium => "Medium roast"
        Light => "Light roast"
    }
}

export fn formatPrice(cents!: Int64) -> String {
    let dollars = cents / 100
    let rem = cents % 100
    if rem < 10 {
        "${dollars}.0{rem}"
    } else {
        "${dollars}.{rem}"
    }
}

export fn allDrinks() -> Array<Drink> {
    [
        Drink(
            slug: "espresso",
            name: "Espresso",
            notes: "A quick, syrupy shot under a hazelnut crema.",
            priceCents: 300,
            roast: Dark()
        ),
        Drink(
            slug: "cold-brew",
            name: "Cold Brew",
            notes: "Steeped overnight: chocolate, cherry, no acidity.",
            priceCents: 400,
            roast: Dark()
        ),
        Drink(
            slug: "cappuccino",
            name: "Cappuccino",
            notes: "Equal parts espresso, steamed milk, and foam.",
            priceCents: 500,
            roast: Medium()
        ),
        Drink(
            slug: "flat-white",
            name: "Flat White",
            notes: "Two ristretto shots under velvet microfoam.",
            priceCents: 500,
            roast: Medium()
        ),
        Drink(
            slug: "pour-over",
            name: "Pour Over",
            notes: "A single-origin Ethiopian, bright and floral.",
            priceCents: 600,
            roast: Light()
        ),
        Drink(
            slug: "mocha",
            name: "Mocha",
            notes: "Espresso and dark chocolate under whipped cream.",
            priceCents: 600,
            roast: Dark()
        ),
    ]
}

export fn findBySlug(slug!: String) -> May<Drink> {
    for d in allDrinks() {
        if d.slug == slug {
            return Has(d)
        }
    }
    Not()
}

export fn drinkCount() -> Int64 {
    allDrinks().count
}

export fn searchDrinks(needle!: String) -> Array<Drink> {
    let q = trim(needle)
    if isEmpty(q) {
        allDrinks()
    } else {
        mut out: Array<Drink> = []
        for d in allDrinks() {
            if drinkMatches(d, q) {
                out.append(d)
            }
        }
        out
    }
}

fn drinkMatches(d!: Drink, q!: String) -> Bool {
    if containsIgnoreCaseAscii(d.name, q) {
        true
    } else {
        if containsIgnoreCaseAscii(d.notes, q) {
            true
        } else {
            if containsIgnoreCaseAscii(roastLabel(d.roast), q) {
                true
            } else {
                containsIgnoreCaseAscii(d.slug, q)
            }
        }
    }
}
