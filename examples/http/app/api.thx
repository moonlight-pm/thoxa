## App layer — JSON HTTP handlers (no HTML shell).

import store, { OrderRow } from "./store"
import orders, { CreateOrder, Ticket } from "./orders"
import live from "./live"
import http, { Request, Response, ok } from "std/http"
import { Pass, Fail } from "std/fallible"
import { Json, JArr, JBool, JInt, JObj, JStr, encode, Issue, Rejected, issueRejected, errorObject } from "std/json"

export fn health() -> Response {
    ok(Bytes.fromString("ok\n"), "text/plain; charset=utf-8")
}

## POST /api/orders — `{"slug":"mocha","qty":2}` → priced ticket.
export fn createOrder(request!: Request) -> Response {
    match CreateOrder.read(request.body.toString()) {
        Fail(error) => jsonIssue(error)
        Pass(order) {
            match orders.place(order) {
                Fail(error) => placeOrderFail(error)
                Pass(ticket) {
                    live.broadcast()
                    jsonOk(ticketOk(ticket))
                }
            }
        }
    }
}

export fn listOrders() -> Response {
    match store.listOrders() {
        Fail(error) => jsonStoreFail(error)
        Pass(rows) {
            mut items: Array<Json> = []
            for row in rows {
                items.append(orderJson(row))
            }
            jsonOk(JArr(items))
        }
    }
}

fn placeOrderFail(error!: Issue) -> Response {
    match error {
        Rejected(path, reason) {
            if path == "store" {
                jsonStoreFail(reason)
            } else {
                jsonIssue(error)
            }
        }
        else => jsonIssue(error)
    }
}

fn orderJson(row!: OrderRow) -> Json {
    mut fields: Map<String, Json> = Map()
    fields.set("id", JInt(row.id))
    fields.set("slug", JStr(row.slug))
    fields.set("name", JStr(row.name))
    fields.set("qty", JInt(row.qty))
    fields.set("unitCents", JInt(row.unitCents))
    fields.set("totalCents", JInt(row.totalCents))
    JObj(fields)
}

fn jsonStoreFail(error!: String) -> Response {
    jsonResponse(500, "Internal Server Error", errorObject(issueRejected("store", error)))
}

fn ticketOk(ticket!: Ticket) -> Json {
    let raw: Json = ticket.toJson()
    match raw {
        JObj(fields) {
            mut object = fields
            object.set("ok", JBool(true))
            let json: Json = JObj(object)
            json
        }
        else => raw
    }
}

fn jsonOk(value!: Json) -> Response {
    jsonResponse(200, "OK", value)
}

fn jsonIssue(error!: Issue) -> Response {
    jsonResponse(400, "Bad Request", errorObject(error))
}

fn jsonResponse(status!: Int64, reason!: String, value!: Json) -> Response {
    http.response(
        status,
        reason,
        "application/json; charset=utf-8",
        Bytes.fromString(encode(value))
    )
}
