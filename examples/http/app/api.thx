## App layer — non-page HTTP handlers (no HTML shell).

import models from "./models"
import http, { Request, Response, ok } from "std/http"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import { Json, JBool, JInt, JStr, JObj, encode, Issue, issueRejected, errorObject } from "std/json"

export fn health() -> Response {
    ok(Bytes.fromString("ok\n"), "text/plain; charset=utf-8")
}

type Qty = Int64 where >= 1
type CreateOrder(slug: String, qty: Qty)

## POST /api/orders — `{"slug":"mocha","qty":2}` → priced ticket.
export fn createOrder(req!: Request) -> Response {
    match CreateOrder.read(req.body.toString()) {
        Fail(e) => jsonIssue(e)
        Pass(o) {
            match placeOrder(o) {
                Fail(e) => jsonIssue(e)
                Pass(ticket) => jsonOk(ticketJson(ticket))
            }
        }
    }
}

type Ticket(slug: String, name: String, qty: Int64, unitCents: Int64, totalCents: Int64)

fn placeOrder(o!: CreateOrder) -> Trial<Ticket, Issue> {
    match models.findBySlug(o.slug) {
        Not => Fail(issueRejected("slug", "unknown drink"))
        Has(d) {
            Pass(Ticket(
                slug: d.slug,
                name: d.name,
                qty: o.qty,
                unitCents: d.priceCents,
                totalCents: d.priceCents * o.qty
            ))
        }
    }
}

fn ticketJson(t!: Ticket) -> Json {
    mut m: Map<String, Json> = Map()
    m.set("ok", JBool(true))
    m.set("slug", JStr(t.slug))
    m.set("name", JStr(t.name))
    m.set("qty", JInt(t.qty))
    m.set("unitCents", JInt(t.unitCents))
    m.set("totalCents", JInt(t.totalCents))
    JObj(m)
}

fn jsonOk(v!: Json) -> Response {
    jsonRes(200, "OK", v)
}

fn jsonIssue(e!: Issue) -> Response {
    jsonRes(400, "Bad Request", errorObject(e))
}

fn jsonRes(status!: Int64, reason!: String, v!: Json) -> Response {
    http.response(
        status,
        reason,
        "application/json; charset=utf-8",
        Bytes.fromString(encode(v))
    )
}
