## App layer — non-page HTTP handlers (no HTML shell).

import models from "./models"
import http, { Request, Response, ok } from "std/http"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import { Json, JBool, JObj, encode, Issue, issueRejected, errorObject } from "std/json"

export fn health() -> Response {
    ok(Bytes.fromString("ok\n"), "text/plain; charset=utf-8")
}

type Qty = Int64 where >= 1
type DrinkSlug = "espresso" | "cold-brew" | "cappuccino" | "flat-white" | "pour-over" | "mocha"
type CreateOrder(slug: DrinkSlug, qty: Qty)

## POST /api/orders — `{"slug":"mocha","qty":2}` → priced ticket.
export fn createOrder(request!: Request) -> Response {
    match CreateOrder.read(request.body.toString()) {
        Fail(error) => jsonIssue(error)
        Pass(order) {
            match placeOrder(order) {
                Fail(error) => jsonIssue(error)
                Pass(ticket) => jsonOk(ticketOk(ticket))
            }
        }
    }
}

type Ticket(slug: String, name: String, qty: Int64, unitCents: Int64, totalCents: Int64)

fn placeOrder(order!: CreateOrder) -> Trial<Ticket, Issue> {
    match models.findBySlug(order.slug) {
        Not => Fail(issueRejected("slug", "unknown drink"))
        Has(drink) {
            Pass(Ticket(
                slug: drink.slug,
                name: drink.name,
                qty: order.qty,
                unitCents: drink.priceCents,
                totalCents: drink.priceCents * order.qty
            ))
        }
    }
}

fn ticketOk(ticket!: Ticket) -> Json {
    let raw: Json = ticket.toJson()
    match raw {
        JObj(fields) {
            mut object = fields
            object.set("ok", JBool(true))
            let json: Json = JObj(object)
            json
        }
        else => raw
    }
}

fn jsonOk(value!: Json) -> Response {
    jsonResponse(200, "OK", value)
}

fn jsonIssue(error!: Issue) -> Response {
    jsonResponse(400, "Bad Request", errorObject(error))
}

fn jsonResponse(status!: Int64, reason!: String, value!: Json) -> Response {
    http.response(
        status,
        reason,
        "application/json; charset=utf-8",
        Bytes.fromString(encode(value))
    )
}
