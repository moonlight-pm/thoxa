## App layer — HTML pages for Little Crema (JSX / builtin Node).

import layout, { Page } from "./layout"
import models, { Drink, formatPrice, roastLabel } from "./models"
import store, { DrinkMiss, DrinkHit, OrderMiss, OrderHit, OrderRow } from "./store"
import orders from "./orders"
import customer from "./customer"
import http, { Request, Response, notFound, htmlResponse } from "std/http"
import { Has, Not, May, Pass, Fail } from "std/fallible"
import { isEmpty, trim } from "std/str"
import { Issue, Rejected, message } from "std/json"

export fn home(customerName!: String) -> Response {
    match store.drinkCount() {
        Fail(error) => storeFailed(error)
        Pass(drinkCount) {
            homePage(customerName, drinkCount)
        }
    }
}

fn homePage(customerName!: String, drinkCount!: Int64) -> Response {
    htmlResponse(
        <Page title="Home" customer={customerName}>
            <section class="hero">
                <h1>Little Crema</h1>
                <p class="lede">Six drinks, one tiny counter, and a Thoxa feature in every pour.</p>
                <p><a class="button" href="/menu">Browse the menu</a></p>
                <p class="muted" data-count={drinkCount}>{drinkCount} drinks brewed fresh daily.</p>
            </section>
            {homeCard(customerName)}
        </Page>
    )
}

fn homeCard(customerName!: String) -> Node {
    if isEmpty(customerName) {
        <section class="card-form">
            <h2>Are you a regular?</h2>
            <p class="muted">Leave your name and the counter remembers you.</p>
            <form method="post" action="/">
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" placeholder="Ada" required />
                <button type="submit">Remember me</button>
            </form>
        </section>
    } else {
        <section class="card-form">
            <h2>Welcome back, {customerName}</h2>
            <p class="muted">Your usual table is free.</p>
            <form method="post" action="/">
                <input type="hidden" name="name" value="" />
                <button type="submit" class="outline">Not {customerName}?</button>
            </form>
        </section>
    }
}

type DrinkCard(drink: Drink) {
    export fn view(children: Array<Node>) -> Node {
        <li class="card">
            <a href={"/menu/{drink.slug}"}>
                <span class="name">{drink.name}</span>
                <span class="meta">{roastLabel(drink.roast)} · {formatPrice(drink.priceCents)}</span>
                <span class="notes">{drink.notes}</span>
            </a>
        </li>
    }
}

fn drinkCards(drinks!: Array<Drink>) -> Array<Node> {
    mut items: Array<Node> = []
    for drink in drinks {
        items.append(<DrinkCard drink={drink} />)
    }
    items
}

export fn menu(customerName!: String, query!: String) -> Response {
    let needle = trim(query)
    match store.searchDrinks(needle) {
        Fail(error) => storeFailed(error)
        Pass(drinks) {
            match store.drinkCount() {
                Fail(error) => storeFailed(error)
                Pass(total) {
                    menuPage(customerName, needle, drinks, total)
                }
            }
        }
    }
}

fn menuPage(customerName!: String, needle!: String, drinks!: Array<Drink>, total!: Int64) -> Response {
    let items = drinkCards(drinks)
    let emptyNote = if drinks.count == 0 {
        <p class="muted">Nothing matches. The barista suggests an espresso.</p>
    } else {
        <></>
    }
    let clear = if isEmpty(needle) {
        <></>
    } else {
        <p class="muted">
            <a href="/menu">Clear search</a>
            {" · showing {drinks.count} of {total}"}
        </p>
    }
    htmlResponse(
        <Page title="Menu" customer={customerName}>
            <h1>The menu</h1>
            <form class="search" method="get" action="/menu">
                <label for="q">Search the menu</label>
                <div class="search-row">
                    <input id="q" name="q" type="search" value={needle} placeholder="espresso, chocolate, light…" />
                    <button type="submit">Search</button>
                </div>
            </form>
            {clear}
            {emptyNote}
            <ul class="menu">{items}</ul>
        </Page>
    )
}

export fn drink(slug!: String, customerName!: String) -> Response {
    match store.findBySlug(slug) {
        Fail(error) => storeFailed(error)
        Pass(found) {
            match found {
                DrinkMiss => notFound()
                DrinkHit(drink) {
                    drinkPage(drink, customerName)
                }
            }
        }
    }
}

fn storeFailed(error!: String) -> Response {
    http.response(
        500,
        "Internal Server Error",
        "text/plain; charset=utf-8",
        Bytes.fromString("store error: {error}\n")
    )
}

fn drinkPage(drink!: Drink, customerName!: String) -> Response {
    let price = formatPrice(drink.priceCents)
    htmlResponse(
        <Page title={drink.name} customer={customerName}>
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            <article class="drink">
                <h1>{drink.name}</h1>
                <p class="badge">{roastLabel(drink.roast)}</p>
                <p class="notes">{drink.notes}</p>
                <p class="price">{price}</p>
            </article>
            {orderForm(drink)}
        </Page>
    )
}

fn orderForm(drink!: Drink) -> Node {
    <section class="card-form">
        <h2>Order a {drink.name}</h2>
        <p class="muted">Works without JavaScript. The counter writes a ticket.</p>
        <form method="post" action="/orders">
            <input type="hidden" name="slug" value={drink.slug} />
            <label for="qty">Quantity</label>
            <input id="qty" name="qty" type="number" min="1" value="1" required />
            <button type="submit">Place order</button>
        </form>
    </section>
}

export fn submitOrder(request!: Request) -> Response {
    let customerName = customer.greeting(request)
    match orders.fromForm(request.body) {
        Fail(error) => orderFailed(customerName, error)
        Pass(order) {
            match orders.place(order) {
                Fail(error) => orderFailed(customerName, error)
                Pass(ticket) => http.seeOther("/orders/{ticket.id}")
            }
        }
    }
}

export fn orderTicket(id!: Int64, customerName!: String) -> Response {
    match store.findOrder(id) {
        Fail(error) => storeFailed(error)
        Pass(found) {
            match found {
                OrderMiss => notFound()
                OrderHit(row) => ticketPage(row, customerName)
            }
        }
    }
}

fn ticketPage(row!: OrderRow, customerName!: String) -> Response {
    let unit = formatPrice(row.unitCents)
    let total = formatPrice(row.totalCents)
    htmlResponse(
        <Page title="Ticket {row.id}" customer={customerName}>
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            <article class="drink">
                <h1>Ticket \#{row.id}</h1>
                <p class="notes">{row.qty} × {row.name}</p>
                <p class="muted">{unit} each</p>
                <p class="price">{total}</p>
            </article>
        </Page>
    )
}

fn orderFailed(customerName!: String, error!: Issue) -> Response {
    let detail = match error {
        Rejected(path, reason) {
            if path == "store" {
                "The counter could not write that ticket."
            } else {
                message(error)
            }
        }
        else => message(error)
    }
    htmlStatus(
        400,
        "Bad Request",
        <Page title="Order" customer={customerName}>
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            <section class="card-form">
                <h2>Could not place that order</h2>
                <p class="muted">{detail}</p>
            </section>
        </Page>
    )
}

fn htmlStatus(status!: Int64, reason!: String, root!: Node) -> Response {
    http.response(
        status,
        reason,
        "text/html; charset=utf-8",
        Bytes.fromString("<!DOCTYPE html>\n{root.html()}")
    )
}

export fn signIn(body!: Bytes) -> Response {
    let redirect = http.seeOther("/")
    match http.formField(body, "name") {
        Not {
            redirect
        }
        Has(raw) {
            let name = trim(raw)
            if isEmpty(name) {
                customer.withForget(redirect)
            } else {
                customer.withRemember(redirect, name)
            }
        }
    }
}
