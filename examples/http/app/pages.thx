## App layer — HTML pages for Little Crema (JSX / builtin Node).

import layout, { Page } from "./layout"
import models, { Drink, formatPrice, roastLabel } from "./models"
import store, { DrinkMiss, DrinkHit, OrderMiss, OrderHit, OrderRow } from "./store"
import orders from "./orders"
import session from "./session"
import live from "./live"
import http, { Request, Response, notFound, htmlResponse } from "std/http"
import { Has, Not, May, Pass, Fail } from "std/fallible"
import { isEmpty, trim } from "std/str"
import { Issue, Rejected, message, issueRejected } from "std/json"

export fn home(request!: Request) -> Response {
    match store.drinkCount() {
        Fail(error) => storeFailed(error)
        Pass(drinkCount) {
            homePage(request, drinkCount)
        }
    }
}

fn homePage(request!: Request, drinkCount!: Int64) -> Response {
    let customerName = session.greeting(request)
    htmlResponse(
        <Page title="Home" customer={customerName}>
            {flashBanner(request)}
            <section class="hero">
                <h1>Little Crema</h1>
                <p class="lede">Six drinks, one tiny counter, and a Thoxa feature in every pour.</p>
                <p><a class="button" href="/menu">Browse the menu</a></p>
                <p class="muted" data-count={drinkCount}>{drinkCount} drinks brewed fresh daily.</p>
            </section>
            {homeCard(customerName, session.csrf(request))}
        </Page>
    )
}

fn flashBanner(request!: Request) -> Node {
    let text = session.takeFlash(request)
    if isEmpty(text) {
        <></>
    } else {
        <p class="flash">{text}</p>
    }
}

fn csrfField(token!: String) -> Node {
    <input type="hidden" name="csrf" value={token} />
}

fn homeCard(customerName!: String, token!: String) -> Node {
    if isEmpty(customerName) {
        <section class="card-form">
            <h2>Are you a regular?</h2>
            <p class="muted">Leave your name and the counter remembers you.</p>
            <form method="post" action="/">
                {csrfField(token)}
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" placeholder="Ada" required />
                <button type="submit">Remember me</button>
            </form>
        </section>
    } else {
        <section class="card-form">
            <h2>Welcome back, {customerName}</h2>
            <p class="muted">Your usual table is free.</p>
            <form method="post" action="/">
                {csrfField(token)}
                <input type="hidden" name="name" value="" />
                <button type="submit" class="outline">Not {customerName}?</button>
            </form>
        </section>
    }
}

type DrinkCard(drink: Drink) {
    export fn view(children: Array<Node>) -> Node {
        <li class="card">
            <a href={"/menu/{drink.slug}"}>
                <span class="name">{drink.name}</span>
                <span class="meta">{roastLabel(drink.roast)} · {formatPrice(drink.priceCents)}</span>
                <span class="notes">{drink.notes}</span>
            </a>
        </li>
    }
}

fn drinkCards(drinks!: Array<Drink>) -> Array<Node> {
    mut items: Array<Node> = []
    for drink in drinks {
        items.append(<DrinkCard drink={drink} />)
    }
    items
}

export fn menu(request!: Request) -> Response {
    let needle = trim(menuQuery(request))
    match store.searchDrinks(needle) {
        Fail(error) => storeFailed(error)
        Pass(drinks) {
            match store.drinkCount() {
                Fail(error) => storeFailed(error)
                Pass(total) {
                    menuPage(request, needle, drinks, total)
                }
            }
        }
    }
}

fn menuPage(request!: Request, needle!: String, drinks!: Array<Drink>, total!: Int64) -> Response {
    htmlResponse(
        <Page title="Menu" customer={session.greeting(request)}>
            {flashBanner(request)}
            <h1>The menu</h1>
            <form class="search" method="get" action="/menu" thx-get="/menu/items" thx-target="#menu-results" thx-swap="inner" thx-push>
                <label for="q">Search the menu</label>
                <div class="search-row">
                    <input id="q" name="q" type="search" value={needle} placeholder="espresso, chocolate, light…" />
                    <button type="submit">Search</button>
                </div>
            </form>
            <div id="menu-results">{menuResults(needle, drinks, total)}</div>
        </Page>
    )
}

fn menuResults(needle!: String, drinks!: Array<Drink>, total!: Int64) -> Node {
    let emptyNote = if drinks.count == 0 {
        <p class="muted">Nothing matches. The barista suggests an espresso.</p>
    } else {
        <></>
    }
    let clear = if isEmpty(needle) {
        <></>
    } else {
        <p class="muted">
            <a href="/menu" thx-get="/menu/items" thx-target="#menu-results" thx-push>Clear search</a>
            {" · showing {drinks.count} of {total}"}
        </p>
    }
    <>
        {clear}
        {emptyNote}
        <ul id="menu-items" class="menu">{drinkCards(drinks)}</ul>
    </>
}

export fn menuItems(request!: Request) -> Response {
    let needle = trim(menuQuery(request))
    match store.searchDrinks(needle) {
        Fail(error) => storeFailed(error)
        Pass(drinks) {
            match store.drinkCount() {
                Fail(error) => storeFailed(error)
                Pass(total) {
                    http.cached(
                        request,
                        http.htmlFragment(menuResults(needle, drinks, total)),
                        "private, no-cache"
                    )
                }
            }
        }
    }
}

fn menuQuery(request!: Request) -> String {
    match http.queryParam(request, "q") {
        Not => ""
        Has(value) { value }
    }
}

export fn drink(slug!: String, request!: Request) -> Response {
    match store.findBySlug(slug) {
        Fail(error) => storeFailed(error)
        Pass(found) {
            match found {
                DrinkMiss => notFound()
                DrinkHit(drink) {
                    drinkPage(drink, request)
                }
            }
        }
    }
}

fn storeFailed(error!: String) -> Response {
    http.response(
        500,
        "Internal Server Error",
        "text/plain; charset=utf-8",
        Bytes.fromString("store error: {error}\n")
    )
}

fn drinkPage(drink!: Drink, request!: Request) -> Response {
    let price = formatPrice(drink.priceCents)
    htmlResponse(
        <Page title={drink.name} customer={session.greeting(request)}>
            {flashBanner(request)}
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            <article class="drink">
                <h1>{drink.name}</h1>
                <p class="badge">{roastLabel(drink.roast)}</p>
                <p class="notes">{drink.notes}</p>
                <p class="price">{price}</p>
            </article>
            {orderForm(drink, session.csrf(request))}
            <div id="ticket"></div>
        </Page>
    )
}

fn orderForm(drink!: Drink, token!: String) -> Node {
    <section class="card-form">
        <h2>Order a {drink.name}</h2>
        <p class="muted">Works without JavaScript. The counter writes a ticket.</p>
        <form method="post" action="/orders" thx-post="/orders" thx-target="#ticket" thx-swap="inner">
            {csrfField(token)}
            <input type="hidden" name="slug" value={drink.slug} />
            <label for="qty">Quantity</label>
            <input id="qty" name="qty" type="number" min="1" value="1" required />
            <button type="submit">Place order</button>
        </form>
    </section>
}

export fn submitOrder(request!: Request) -> Response {
    let customerName = session.greeting(request)
    if not session.checkCsrf(request, request.body) {
        orderFailed(customerName, csrfRejected())
    } else {
        match orders.fromForm(request.body) {
            Fail(error) => orderFailed(customerName, error)
            Pass(order) {
                match orders.place(order) {
                    Fail(error) => orderFailed(customerName, error)
                    Pass(ticket) {
                        session.setFlash(request, "Poured {ticket.qty} × {ticket.name}.")
                        live.broadcast()
                        http.seeOther("/orders/{ticket.id}")
                    }
                }
            }
        }
    }
}

fn csrfRejected() -> Issue {
    issueRejected("csrf", "that form expired — refresh and try again")
}

export fn orderTicket(id!: Int64, request!: Request) -> Response {
    match store.findOrder(id) {
        Fail(error) => storeFailed(error)
        Pass(found) {
            match found {
                OrderMiss => notFound()
                OrderHit(row) => ticketPage(row, request)
            }
        }
    }
}

fn ticketPage(row!: OrderRow, request!: Request) -> Response {
    htmlResponse(
        <Page title="Ticket {row.id}" customer={session.greeting(request)}>
            {flashBanner(request)}
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            {ticketCard(row)}
        </Page>
    )
}

fn ticketCard(row!: OrderRow) -> Node {
    let unit = formatPrice(row.unitCents)
    let total = formatPrice(row.totalCents)
    <article class="drink" id="ticket">
        <h1>Ticket \#{row.id}</h1>
        <p class="notes">{row.qty} × {row.name}</p>
        <p class="muted">{unit} each</p>
        <p class="price">{total}</p>
    </article>
}

export fn orderTicketFragment(id!: Int64, request!: Request) -> Response {
    match store.findOrder(id) {
        Fail(error) => storeFailed(error)
        Pass(found) {
            match found {
                OrderMiss => notFound()
                OrderHit(row) {
                    http.cached(
                        request,
                        http.htmlFragment(ticketCard(row)),
                        "private, max-age=300"
                    )
                }
            }
        }
    }
}

fn orderFailed(customerName!: String, error!: Issue) -> Response {
    let detail = match error {
        Rejected(path, reason) {
            if path == "store" {
                "The counter could not write that ticket."
            } else {
                message(error)
            }
        }
        else => message(error)
    }
    htmlStatus(
        400,
        "Bad Request",
        <Page title="Order" customer={customerName}>
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            <section class="card-form">
                <h2>Could not place that order</h2>
                <p class="muted">{detail}</p>
            </section>
        </Page>
    )
}

fn htmlStatus(status!: Int64, reason!: String, root!: Node) -> Response {
    http.response(
        status,
        reason,
        "text/html; charset=utf-8",
        Bytes.fromString("<!DOCTYPE html>\n{root.html()}")
    )
}

export fn board(request!: Request) -> Response {
    htmlResponse(
        <Page title="Board" customer={session.greeting(request)}>
            {flashBanner(request)}
            <h1>The board</h1>
            <p class="muted">Tickets land here as they pour. Open in another tab and order.</p>
            <div thx-sse="/events" thx-target="#board" thx-swap="outer">
                {live.boardNode()}
            </div>
        </Page>
    )
}

export fn events(request!: Request) -> Response {
    live.subscribe(request)
}

export fn signIn(request!: Request) -> Response {
    let redirect = http.seeOther("/")
    if not session.checkCsrf(request, request.body) {
        orderFailed(session.greeting(request), csrfRejected())
    } else {
        match http.formField(request.body, "name") {
            Not {
                redirect
            }
            Has(raw) {
                let name = trim(raw)
                if isEmpty(name) {
                    session.setName(request, "")
                    session.setFlash(request, "Name forgotten.")
                } else {
                    session.setName(request, name)
                    session.setFlash(request, "Welcome, {name}.")
                }
                redirect
            }
        }
    }
}
