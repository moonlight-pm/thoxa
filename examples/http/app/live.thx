## App layer — SSE order board (example-only).
## Host fills `Request.peerFd`; we write the event-stream and return `streamed()`.

import store, { OrderRow } from "./store"
import models, { formatPrice } from "./models"
import server from "std/http/server"
import net, { Socket } from "std/net"
import http, { Request, Response, badRequest } from "std/http"
import { Pass, Fail } from "std/fallible"

fn emptyLive() -> Map<Int64, Int64> {
    mut peers: Map<Int64, Int64> = Map()
    peers
}

mut livePeers = emptyLive()

fn boardOf(rows!: Array<OrderRow>) -> Node {
    if rows.count == 0 {
        <p class="muted" id="board" aria-live="polite">No tickets yet. Pour something.</p>
    } else {
        mut items: Array<Node> = []
        for row in rows {
            items.append(
                <li>
                    <span class="name">{row.qty} × {row.name}</span>
                    <span class="meta">ticket {row.id} · {formatPrice(row.totalCents)}</span>
                </li>
            )
        }
        <ul id="board" class="menu" aria-live="polite">{items}</ul>
    }
}

export fn boardNode() -> Node {
    match store.listOrders() {
        Fail(_) => <p class="muted" id="board" aria-live="polite">The board is closed.</p>
        Pass(rows) => boardOf(rows)
    }
}

export fn subscribe(request!: Request) -> Response {
    let fd = request.peerFd
    if fd == 0 {
        badRequest("no peer")
    } else {
        let peer = Socket(fd: fd)
        match server.beginEventStream(peer) {
            Fail(_) => http.streamed()
            Pass {
                livePeers.set(fd, 1)
                match store.listOrders() {
                    Fail(_) { }
                    Pass(rows) {
                        match server.sendEvent(peer, boardOf(rows).html()) {
                            Pass(_) { }
                            Fail(_) { }
                        }
                    }
                }
                http.streamed()
            }
        }
    }
}

export fn broadcast() {
    let html = boardNode().html()
    mut keep = emptyLive()
    for fd, flag in livePeers {
        match server.sendEvent(Socket(fd: fd), html) {
            Pass(_) {
                keep.set(fd, flag)
            }
            Fail(_) { }
        }
    }
    livePeers = keep
}
