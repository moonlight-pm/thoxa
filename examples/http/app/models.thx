## App layer — drink catalog types + seed (rows live in SQLite).

import { Pass, Fail, Trial } from "std/fallible"

export type Dark
export type Medium
export type Light
export type Roast = Dark | Medium | Light

export type Drink(
    slug: String,
    name: String,
    notes: String,
    priceCents: Int64,
    roast: Roast
)

export fn roastLabel(roast!: Roast) -> String {
    match roast {
        Dark => "Dark roast"
        Medium => "Medium roast"
        Light => "Light roast"
    }
}

export fn formatPrice(cents!: Int64) -> String {
    let dollars = cents / 100
    let remainder = cents % 100
    if remainder < 10 {
        "${dollars}.0{remainder}"
    } else {
        "${dollars}.{remainder}"
    }
}

export fn roastKey(roast!: Roast) -> String {
    match roast {
        Dark => "dark"
        Medium => "medium"
        Light => "light"
    }
}

export fn roastFromKey(key!: String) -> Trial<Roast, String> {
    if key == "dark" {
        Pass(Dark())
    } else if key == "medium" {
        Pass(Medium())
    } else if key == "light" {
        Pass(Light())
    } else {
        Fail("unknown roast {key}")
    }
}

## Catalog seed written into SQLite on boot (source of truth for drinks).
export fn seedDrinks() -> Array<Drink> {
    [
        Drink(
            slug: "espresso",
            name: "Espresso",
            notes: "A quick, syrupy shot under a hazelnut crema.",
            priceCents: 300,
            roast: Dark()
        ),
        Drink(
            slug: "cold-brew",
            name: "Cold Brew",
            notes: "Steeped overnight: chocolate, cherry, no acidity.",
            priceCents: 400,
            roast: Dark()
        ),
        Drink(
            slug: "cappuccino",
            name: "Cappuccino",
            notes: "Equal parts espresso, steamed milk, and foam.",
            priceCents: 500,
            roast: Medium()
        ),
        Drink(
            slug: "flat-white",
            name: "Flat White",
            notes: "Two ristretto shots under velvet microfoam.",
            priceCents: 500,
            roast: Medium()
        ),
        Drink(
            slug: "pour-over",
            name: "Pour Over",
            notes: "A single-origin Ethiopian, bright and floral.",
            priceCents: 600,
            roast: Light()
        ),
        Drink(
            slug: "mocha",
            name: "Mocha",
            notes: "Espresso and dark chocolate under whipped cream.",
            priceCents: 600,
            roast: Dark()
        ),
    ]
}

export fn filterDrinks(drinks!: Array<Drink>, needle!: String) -> Array<Drink> {
    let query = needle.trim()
    if query.isEmpty() {
        drinks
    } else {
        mut matches: Array<Drink> = []
        for drink in drinks {
            if drinkMatches(drink, query) {
                matches.append(drink)
            }
        }
        matches
    }
}

fn drinkMatches(drink!: Drink, query!: String) -> Bool {
    drink.name.contains(query, ignoreCase: true) or
        drink.notes.contains(query, ignoreCase: true) or
        roastLabel(drink.roast).contains(query, ignoreCase: true) or
        drink.slug.contains(query, ignoreCase: true)
}
