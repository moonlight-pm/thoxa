## App layer — in-memory drink catalog (domain data).

import { Has, Not, May } from "std/fallible"
import { containsIgnoreCaseAscii, isEmpty, trim } from "std/str"

export type Dark
export type Medium
export type Light
export type Roast = Dark | Medium | Light

export type Drink(
    slug: String,
    name: String,
    notes: String,
    priceCents: Int64,
    roast: Roast
)

export fn roastLabel(roast: Roast) -> String {
    match roast {
        Dark => "Dark roast"
        Medium => "Medium roast"
        Light => "Light roast"
    }
}

export fn formatPrice(cents!: Int64) -> String {
    let dollars = cents / 100
    let remainder = cents % 100
    if remainder < 10 {
        "${dollars}.0{remainder}"
    } else {
        "${dollars}.{remainder}"
    }
}

export fn allDrinks() -> Array<Drink> {
    [
        Drink(
            slug: "espresso",
            name: "Espresso",
            notes: "A quick, syrupy shot under a hazelnut crema.",
            priceCents: 300,
            roast: Dark()
        ),
        Drink(
            slug: "cold-brew",
            name: "Cold Brew",
            notes: "Steeped overnight: chocolate, cherry, no acidity.",
            priceCents: 400,
            roast: Dark()
        ),
        Drink(
            slug: "cappuccino",
            name: "Cappuccino",
            notes: "Equal parts espresso, steamed milk, and foam.",
            priceCents: 500,
            roast: Medium()
        ),
        Drink(
            slug: "flat-white",
            name: "Flat White",
            notes: "Two ristretto shots under velvet microfoam.",
            priceCents: 500,
            roast: Medium()
        ),
        Drink(
            slug: "pour-over",
            name: "Pour Over",
            notes: "A single-origin Ethiopian, bright and floral.",
            priceCents: 600,
            roast: Light()
        ),
        Drink(
            slug: "mocha",
            name: "Mocha",
            notes: "Espresso and dark chocolate under whipped cream.",
            priceCents: 600,
            roast: Dark()
        ),
    ]
}

export fn findBySlug(slug!: String) -> May<Drink> {
    for drink in allDrinks() {
        if drink.slug == slug {
            return Has(drink)
        }
    }
    Not()
}

export fn drinkCount() -> Int64 {
    allDrinks().count
}

export fn searchDrinks(needle!: String) -> Array<Drink> {
    let query = trim(needle)
    if isEmpty(query) {
        allDrinks()
    } else {
        mut matches: Array<Drink> = []
        for drink in allDrinks() {
            if drinkMatches(drink, query) {
                matches.append(drink)
            }
        }
        matches
    }
}

fn drinkMatches(drink!: Drink, query!: String) -> Bool {
    if containsIgnoreCaseAscii(drink.name, query) {
        true
    } else {
        if containsIgnoreCaseAscii(drink.notes, query) {
            true
        } else {
            if containsIgnoreCaseAscii(roastLabel(drink.roast), query) {
                true
            } else {
                containsIgnoreCaseAscii(drink.slug, query)
            }
        }
    }
}
