## App — type-body route clauses + App host object.
## `Routes` is the compiler surface (`GET "/…"` → `route(req)`).
## `App` keeps port + handle (static fallback when `route` misses).
## No listen/accept/parse/send.

import pages from "./Pages"
import api from "./Api"
import customer from "./Customer"
import wire from "~/framework/Wire"
import httpStatic from "std/HttpStatic"
## `notFound` is required: generated `route` calls it on miss.
import { Request, Response, notFound } from "std/Http"
import { Has, Not } from "std/Fallible"

let staticRoot = "examples/http/web"
let defaultPort = 9091

## ── Route clauses (desugars to `route(req: Request) -> Response`) ───────────

type Routes {
    GET "/" (req: Request) -> Response {
        pages.home(customer.greeting(req))
    }

    GET "/menu" (req: Request) -> Response {
        pages.menu(customer.greeting(req), menuQuery(req))
    }

    GET "/menu/:slug" (slug: String, req: Request) -> Response {
        pages.drink(slug, customer.greeting(req))
    }

    GET "/api/health" -> Response {
        api.health()
    }

    POST "/" (req: Request) -> Response {
        pages.signIn(req.body)
    }
}

fn menuQuery(req!: Request) -> String {
    match wire.queryParam(wire.requestQuery(req), "q") {
        Not => ""
        Has(v) { v }
    }
}

fn serveStatic(req!: Request) -> Response {
    let files = httpStatic.Router(root: staticRoot)
    files.handle(req)
}

## ── Application object the host receives ───────────────────────────────────

export type App(port: Int64) {
    export fn handle(req!: Request) -> Response {
        let res = Routes().route(req)
        if res.status == 404 {
            serveStatic(req)
        } else {
            res
        }
    }
}

## Construct the app (port is host configuration).
export fn app() -> App {
    App(port: defaultPort)
}
