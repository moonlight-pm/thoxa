## App — routes, views dispatch, and the App value passed to framework.serve.
## No listen/accept/parse/send.

import pages from "./Pages"
import api from "./Api"
import customer from "./Customer"
import wire from "~/framework/Wire"
import router, { Router, Hit } from "~/framework/Router"
import { Request, Response, methodNotAllowed } from "std/Http"
import { Has, Not } from "std/Fallible"

let staticRoot = "examples/http/web"
let defaultPort = 9091

## Configure the framework router.
fn buildRouter() -> Router {
    router.newRouter(staticRoot)
        .get("/", "home")
        .get("/menu", "menu")
        .get("/menu/:slug", "drink")
        .get("/api/health", "health")
        .post("/", "signIn")
}

## Application object the host receives. Framework calls `handle` per request.
export type App(port: Int64) {
    export fn handle(req!: Request, body!: Bytes, query!: String) -> Response {
        let r = buildRouter()
        match r.resolve(req.method, req.path) {
            Has(hit) {
                dispatch(hit, req, body, query)
            }
            Not {
                r.serveStatic(req)
            }
        }
    }
}

## Construct the app (port is host configuration).
export fn app() -> App {
    App(port: defaultPort)
}

fn dispatch(hit!: Hit, req!: Request, body!: Bytes, query!: String) -> Response {
    let who = customer.greeting(req)
    if hit.name == "home" {
        pages.home(who)
    } else {
        if hit.name == "menu" {
            let q = match wire.queryParam(query, "q") {
                Not => ""
                Has(v) { v }
            }
            pages.menu(who, q)
        } else {
            if hit.name == "drink" {
                pages.drink(hit.param, who)
            } else {
                if hit.name == "health" {
                    api.health()
                } else {
                    if hit.name == "signIn" {
                        pages.signIn(body)
                    } else {
                        methodNotAllowed("GET, HEAD, POST")
                    }
                }
            }
        }
    }
}
