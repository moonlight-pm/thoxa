## App layer — place an order (JSON and HTML share this).

import store, { DrinkMiss, DrinkHit } from "./store"
import { Has, Not, May, Pass, Fail, Trial } from "std/fallible"
import { Issue, issueRejected } from "std/json"

export type Qty = Int64 where >= 1
export type DrinkSlug = "espresso" | "cold-brew" | "cappuccino" | "flat-white" | "pour-over" | "mocha"
export type CreateOrder(slug: DrinkSlug, qty: Qty)

export type Ticket(
    id: Int64,
    slug: String,
    name: String,
    qty: Int64,
    unitCents: Int64,
    totalCents: Int64
)

export fn place(order!: CreateOrder) -> Trial<Ticket, Issue> {
    match store.findBySlug(order.slug) {
        Fail(error) => Fail(issueRejected("store", error))
        Pass(found) {
            match found {
                DrinkMiss => Fail(issueRejected("slug", "unknown drink"))
                DrinkHit(drink) {
                    let qty = order.qty
                    let unitCents = drink.priceCents
                    let totalCents = unitCents * qty
                    match store.insertOrder(drink.slug, drink.name, qty, unitCents, totalCents) {
                        Fail(error) => Fail(issueRejected("store", error))
                        Pass(id) {
                            Pass(Ticket(
                                id: id,
                                slug: drink.slug,
                                name: drink.name,
                                qty: qty,
                                unitCents: unitCents,
                                totalCents: totalCents
                            ))
                        }
                    }
                }
            }
        }
    }
}
