## App — type-body route clauses + free `handle` (D132).
## `Routes` is the compiler surface (`GET "/…"` → generated `route(req)`).
## `handle` falls through to static files on 404.
## No listen/accept/parse/send.

import pages from "./pages"
import api from "./api"
import session from "./session"
import httpStatic from "std/http/static"
## `notFound` is required: generated `route` calls it on miss.
import http, { Request, Response, notFound, badRequest } from "std/http"
import { Has, Not, May } from "std/fallible"

let staticRoot = "examples/http/web"
export let port = 9091

## ── Route clauses (desugars to generated `route(req: Request) -> Response`) ────

type Routes {
    GET "/" (request: Request) -> Response {
        pages.home(request)
    }

    GET "/live" (request: Request) -> Response {
        pages.board(request)
    }

    GET "/events" (request: Request) -> Response {
        pages.events(request)
    }

    GET "/menu" (request: Request) -> Response {
        pages.menu(request)
    }

    GET "/menu/items" (request: Request) -> Response {
        pages.menuItems(request)
    }

    GET "/menu/:slug" (slug: String, request: Request) -> Response {
        pages.drink(slug, request)
    }

    GET "/api/health" -> Response {
        api.health()
    }

    GET "/api/orders" -> Response {
        api.listOrders()
    }

    POST "/api/orders" (request: Request) -> Response {
        api.createOrder(request)
    }

    POST "/orders" (request: Request) -> Response {
        pages.submitOrder(request)
    }

    GET "/orders/:id/ticket" (id: Int64, request: Request) -> Response {
        pages.orderTicketFragment(id, request)
    }

    GET "/orders/:id" (id: Int64, request: Request) -> Response {
        pages.orderTicket(id, request)
    }

    POST "/" (request: Request) -> Response {
        pages.signIn(request)
    }
}

fn serveStatic(request!: Request) -> Response {
    let files = httpStatic.Router(root: staticRoot)
    files.handle(request)
}

export fn handle(request!: Request) -> Response {
    let bound = session.ensure(request)
    let response = Routes().route(bound)
    if response.status == 404 {
        session.bindCookie(serveStatic(bound), bound)
    } else {
        session.bindCookie(response, bound)
    }
}
