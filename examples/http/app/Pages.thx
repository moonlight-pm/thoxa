## App layer — HTML pages for Little Crema (JSX / builtin Node).

import layout, { Page } from "./Layout"
import models, { Drink, formatPrice } from "./Models"
import customer from "./Customer"
import wire from "~/framework/Wire"
import { Response, notFound } from "std/Http"
import { Has, Not } from "std/Fallible"
import { isEmpty, trim } from "std/Str"

export fn home(who!: String) -> Response {
    let n = models.drinkCount()
    layout.htmlResponse(
        <Page title="Home" customer={who}>
            <section class="hero">
                <h1>Little Crema</h1>
                <p class="lede">Six drinks, one tiny counter, and a Thoxa feature in every pour.</p>
                <p><a class="button" href="/menu">Browse the menu</a></p>
                <p class="muted">{n} drinks brewed fresh daily.</p>
            </section>
            {homeCard(who)}
        </Page>
    )
}

fn homeCard(who!: String) -> Node {
    if isEmpty(who) {
        <section class="card-form">
            <h2>Are you a regular?</h2>
            <p class="muted">Leave your name and the counter remembers you.</p>
            <form method="post" action="/">
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" placeholder="Ada" required />
                <button type="submit">Remember me</button>
            </form>
        </section>
    } else {
        <section class="card-form">
            <h2>Welcome back, {who}</h2>
            <p class="muted">Your usual table is free.</p>
            <form method="post" action="/">
                <input type="hidden" name="name" value="" />
                <button type="submit" class="outline">Not {who}?</button>
            </form>
        </section>
    }
}

fn drinkCard(d!: Drink) -> Node {
    ## Bare `<tag>` after another expression is parsed as `<` (comparison).
    ## The whole function body has to be the tag, or bind it with `let`.
    <li class="card">
        <a href={"/menu/{d.slug}"}>
            <span class="name">{d.name}</span>
            <span class="meta">{d.roast} · {formatPrice(d.priceCents)}</span>
            <span class="notes">{d.notes}</span>
        </a>
    </li>
}

fn drinkCards(drinks!: Array<Drink>) -> Array<Node> {
    mut items: Array<Node> = []
    for d in drinks {
        items = items.append(drinkCard(d))
    }
    items
}

export fn menu(who!: String, q!: String) -> Response {
    let needle = trim(q)
    let drinks = models.searchDrinks(needle)
    let items = drinkCards(drinks)
    let emptyNote = if drinks.count == 0 {
        <p class="muted">Nothing matches. The barista suggests an espresso.</p>
    } else {
        <></>
    }
    let clear = if isEmpty(needle) {
        <></>
    } else {
        <p class="muted">
            <a href="/menu">Clear search</a>
            {" · showing {drinks.count} of {models.drinkCount()}"}
        </p>
    }
    layout.htmlResponse(
        <Page title="Menu" customer={who}>
            <h1>The menu</h1>
            <form class="search" method="get" action="/menu">
                <label for="q">Search the menu</label>
                <div class="search-row">
                    <input id="q" name="q" type="search" value={needle} placeholder="espresso, chocolate, light…" />
                    <button type="submit">Search</button>
                </div>
            </form>
            {clear}
            {emptyNote}
            <ul class="menu">{items}</ul>
        </Page>
    )
}

export fn drink(slug!: String, who!: String) -> Response {
    match models.findBySlug(slug) {
        Not => notFound()
        Has(d) {
            drinkPage(d, who)
        }
    }
}

fn drinkPage(d!: Drink, who!: String) -> Response {
    let price = formatPrice(d.priceCents)
    layout.htmlResponse(
        <Page title={d.name} customer={who}>
            <p class="back"><a href="/menu">← Back to the menu</a></p>
            <article class="drink">
                <h1>{d.name}</h1>
                <p class="badge">{d.roast}</p>
                <p class="notes">{d.notes}</p>
                <p class="price">{price}</p>
            </article>
        </Page>
    )
}

export fn signIn(body!: Bytes) -> Response {
    let redirect = wire.seeOther("/")
    match wire.formField(body, "name") {
        Not {
            redirect
        }
        Has(raw) {
            let name = trim(raw)
            if isEmpty(name) {
                customer.withForget(redirect)
            } else {
                customer.withRemember(redirect, name)
            }
        }
    }
}
